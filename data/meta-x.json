"/y6yhUtIuIkJhrj0biv8GXzvAh7.jpg"}],"updatedAt":"2026-11-14T18:42:19Z"},"movie:246655":{"tmdbId":246655,"type":"movie","title":"X-Men: Apocalypse","originalTitle":"X-Men: Apocalypse","year":"2016","genres":["Science Fiction","Fantasy","Action"],"voteAverage":6.5,"voteCount":14284,"overview":"Der Motor für das Fortbestehen einer Art ist die Mutation, die unter bestimmten sich ändernden Umweltbedingungen sich von größtem Vorteil erweist. Noch sah sich immer der Mensch, der Homo sapiens, als die Krone der Schöpfung. Doch nun – mit dem Auftritt der Mutanten – sehen sich die Menschen in ihrer Alleinstellung bedroht vom Homo sapiens superior. Und tatsächlich sollen sie von ihrem Thron gestürzt werden. Denn keiner vertritt mehr die Maxime des Survival of the Fittest als Apocalypse, der erste der Mutanten.  Doch Apocalypse ist wenig zimperlich im Kampf ums Überleben, auch Mutanten, die Schwäche zeigen, müssen ausgetilgt und vernichtet werden.  Und so müssen die Menschen und die Mutanten um Professor Xavier und Magneto Seite an Seite stehen, um gegen Apocalypse und seinen Selektionsdruck eine Chance zu haben.","runtime":144,"posterPath":"/vsv91Fj4pxOEm2QJ96jq2EXS7QT.jpg","backdropPath":"/sTQNRqLbfCXolrb5CizAW1dj528.jpg","cast":[{"id":5530,"name":"James McAvoy","character":"Professor Charles Xavier","profilePath":"/u4REKbm3zhFI2J5tVyqRovGRYUJ.jpg"},{"id":17288,"name":"Michael Fassbender","character":"Erik Lehnsherr / Magneto","profilePath":"/xvbnUiB2ZBR3QIt595OzNy657Vw.jpg"},{"id":72129,"name":"Jennifer Lawrence","character":"Raven / Mystique","profilePath":"/6WTY6HjXMGxnHilJRVC3eLnu43F.jpg"},{"id":3292,"name":"Nicholas Hoult","character":"Hank McCoy / Beast","profilePath":"/pXm8GWTm9eIA8pUGOjvmYjlxamu.jpg"},{"id":25072,"name":"Oscar Isaac","character":"En Sabah Nur / Apocalypse","profilePath":"/dW5U5yrIIPmMjRThR9KT2xH6nTz.jpg"},{"id":9827,"name":"Rose Byrne","character":"Moira MacTaggert","profilePath":"/wR8YZlrewVW2FixRBrJcxaXU3R1.jpg"},{"id":55089,"name":"Evan Peters","character":"Peter Maximoff / Quicksilver","profilePath":"/m9okq20ca2Md38i2ekJeKs3vTwa.jpg"},{"id":1056053,"name":"Josh Helman","character":"Col. William Stryker","profilePath":"/1thwLjrgvFv7ifjyVtTKQh23OCh.jpg"},{"id":1001657,"name":"Sophie Turner","character":"Jean Grey","profilePath":"/8ur4aHFakVCinWk0cvrGO8qAUhv.jpg"},{"id":1034681,"name":"Tye Sheridan","character":"Scott Summers / Cyclops","profilePath":"/d5ZS2fjqC98cIGkhEGX0fRYhku4.jpg"},{"id":429,"name":"Lucas Till","character":"Alex Summers / Havok","profilePath":"/5m8xgsOgT3FgCBo2AsMn7dewe57.jpg"},{"id":113505,"name":"Kodi Smit-McPhee","character":"Kurt Wagner / Nightcrawler","profilePath":"/sesCWba9NwPDYDZzbVLs7OgLOti.jpg"}],"updatedAt":"2026-11-14T18:42:19Z"},"movie:320288":{"tmdbId":320288,"type":"movie","title":"X-Men: Dark Phoenix","originalTitle":"Dark Phoenix","year":"2019","genres":["Science Fiction","Action","Abenteuer"],"voteAverage":6.0,"voteCount":7419,"overview":"Etwa zehn Jahre nachdem sie es mit dem mächtigen Mutanten Apocalypse aufgenommen haben, sind die X-Men rund um Charles Xavier zu Helden geworden. Doch der damit einhergehende Ruhm steigt dem an den Rollstuhl gefesselten Telepathen zu Kopf, so dass er seine Schützlinge auf immer gefährlichere Missionen schickt. Für ihren jüngsten Auftrag schickt er die X-Men ins Weltall, wo sie verunglückte Astronauten retten sollen. Doch dabei wird ihr Raumschiff von einer Sonneneruption getroffen, die Jean Grey zwar absorbieren und umlenken kann, doch durch die enorme Energie erwacht eine mysteriöse Macht in ihr: die Phoenix Force. Jeans neue Kräfte lassen sich nur schwer kontrollieren und rufen schließlich auch eine außerirdische Gestaltwandlerin auf den Plan, die Jagd auf sie macht…","runtime":114,"posterPath":"/6NbUEHvqnYljIR8dicOubDMJrEs.jpg","backdropPath":"/j9ZV0UOagjQ4seR8Hd5N6JfwdTP.jpg","cast":[{"id":1001657,"name":"Sophie Turner","character":"Jean Grey / Dark Phoenix","profilePath":"/8ur4aHFakVCinWk0cvrGO8qAUhv.jpg"},{"id":5530,"name":"James McAvoy","character":"Charles Xavier / Professor X","profilePath":"/u4REKbm3zhFI2J5tVyqRovGRYUJ.jpg"},{"id":3292,"name":"Nicholas Hoult","character":"Hank McCoy / Beast","profilePath":"/pXm8GWTm9eIA8pUGOjvmYjlxamu.jpg"},{"id":1034681,"name":"Tye Sheridan","character":"Scott Summers / Cyclops","profilePath":"/d5ZS2fjqC98cIGkhEGX0fRYhku4.jpg"},{"id":17288,"name":"Michael Fassbender","character":"Erik Lensherr / Magneto","profilePath":"/xvbnUiB2ZBR3QIt595OzNy657Vw.jpg"},{"id":1253199,"name":"Alexandra Shipp","character":"Ororo Munroe / Storm","profilePath":"/98AfO5NSqWnlhIxjSg08gGYdxUG.jpg"},{"id":55089,"name":"Evan Peters","character":"Peter Maximoff / Quicksilver","profilePath":"/m9okq20ca2Md38i2ekJeKs3vTwa.jpg"},{"id":83002,"name":"Jessica Chastain","character":"Vuk","profilePath":"/lodMzLKSdrPcBry6TdoDsMN3Vge.jpg"},{"id":113505,"name":"Kodi Smit-McPhee","character":"Kurt Wagner / Nightcrawler","profilePath":"/sesCWba9NwPDYDZzbVLs7OgLOti.jpg"},{"id":72129,"name":"Jennifer Lawrence","character":"Raven Darkholme / Mystique","profilePath":"/6WTY6HjXMGxnHilJRVC3eLnu43F.jpg"},{"id":1475960,"name":"Scott Shepherd","character":"Dr. John Grey","profilePath":"/leLuJUpF6uySDWPS7FwHpObAMs4.jpg"},{"id":5377,"name":"Ato Essandoh","character":"Jones","profilePath":"/bXwpCbl2grM5UYv5l5DXMrqrlxp.jpg"}],"updatedAt":"2026-11-14T18:42:19Z"},"movie:352492":{"tmdbId":352492,"type":"movie","title":"XOXO","originalTitle":"XOXO","year":"2016","genres":["Musik","Drama"],"voteAverage":5.9,"voteCount":612,"overview":"Mit Xoxo steht die gigantischste Party für Freunde elektronischer Tanzmusik der USA vor der Tür. In einer Nacht treffen sich sechs Fremde, die alle Teil der Partymeute sein wollen. Mitten unter ihnen ist Ethan. Der junge DJ soll plötzlich auf dem Festival auftreten, nachdem seine Songs vor gerade einmal ein paar Tagen zu Internet-Hits geworden sind. Für ihn ist es natürlich die Chance seines Lebens, doch nun scheint sich das Schicksal gegen ihn verschworen zu haben. So scheint es für Ethan unmöglich, überhaupt den Schauplatz des Festivals zu erreichen… Doch auch jeder der anderen Festivalbesucher schreibt an diesem Abend seine ganz eigene Geschichte: Ein hoffnungsloser Romantiker will die große Liebe finden, eine ehemalige Szene-Größe hofft auf die Rückkehr ins Rampenlicht und ein Pärchen gerät in Versuchung.","runtime":92,"posterPath":"/5hbTuc8Lbw7N8RwMOc9bjAcSjuw.jpg","backdropPath":"/8veRW9Hb3cQZgAy28gqvJVo34O1.jpg","cast":[{"id":91351,"name":"Sarah Hyland","character":"Krystal","profilePath":"/rEZqLqm9OiIyb5VWRbtVt1tCwFF.jpg"},{"id":89109,"name":"Hayley Kiyoko","character":"Shannie","profilePath":"/1Ce8otFMEGn8uTEF5ZpaTxPDcag.jpg"},{"id":1260036,"name":"Chris D'Elia","character":"Neil","profilePath":"/hfstFQUoIeOidHTHX9UHIGRTrmc.jpg"},{"id":27103,"name":"Graham Phillips","character":"Ethan","profilePath":"/tDQQamh95HT4XcYJXyHzvT7QFE7.jpg"},{"id":1094385,"name":"LaMonica Garrett","character":"Chopper","profilePath":"/yE5TBZ2qC5LAPDduBQAERo7EF3r.jpg"},{"id":78433,"name":"Ryan Hansen","character":"DJ Avilo","profilePath":"/n4d1DiK3KyrQNN3G2QKt4Tos53Q.jpg"},{"id":3126,"name":"Ione Skye","character":"Susan","profilePath":"/ye8qsi6fn51HW93c7065Jogbh9p.jpg"},{"id":123813,"name":"Ian Anthony Dale","character":"Anders","profilePath":"/x5ePN7j7C4ZmytO5VoUOpiPEyRm.jpg"},{"id":132312,"name":"Brianne Howey","character":"Darla","profilePath":"/cyy56FAt2mMWR4tWo53pIbw6eCk.jpg"},{"id":1389383,"name":"Medalion Rahimi","character":"Nikki","profilePath":"/v282V5NixzGwGE9rEZKZ2XxhOoO.jpg"},{"id":1142822,"name":"Peter Gilroy","character":"Jayce","profilePath":"/2AEsYVmH3lJXvG8aWK2EZNdCklR.jpg"},{"id":1534800,"name":"Gentry White","character":"Top Hat","profilePath":"/d7FXFm1c6ksiPh1UGxuo8nqKxaV.jpg"}],"updatedAt":"2026-11-14T18:42:19Z"},"movie:36657":{"tmdbId":36657,"type":"movie","title":"X-Men","originalTitle":"X-Men","year":"2000","genres":["Abenteuer","Action","Science Fiction"],"voteAverage":7.0,"voteCount":12728,"overview":"Die Ausreißerin Rogue, die aufgrund ihrer wachsenden Mutantenkräfte, nämlich die Fähigkeit, durch Berührung die Persönlichkeiten, Erinnerungen und Kräfte anderer Menschen kurzzeitig zu absorbieren, von zu Hause weggelaufen ist, trifft bei ihrer Flucht in Kanada auf den Einzelgänger Logan, der geschärfte Sinne und die Fähigkeit besitzt, eigene Verletzungen in Sekunden zu heilen. Dazu ist sein Skelett vollständig mit einem schier unzerstörbarem Metall (Adamantium) überzogen und mit sechs ausfahrbaren Klauen bewaffnet; Logan kann sich aber nicht erinnern, wann und wo sein Skelett derart behandelt worden ist, noch hat er irgendeine Erinnerung an seine eigene Vergangenheit.","runtime":104,"posterPath":"/6z7kT8Jz7VnyIzL2Gh8G1YqwhtS.jpg","backdropPath":"/3QUVzbcNyfGe3ocWkYAT8emK8Co.jpg","cast":[{"id":6968,"name":"Hugh Jackman","character":"Logan / Wolverine","profilePath":"/4Xujtewxqt6aU0Y81tsS9gkjizk.jpg"},{"id":2387,"name":"Patrick Stewart","character":"Xavier","profilePath":"/ufqtnLh3JJjPbEgxEag3MM5nZyv.jpg"},{"id":1327,"name":"Ian McKellen","character":"Magneto","profilePath":"/5cnnnpnJG6TiYUSS7qgJheUZgnv.jpg"},{"id":10696,"name":"Famke Janssen","character":"Jean Grey","profilePath":"/uvZGwNsLqe9NyA57Qlt46IkO8Bd.jpg"},{"id":11006,"name":"James Marsden","character":"Cyclops","profilePath":"/lf7OnfKZnMgNh9b98764tqSocGK.jpg"},{"id":4587,"name":"Halle Berry","character":"Storm","profilePath":"/84HRDZodRCuBSpYGSc3ow8WucI4.jpg"},{"id":10690,"name":"Anna Paquin","character":"Rogue","profilePath":"/5FjBCsn3kujldP8LizoCrc3hsHp.jpg"},{"id":9832,"name":"Tyler Mane","character":"Sabretooth","profilePath":"/3M8oXR5bBsnOJX29SGrQ1vx9L7R.jpg"},{"id":11007,"name":"Ray Park","character":"Toad","profilePath":"/1BxwBrCTfTw9u9RGwEl6qWbPnZL.jpg"},{"id":11008,"name":"Rebecca Romijn","character":"Mystique","profilePath":"/doqFBHNbNhoLF9RX9SYPqwu1mvd.jpg"},{"id":52374,"name":"Bruce Davison","character":"Senator Kelly","profilePath":"/41JtouCUhnnBwWmdsemPydtk3FB.jpg"},{"id":115854,"name":"Matthew Sharp","character":"Henry Guyrich","profilePath":"/r4YpRV7mTuuDx6esAVQKYkPHpUL.jpg"}],"updatedAt":"2026-11-14T18:42:19Z"},"movie:36658":{"tmdbId":36658,"type":"movie","title":"X-Men 2","originalTitle":"X2","year":"2003","genres":["Abenteuer","Action","Science Fiction"],"voteAverage":7.0,"voteCount":11349,"overview":"Sie sind das nächste Glied in der Evolutionskette. Jeder von ihnen kam mit einer einzigartigen genetischen Mutation auf die Welt, jeder mit einer anderen außergewöhnlichen Fähigkeit, die sich erstmals in der Jugend zeigt. In einer zunehmend von Vorurteilen und Hass beherrschten Welt interessieren sie jedoch nur als wissenschaftliche Kuriositäten ... als Launen der Natur ... als Ausgestoßene, gefürchtet und verachtet, weil Andersartigkeit nicht akzeptiert wird. Trotz der weit verbreiteten Ignoranz der Gesellschaft schaffen es die X-Men, und mit ihnen weltweit Tausende anderer Mutanten zu überleben. Unter den Fittichen des mächtigsten Telepathen der Welt, Professor Charles Xavier, lernen diese \"begabten\" Studenten, ihre Kräfte zu kontrollieren und sie zum Vorteil der Menschheit einzusetzen. Sie kämpfen für den Schutz einer Welt, die sie fürchtet.","runtime":133,"posterPath":"/5Dgx75EGgxF8mcrQKPYa8yBM8yw.jpg","backdropPath":"/s8ftvFvafWWEhApISamHx32bx6h.jpg","cast":[{"id":6968,"name":"Hugh Jackman","character":"Logan / Wolverine","profilePath":"/4Xujtewxqt6aU0Y81tsS9gkjizk.jpg"},{"id":2387,"name":"Patrick Stewart","character":"Professor Charles Xavier","profilePath":"/ufqtnLh3JJjPbEgxEag3MM5nZyv.jpg"},{"id":1327,"name":"Ian McKellen","character":"Eric Lehnsherr / Magneto","profilePath":"/5cnnnpnJG6TiYUSS7qgJheUZgnv.jpg"},{"id":11006,"name":"James Marsden","character":"Scott Summers / Cyclops","profilePath":"/lf7OnfKZnMgNh9b98764tqSocGK.jpg"},{"id":1248,"name":"Brian Cox","character":"William Stryker","profilePath":"/scSjbFCTRngXlkJRoKptM5kQGw7.jpg"},{"id":10696,"name":"Famke Janssen","character":"Jean Grey","profilePath":"/uvZGwNsLqe9NyA57Qlt46IkO8Bd.jpg"},{"id":4587,"name":"Halle Berry","character":"Ororo Munroe / Storm","profilePath":"/84HRDZodRCuBSpYGSc3ow8WucI4.jpg"},{"id":10697,"name":"Alan Cumming","character":"Kurt Wagner / Nightcrawler","profilePath":"/axil8ufunARfqyU4ceZNh36fkVQ.jpg"},{"id":11022,"name":"Aaron Stanford","character":"John Allerdyce / Pyro","profilePath":"/xt2c0vdTb6UmSFq6fl09iCcIFve.jpg"},{"id":11008,"name":"Rebecca Romijn","character":"Raven Darkholme / Mystique","profilePath":"/doqFBHNbNhoLF9RX9SYPqwu1mvd.jpg"},{"id":11023,"name":"Shawn Ashmore","character":"Bobby Drake / Ice Man","profilePath":"/tXA1gFtsp9HWnzlQsaZSoZC8L4r.jpg"},{"id":10690,"name":"Anna Paquin","character":"Rogue","profilePath":"/5FjBCsn3kujldP8LizoCrc3hsHp.jpg"}],"updatedAt":"2026-11-14T18:42:19Z"},"movie:36668":{"tmdbId":36668,"type":"movie","title":"X-Men: Der letzte Widerstand","originalTitle":"X-Men: The Last Stand","year":"2006","genres":["Abenteuer","Action","Science Fiction"],"voteAverage":6.4,"voteCount":10816,"overview":"Die Veröffentlichung eines \"Heilmittels\" für Mutanten schreckt die bisher friedlich mit den Menschen lebende Gesellschaft auf. Magneto nimmt das zum Anlaß einen Kriegszug gegen die Menschen zu führen, um endlich die Herrschaft zu erlangen. Doch die X-Men um Professor Xavier versuchen dem Treiben ein Ende zu bereiten, das Gleichgewicht und den Frieden wieder herzustellen.","runtime":104,"posterPath":"/5lLtSbUVf8nUdUqQCLjp63wzamY.jpg","backdropPath":"/nLMXULCGLnzRxz11txPzPqbOHSz.jpg","cast":[{"id":6968,"name":"Hugh Jackman","character":"Logan / Wolverine","profilePath":"/4Xujtewxqt6aU0Y81tsS9gkjizk.jpg"},{"id":4587,"name":"Halle Berry","character":"Ororo Munroe / Storm","profilePath":"/84HRDZodRCuBSpYGSc3ow8WucI4.jpg"},{"id":1327,"name":"Ian McKellen","character":"Erik Lehnsherr / Magneto","profilePath":"/5cnnnpnJG6TiYUSS7qgJheUZgnv.jpg"},{"id":2387,"name":"Patrick Stewart","character":"Professor Charles Xavier","profilePath":"/ufqtnLh3JJjPbEgxEag3MM5nZyv.jpg"},{"id":10696,"name":"Famke Janssen","character":"Jean Grey / Ph