ten Wissenschaftlerin Victoria Vance, um die Superkräfte der PAW Patrol zu stehlen! Da das Schicksal der Abenteuerstadt auf dem Spiel steht, müssen die Mighty Pups die Superschurken aufhalten, bevor es zu spät ist. Und Skye muss lernen, dass selbst der kleinste Welpe den grössten Unterschied machen kann.","poster":"/lFSJMELO3oGJWJT7gtXb4Kf8FDk.jpg","runtime":88.0,"title":"Paw Patrol: Der Mighty Kinofilm","type":"movie","va":7.0,"vc":616,"year":"2023"},"movie:932480":{"cast":[{"id":3404286,"name":"Thomas Brady","photo":""},{"id":3404283,"name":"Caleb Rogers","photo":""}],"genres":["Action","Komödie"],"id":932480,"original":"The Ambush","overview":"","poster":"/ltpfqNusMK8OR1Z0cVNMbqoDlkL.jpg","runtime":3.0,"title":"The Ambush","type":"movie","va":0.0,"vc":0,"year":"2022"},"movie:974169":{"cast":[{"id":1301937,"name":"أحمد داود","photo":"/a7p4iWp2i5yymtdRmGMtyPHGZHh.jpg"},{"id":1614510,"name":"دينا الشربيني","photo":"/yKIdQwGzMtYN7j75gSQOYQOwVXz.jpg"},{"id":223724,"name":"Sherif Mounir","photo":"/69ttY5VkABXQeTcFZBkxcxvaXjf.jpg"},{"id":1723887,"name":"Nesreen Amin","photo":"/xOqnEsfAEgZrAXS3MzgKDVGmywS.jpg"},{"id":1397667,"name":"جومانا مراد","photo":"/593m2ImBQmsODGQfmr4a6HLvkbZ.jpg"},{"id":223962,"name":"Mahmoud Abdel Moghny","photo":"/78NvDJqQ2X71GDKXDIpH0kqEdvp.jpg"},{"id":1164724,"name":"أحمد زاهر","photo":"/hbhHnt2G2FBFS3HNfwjGc0klL5O.jpg"},{"id":2740853,"name":"Noha Abdin","photo":"/c1lw85Nj891RTEpdewaZElNBcjW.jpg"}],"genres":["Thriller","Horror"],"id":974169,"original":"يوم 13","overview":"","poster":"/cFmSA1lAoK34WtgqYoPO7vRgJN9.jpg","runtime":115.0,"title":"يوم 13","type":"movie","va":5.8,"vc":5,"year":"2023"},"movie:982447":{"cast":[{"id":2553127,"name":"Sri Simha Koduri","photo":"/muzsjXflMjLQUAVhoZxvlepgeKZ.jpg"},{"id":2320762,"name":"Preethi Asrani","photo":"/zVFJJ2hGAWk9SAXPJ5Mxgr22gCL.jpg"},{"id":585397,"name":"சமுத்திரக்கனி","photo":"/z8mU71yAUfVLgKWHorsTIsyQwnt.jpg"},{"id":2696353,"name":"Srikanth Iyengar","photo":"/aWerpaujBKMU8r4qsgnQp9RoTtd.jpg"},