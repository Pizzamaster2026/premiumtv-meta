337806,"name":"Waleed Elgadi","photo":"/7YOAlGYW2TnDbi76gWBqOfEEhjK.jpg"},{"id":1334639,"name":"Hannah Arterton","photo":"/5VABzbYUfRiWb7Xkchoehhz60ql.jpg"},{"id":13022,"name":"Tom Berenger","photo":"/8PSsSsFI1EpEvxifq8rPe3412iv.jpg"},{"id":1474690,"name":"Jill Winternitz","photo":"/bBfmth2C93OkyYir6w8qxjmHpiR.jpg"}],"genres":["Action","Thriller"],"id":1214314,"original":"One More Shot","overview":"Ein Terror-Anschlag droht. Es sind nur noch 90 Minuten, um ihn zu stoppen. Der gefangene Terrorist Amin Mansur ist der Schlüssel. Doch dafür muss ihn Navy Seal Jake Harris nach Washington bringen. Der Elitesoldat, der gerade erst die brenzligen Ereignisse in einer Geheimeinrichtung in Polen überstanden hat, findet sich so schnell im nächsten adrenalingetriebenen Überlebenskampf wieder. Denn Terroristen stürmen den Flughafen und bringen ihn unter ihre Kontrolle. Irgendwie muss Harris mit seinem Gefangenen im Schlepptau entkommen. Denn bald wird sich zeigen, dass er nicht auf Hilfe von außen hoffen kann.\r Sequel zum ohne sichtbaren Schnitt gedrehten Action-Kracher „One Shot“.","poster":"/ohdzJYj7WWmH8IpfOAINDhxmW9x.jpg","runtime":102.0,"title":"One More Shot","type":"movie","va":6.6,"vc":317,"year":"2024"},"movie:1217647":{"cast":[{"id":4350341,"name":"Emma Jade","photo":"/gx5IAIIxXPsluWbMiGgzQuISv7o.jpg"},{"id":4429086,"name":"Alyssa Nicole","photo":"/4B7I6by3IcYeVvIsC1DNmvDqxk7.jpg"},{"id":4429088,"name":"Noor Badash","photo":"/aubyw8emlK7d5e3DKAQGIk9THxM.jpg"},{"id":4425583,"name":"Dylan Bonansigna","photo":"/2SZiakzn8C9wiNYgCUl6T4TUBV9.jpg"},{"id":4711263,"name":"Cherish Waters","photo":"/idipk2cHHDtMKsZKyfPvn1oVXmG.jpg"},{"id":4711264,"name":"Blake Eiermann","photo":"/zDZgSTOmYICqKhbQmNKudVAFwdy.jpg"},{"id":4711266,"name":"Davi Stefond","photo":"/5HZtmmPI0Vjxs3dz8MXrumL8JDd.jpg"},{"id":4711267,"name":"Frankie Tan","photo":"/pFlcKJ6WT8y5OysPCfkQwJbcAca.jpg"}],"genres":["Thriller","Drama","Horror"],"id":1217647,"original":"Iconic","overview":"Make-up-Guru Rose muss sich nicht nur mit Hassmails einer konkurrierenden Künstlerin herumschlagen, sondern auch mit einem gewalttätigen Stalker. Nachdem sie mit Lily in eine toxische Liebesspirale geraten ist, gerät Rose in ein gefährliches Kaninchenloch aus Drogen, Paranoia und Eifersucht, bis sie einen unvorstellbaren Tiefpunkt erreicht.","poster":"/1l0lPD1rih3YsJgL1B8ZozGx0oy.jpg","runtime":90.0,"title":"Iconic - Dem Wahnsinn verfallen","type":"movie","va":5.1,"vc":14,"year":"2024"},"movie:1244175":{"cast":[{"id":27741,"name":"Robert Allen Mukes","photo":"/uMbw5m5QatUvQacoMR1aV0lSwOC.jpg"},{"id":1761537,"name":"Amber Dawn Fox","photo":"/q40ogSLoSOwIK4xY5dvykHx35De.jpg"},{"id":98420,"name":"Lynn Lowry","photo":"/mBqg1ecbhyYRGqZFRX7RRJVgnMp.jpg"}],"genres":["Drama","Thriller"],"id":1244175,"original":"Locked In","overview":"","poster":"/x32C9oSmuYCE39qCYrit62AjT14.jpg","runtime":79.0,"title":"Locked In","type":"movie","va":0.0,"vc":0,"year":"2023"},"movie:1249608":{"cast":[{"id":1627281,"name":"白客","photo":"/t7Hi7qYnXPaeehR7K5rbf0hHX0B.jpg"},{"id":1734106,"name":"喬杉","photo":"/zaTccwcq61PWWzWIgqapnpQph00.jpg"},{"id":2140106,"name":"黄才伦","photo":"/blvudwE8C0fOYde94LgYfEaYqiY.jpg"},{"id":1473995,"name":"王大陸","photo":"/3CDx0mIClEqcUt8E6ToEkdQypzK.jpg"},{"id":2796119,"name":"李嘉琦","photo":"/wlwqQJSsTTzEks2HWgjCTRiD99Q.jpg"},{"id":2093326,"name":"魏翔","photo":"/j1XqYkSGoRHfBOH59nTOnv7DcRn.jpg"},{"id":1996700,"name":"许君聪","photo":"/nZYcU98OsKJeOyEdHFZwrrPqlaE.jpg"},{"id":2150044,"name":"米咪","photo":"/r7MlkE8lJuD0pW82oDE2JX1xwqY.jpg"}],"genres":["Komödie"],"id":1249608,"original":"好运来","overview":"","poster":"/7TE7drVKGH08Y6kIUGt6pBLG2wr.jpg","runtime":0.0,"title":"好运来","type":"movie","va":4.6,"vc":5,"year":"2024"},"movie:1250512":{"cast":[{"id":29384,"name":"Sheila McCarthy","photo":"/wIe1srcx1lllkE66Jx5j9mV2BEc.jpg"},{"id":90683,"name":"Georgina Reilly","photo":"/bNLXDfDNV4AOmAuktORHiRqgpYt.jpg"},{"id":225411,"name":"Mark O'Brien","photo":"/8ckgltvlife4BBJcBpHEQWXfQ9p.jpg"},{"id":1447280,"name":"C