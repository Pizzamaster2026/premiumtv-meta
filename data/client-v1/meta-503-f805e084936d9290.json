l0UxJk8PPwlY.jpg"},{"id":2048,"name":"Gary Busey","photo":"/8H7Hlv6b7ZoK4jZKeLnc2i4pfPL.jpg"},{"id":68301,"name":"Will Sampson","photo":"/eTFrqcbAxcFzqmdEDR5PhIUKTNW.jpg"},{"id":32286,"name":"Patrick Kilpatrick","photo":"/yhujborr3HMC9ALvuOPu25ffAhN.jpg"},{"id":3249061,"name":"Ian O'Connell","photo":""},{"id":3249064,"name":"George Holmes","photo":""}],"genres":["Drama","Komödie"],"id":42035,"original":"Insignificance","overview":"Die Geschichte einer fiktiven Begegnung von Marilyn Monroe und Albert Einstein 1954 in einem New Yorker Hotelzimmer. Zunächst komödiantischer, dann sehr ernsthafter Versuch, die Konflikte und inneren Widersprüche hinter den Mythen, die beide Figuren jeweils verkörpern, sichtbar zu machen. Ein Filmisches Kammerspiel von bemerkenswerter Qualität mit Tony Curtis, Theresa Russell und Michael Emil.","poster":"/bTgdIGfrgHI4IRecHL2X6y18VNs.jpg","runtime":109.0,"title":"Insignificance - Die verflixte Nacht","type":"movie","va":6.4,"vc":72,"year":"1985"},"movie:49049":{"cast":[{"id":1372,"name":"Karl Urban","photo":"/7Y96dAfg0HcFrcLjlD5eD9N0uj4.jpg"},{"id":52442,"name":"Olivia Thirlby","photo":"/x9ZlUX617wi9li2TJ5UuYpHzPfN.jpg"},{"id":17286,"name":"Lena Headey","photo":"/cDyZLf8ddz0EgoUjpv4jjzy7qxA.jpg"},{"id":65829,"name":"Wood Harris","photo":"/v3puIl2KncqUd6amDyD1Y0crzkF.jpg"},{"id":37093,"name":"Langley Kirkwood","photo":"/tSKPfLCtWrXsmkZT31oAS4SLfUw.jpg"},{"id":1838215,"name":"Tamer Burjaq","photo":"/rz1FOttxvkeVkAh7XxjBwd8eGgC.jpg"},{"id":137463,"name":"Joe Vaz","photo":"/h7DsyuzlJ93IsBdbqfvPKppnNl4.jpg"},{"id":195575,"name":"Rakie Ayola","photo":"/oaLs5ACdurV2lij6GEidn0fSrUq.jpg"}],"genres":["Action","Science Fiction"],"id":49049,"original":"Dredd","overview":"Das zukünftige Amerika ist verstrahltes Brachland. An der Ostküste liegt Mega City One - eine riesige, gewalttätige Metropole wo Kriminelle die chaotischen Straßen beherrschen. Die einzige Kraft der Ordnung liegt bei den städtischen Polizisten genannt \"Judges\" die sich durch die kombinierten Kräfte der Richter, Jury und Henker auszeichnen. Bekannt und in der ganzen Stadt gefürchtet. Dredd ist der höchste Richter, mit der Aufgabe die Stadt von der neusten Plage zu befreien - einer gefährlichen Drogen Epidemie, die Nutzer von \"Slo-Mo\" erleben Wirklichkeit zu einem Bruchteil ihrer normalen Geschwindigkeit. Während eines routinemäßigen Tages bei der Arbeit wurde Dredd zugewiesen Cassandra Anderson zu trainieren,  eine Anfängerin mit mächtigen psychischen Fähigkeiten dank einer genetischen Mutation. Ein abscheuliches Verbrechen ruft sie in eine Gegend, wo Judges sich nur selten hinwagen - einem Slum, kontrolliert von Prostituierten veränderten Drogen Lord Ma-Ma und ihr rücksichtsloser Clan.","poster":"/uXXpyOwVc0Jy8Pw4QrtOISyorsX.jpg","runtime":95.0,"title":"Dredd","type":"movie","va":6.9,"vc":5830,"year":"2012"},"movie:52337":{"cast":[{"id":81970,"name":"John Garfield","photo":"/f0OMA5i7YCYuHrmgy13BypChCg3.jpg"},{"id":7331,"name":"Eleanor Parker","photo":"/fOzLJeXoHryUyPFmJWIkdLvfX3G.jpg"},{"id":89524,"name":"Dane Clark","photo":"/SJ5xuhll3lGfSRZaB8ZdLSmPvs.jpg"},{"id":2673,"name":"John Ridgely","photo":"/gsngEYbN6cn90gZPPeBe7mnUr60.jpg"},{"id":30273,"name":"Rosemary DeCamp","photo":"/qogZ06A7RZQIqzJaK7Q36EDOQyq.jpg"},{"id":2772,"name":"Ann Doran","photo":"/t6q0svIGjotyJQgxr74pKz6462g.jpg"},{"id":935345,"name":"Ann E. Todd","photo":"/5RRT0S8C5qjxHWmpFaqogVrrNO.jpg"},{"id":40459,"name":"Warren Douglas","photo":"/dggvDSeg5JetnE8yeMskdWL303E.jpg"}],"genres":["Drama","Kriegsfilm"],"id":52337,"original":"Pride of the Marines","overview":"","poster":"/jpDRMCsw1TsLVrrZgkecneIbHeD.jpg","runtime":119.0,"title":"Pride of the Marines","type":"movie","va":6.8,"vc":14,"year":"1945"},"movie:58159":{"cast":[{"id":227460,"name":"Eddie Holden","photo":""},{"id":227462,"name":"Ned Norton","photo":""},{"id":5462,"name":"Pinto Colvig","photo":"/jslBLHuV1cOKsyx763CA1RqsrQU.jpg"},{"id":232415,"name":"Marcellite Garner","photo":"/wnR43U3x7gVV3PM3BAZ7Kr7HQ4h.jpg"},{"id"