67,"name":"Glenn Brunskill","photo":""},{"id":2312269,"name":"Michal Cichorski","photo":""},{"id":2312270,"name":"Filippo De Filippi","photo":""},{"id":2312271,"name":"Craig Frederick","photo":""}],"genres":["Dokumentarfilm"],"id":570973,"original":"Last Breath","overview":"Der Taucher Chris Lemons ist auf dem Grund der Nordsee gestrandet; es verbleibt ihm genügend Sauerstoff für etwa fünf Minuten; Rettung ist frühestens in dreißig Minuten zu erwarten. In einem Wettlauf gegen die Zeit kämpft er um jeden Atemzug. Archivmaterial bietet bisher ungezeigte Aufnahmen vom außergewöhnlichen Überlebenskampf Lemons; am Boden des Meeres entschied für ihn jeder einzelne Atemzug um Leben und Tod.","poster":"/zfTNsILhmDiChJJ7Zxxl8IUvkUM.jpg","runtime":85.0,"title":"Der letzte Atemzug – Gefangen am Meeresgrund","type":"movie","va":7.5,"vc":127,"year":"2019"},"movie:591983":{"cast":[{"id":1088604,"name":"Elizabeth Bove","photo":""},{"id":2802859,"name":"Ben Michael Brown","photo":"/k3XHWlKToCkPLphI3ZLknzCWvqO.jpg"},{"id":2802860,"name":"Sabrina Cataudella","photo":""},{"id":2802861,"name":"Sofiya Cheyenne","photo":"/joZ9I50gqtBDEI2mNB2Qpun4FCV.jpg"},{"id":1566748,"name":"Lisa DiFiore","photo":""},{"id":2802863,"name":"Christopher Greiner","photo":""},{"id":2802864,"name":"Rich Holscher","photo":""},{"id":2802865,"name":"Kevin Cammarota","photo":""}],"genres":["Drama","Krimi"],"id":591983,"original":"Jimbo","overview":"","poster":"/ewJrS9V69yWp3lvEEhrp1Tir6CJ.jpg","runtime":105.0,"title":"Jimbo","type":"movie","va":4.0,"vc":1,"year":"2018"},"movie:599903":{"cast":[{"id":994338,"name":"Raisul Islam Asad","photo":"/xKocsyZO7H6GEb0N4Zm5SKxCXKs.jpg"},{"id":1963616,"name":"Suborna Mustafa","photo":"/faBHriQKPaeyAxgLhI274HjevHi.jpg"},{"id":984991,"name":"Nasiruddin Yousuff","photo":""},{"id":994354,"name":"Tariq Anam Khan","photo":"/hHKkmaNQtvSV3cNeBpm9wHcTn55.jpg"},{"id":2304363,"name":"Syed Hasan Imam","photo":"/haZHNWNkPAJbjay6w5ja38qvArH.jpg"},{"id":997532,"name":"Golam Mustafa","photo":"/s7H2vvDpzoPph0IYpQ3JBzm9LwT.jpg"},{"id":2090563,"name":"Naila Azad","photo":"/x6CHgJ9IVGgYaAyVstcKbdnKTCx.jpg"},{"id":2304366,"name":"Happy Akhand","photo":""}],"genres":["Drama","Liebesfilm"],"id":599903,"original":"ঘুড্ডি","overview":"","poster":"/8r36eI13Z71xWMGFIgudqWa5EOg.jpg","runtime":145.0,"title":"ঘুড্ডি","type":"movie","va":9.0,"vc":1,"year":"1980"},"movie:609734":{"cast":[{"id":52442,"name":"Olivia Thirlby","photo":"/x9ZlUX617wi9li2TJ5UuYpHzPfN.jpg"},{"id":64295,"name":"Alan Ritchson","photo":"/92YNEEpCyugkTzPprJwZpvVtvuK.jpg"},{"id":84407,"name":"Jim Gaffigan","photo":"/dhguhHxIrb26jvPznBt8y25Fb2U.jpg"},{"id":205797,"name":"Maria Dizzia","photo":"/sMsBH9o1kuFeVgjX2QoXvxccKJQ.jpg"},{"id":19537,"name":"Megan Fox","photo":"/9khvk5svs81TLqIGlI3ZJqYtqaY.jpg"},{"id":83522,"name":"Tito Ortiz","photo":"/ivG0rCc5FE1XWdh6CIBTWfeIgBk.jpg"},{"id":57116,"name":"David Johansen","photo":"/efK1QHpUbRqiMZNT5Is0m86qjE.jpg"},{"id":144577,"name":"Justine Cotsonas","photo":"/5WxHnQD5EN6Zz3NWEU0acnJgpck.jpg"}],"genres":["Fantasy","Liebesfilm"],"id":609734,"original":"Above the Shadows","overview":"Nach dem frühen Tod ihrer Mutter, zieht sich Holly immer weiter zurück. Das Leben zieht an ihr vorbei und Holly scheint zu verblassen - bis sie für ihre Umwelt buchstäblich unsichtbar ist. Nach anfänglichem Entsetzen baut sie sich ein verhältnismäßig normales Leben auf. Verborgen im Schatten, verdient sich Holly ihren Lebensunterhalt als anonyme Promi-Fotografin. Sie scheint sich mit ihrem Leben zu arrangieren, bis sie auf den ehemals sehr erfolgreichen MMA-Champion Shane Blackwell trifft. Er ist nach Jahren der erste Mensch, der sie sehen kann. Als sich herausstellt, dass Holly auch für das Foto verantwortlich, das zu Shanes Absturz geführt hat, setzt sie alles daran, dies wiedergutzumachen...","poster":"/3FrGhwhyZdNtdZRXS6jQbFw9KYB.jpg","runtime":111.0,"title":"Above the Shadows","type":"movie","va":6.7,"vc":204,"year":"2019"},"movie:628704":{"cast":[{"id":1564175,"name":"Jin Ki-joo","photo":"/xwhR8nrFKxalOjmADxJPTouxE0g.jpg"},{"id":1557181,"name":"Wi Ha-jun","photo":"/tEZuIaMESdBw4LfNq3vshGR4VlP.jpg"},{"id":2166026,"name":"박훈","photo":"/vo0sLb0h5vJPr7OIooq64TMExIR.jpg"},{"id":1191711,"name":"길해연","photo":"/qoeacxu9ISr3V2Dar2XmEzoP2i9.jpg"},{"id":2214888,"name":"김혜윤","photo":"/ujFBbc3d0UdS4qeioxvO3xRLkdl.jpg"},{"id":3038411,"name":"박지훈","photo":"/a1lhJxxIBlJL7roIDY4dOEoRMML.jpg"},{"id":2275300,"name":"정원창","photo":"/1rmdrN0gbQuLfPrw18BUQarD8o0.jpg"},{"id":564847,"name":"이상희","photo":"/wOYFSg20yGe48VFALqGAlrLjFHV.jpg"}],"genres":["Thriller","Krimi"],"id":628704,"original":"미드나이트","overview":"Der clevere Serienmörder Do-sik fährt mit seinem schwarzen Van durch die Nächte Seouls und lauert auf Beute. Bevor die Auserwählten seine charmante Fassade durchschauen können, landen sie als Leichen in dunklen Gassen. Eines Nachts stolpert die gehörlose Call-Center-Angestellte Kyung-mi auf dem Nachhauseweg über Do-siks letztes, noch lebendes Opfer. Zur falschen Zeit am falschen Ort, gerät Kyung-Mi mitsamt ihrer ebenfalls hörgeschädigten Mutter nun ins Visier des Killers. Ein perfides Katz-und-Maus-Spiel entspinnt sich, in dem Mutter und Tochter sich gegen den unberechenbaren Psychopathen mit allen Mitteln zur Wehr setzen. Wenn der Killer meinte, er könnte die zwei wegen ihres Handycaps so einfach überwältigen, hat er sich definitiv die falschen Frauen ausgesucht!","poster":"/w7EAmIUfFuGkApkRwZe7UJFvcJv.jpg","runtime":103.0,"title":"Midnight","type":"movie","va":7.1,"vc":336,"year":"2021"},"movie:660942":{"cast":[{"id":2946554,"name":"Rakel Lenora Fløttum","photo":"/4KAMcJGVBWnlZyE9S5DhHmKiRvY.jpg"},{"id":2946555,"name":"Alva Brynsmo Ramstad","photo":"/1f54gbTdVrqv9lOTcWIW9JHONG.jpg"},{"id":2946556,"name":"Sam Ashraf","photo":"/wAIqtAB8f3t2absV8jLqW0COAKz.jpg"},{"id":2946557,"name":"Mina Yasmin Bremseth Asheim","photo":"/6sgBKAivbLOCwBt2dfWw1b6hr9R.jpg"},{"id":79331,"name":"Ellen Dorrit Petersen","photo":"/ynXvnMlMCCn0Uk6AOwRHLQRF9nZ.jpg"},{"id":1989208,"name":"Morten Svartveit","photo":"/d6OuyyT784UVwAM4bGY3ON6GbDJ.jpg"},{"id":2902152,"name":"Kadra Yusuf","photo":"/eflqRr9eLN5UXnCIipTT1fyEz3X.jpg"},{"id":1479663,"name":"Lisa Tønne","photo":"/m7rpDEXK82bxjjGXaaRLBumKl3k.jpg"}],"genres":["Horror","Drama","Fantasy"],"id":660942,"original":"De uskyldige","overview":"In einer Hochhaussiedlung entdecken vier Kinder beim Spielen, dass sie besondere Fähigkeiten besitzen. Während die Erwachsenen nicht hinschauen, erproben die Kinder ihre neu gewonnene Macht. Die Zeiten von Vernachlässigung und Bevormundung scheinen für sie endlich vorbei zu sein. Doch als die Freundschaften zu bröckeln beginnen, wird der Wohnblock zum Schauplatz eines gefährlichen Kräftemessens.","poster":"/exOAKvWgMunzOYqbmQtaWqi6Blk.jpg","runtime":117.0,"title":"The Innocents","type":"movie","va":6.9,"vc":812,"year":"2021"},"movie:6687":{"cast":[{"id":57755,"name":"Woody Harrelson","photo":"/igxYDQBbTEdAqaJxaW6ffqswmUU.jpg"},{"id":1246,"name":"Emily Mortimer","photo":"/oZ4CZW2eW8lL2alD1mwZrFkfACI.jpg"},{"id":2282,"name":"Ben Kingsley","photo":"/k3Dmu49B2akwDvgqy52MOxznI59.jpg"},{"id":51072,"name":"Kate Mara","photo":"/t8a9iWAZrkdKjRG8jmtT27bJf0W.jpg"},{"id":17093,"name":"Eduardo Noriega","photo":"/wL2pCdw5lNsDrWRor3rxwLaSTQK.jpg"},{"id":3491,"name":"Thomas Kretschmann","photo":"/7M0P39a3CVA22dJyv5YQEkTThU7.jpg"},{"id":150792,"name":"Étienne Chicot","photo":"/nZaZ6L1Grd5LVXUGCC4ABuEKZvZ.jpg"},{"id":33403,"name":"Mac McDonald","photo":"/gejehuptBzsJlPiWKU8B9TTrc7r.jpg"}],"genres":["Thriller","Krimi","Mystery"],"id":6687,"original":"TransSiberian","overview":"In China macht sich das leicht gegensätzliche Ehepaar Roy und Jessie auf die Heimreise - allerdings wählen sie den langen Weg und wollen die Strecke Peking-Moskau mittels der transsibirischen Eisenbahn bewältigen. Im Zug müssen sie bald das Abteil mit einem anderen Pärchen teilen: der jungen Abby und dem Spanier Carlos. Carlos flirtet dann auch schon bald recht offensiv Jessie an, die aber aufgrund ihrer recht unsteten Jugend ganz gern mit dem biederen Roy verheiratet ist. Was sie nicht wissen ist, daß Carlos und Abby heiße Ware schmuggeln und das US-Pärchen in ihren Plan miteinbeziehen wollen. Bei einem Zwischenstopp ist Roy plötzlich verschwunden - während Jessie an der nächsten Station wartet, schließen sich Carlos und Abby ihr an. Doch ein Ausflug zu einer fotogenen Kirche in der Umgebung nimmt eine grauenhafte Wendung und schon bald ist Jessie ein nervliches Wrack - zumal der russische Polizist Grinko zusteigt und ausgerechnet in ihrem Abteil landet...","poster":"/A4N4PI9NUq2enUVsTjhpzA5yfWI.jpg","runtime":111.0,"title":"Transsiberian - Reise in den Tod","type":"movie","va":6.4,"vc":856,"year":"2008"},"movie:675856":{"cast":[{"id":1470020,"name":"Mazdak Mirabedini","photo":"/cPtxeTgHx0oYJCzcbpTmBedCS5I.jpg"},{"id":1930896,"name":"Negar Abedi","photo":"/xyu2pIuWnJsQ9GB1wAbBKOo2YaM.jpg"},{"id":2546970,"name":"Mehri Al Agha","photo":""},{"id":2546971,"name":"Abbas Ahmadi Motlagh","photo":""},{"id":1447005,"name":"Afsar Asadi","photo":"/o8Bl4nqdM1G36hE9PifxqzvvMwU.jpg"},{"id":1752920,"name":"Mahmoud Nazaralian","photo":"/f6WnvCEr1NA4aTfHD33hN6Qbekj.jpg"},{"id":1919908,"name":"Hamidreza Pegah","photo":"/gxB2JgY1JXYlIn0cnWsohOSfR9X.jpg"}],"genres":["Drama"],"id":675856,"original":"رقص پا","overview":"","poster":"/2mw6Pofsm1ncrjdhq4UYCpYA86o.jpg","runtime":80.0,"title":"رقص پا","type":"movie","va":0.0,"vc":0,"year":"2017"},"movie:701548":{"cast":[{"id":154000,"name":"Essence Atkins","photo":"/bgc46LlDEBzf0paajpn471dPxZA.jpg"},{"id":15564,"name":"Keith D. Robinson","photo":"/2XN49JQRDzpg1qUjIydbvO5iWxT.jpg"},{"id":62092,"name":"Matt Cedeño","photo":"/5VjAGcCMczq2lYR6q4CEjc0hIDB.jpg"},{"id":1796341,"name":"Kerri J. Baldwin","photo":"/oUywTQHX2sWViJ9zLZksHO61A90.jpg"},{"id":1367293,"name":"Déjá Dee","photo":"/alr4mjTZswekqHkuU7kZ6asFMvP.jpg"},{"id":2416452,"name":"Marquita Goings","photo":"/yod8oFr6d6twwxowzCeAXdwCLWS.jpg"},{"id":122270,"name":"Ernestine Johnson",