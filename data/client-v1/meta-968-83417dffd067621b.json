omben trotzen.","poster":"/qMNVK8g3BMPs0DExHX60nh3Wm88.jpg","runtime":90.0,"title":"Sharknado 2","type":"movie","va":4.5,"vc":738,"year":"2014"},"movie:297399":{"cast":[{"id":20788,"name":"Artie Lange","photo":"/sP1BgW2y1Z1sas3aPu8tvb7rfz5.jpg"}],"genres":["Komödie"],"id":297399,"original":"Artie Lange: The Stench of Failure","overview":"","poster":"/gZcNXYWhtC1JXQxfiIZmQI4ln1k.jpg","runtime":63.0,"title":"Artie Lange: The Stench of Failure","type":"movie","va":5.9,"vc":5,"year":"2014"},"movie:323863":{"cast":[],"genres":["Dokumentarfilm"],"id":323863,"original":"Nederland","overview":"","poster":"/ubdw4tmU0uzAngVjeT4OWgAhQwr.jpg","runtime":15.0,"title":"Nederland","type":"movie","va":7.3,"vc":9,"year":"1983"},"movie:324857":{"cast":[{"id":587506,"name":"Shameik Moore","photo":"/ovUKfVOwJ7CadEHaG3NDsfA5xRq.jpg"},{"id":543505,"name":"Jake Johnson","photo":"/3UNfW2qZgRkW81neNVfQvaRC92K.jpg"},{"id":130640,"name":"Hailee Steinfeld","photo":"/qDInsG0cxWNxS1X4t59TBZ5S6x5.jpg"},{"id":932967,"name":"Mahershala Ali","photo":"/9ZmSejm5lnUVY5IJ1iNx2QEjnHb.jpg"},{"id":226366,"name":"Brian Tyree Henry","photo":"/2MsJh0bpyzwvOUnXOltHp3j85Pb.jpg"},{"id":10437,"name":"Lily Tomlin","photo":"/eoFMSqRykiaXMGCiz7Kxehfqy1W.jpg"},{"id":141610,"name":"Luna Lauren Vélez","photo":"/98BvmTJCZHx0jPv0oNcv04Jkmfb.jpg"},{"id":37153,"name":"Zoë Kravitz","photo":"/n0mhAgmY6eJQmA7kaugsTZEJgHo.jpg"}],"genres":["Animation","Action","Abenteuer","Science Fiction"],"id":324857,"original":"Spider-Man: Into the Spider-Verse","overview":"Miles Morales wurde von einer genetisch veränderten Spinne gebissen. Das macht ihn schnell zum neuen Spider-Man mit den bekannten Fähigkeiten. Aber Miles ist ein Teenager ohne Ahnung von der verantwortungsvollen Nutzung seiner eigenen Kräfte. Doch Hilfe naht, denn durch eine scheinbar zufällig auftretende Verkettung mehrerer Paralleluniversen trifft Miles auf Spider-Man aka Peter Parker und dieser unterweist ihn in den neuen Superkräften und überträgt ihm Verantwortung. Wä