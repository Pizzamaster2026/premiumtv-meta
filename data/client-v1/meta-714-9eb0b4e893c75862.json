nHVbaLTnffo4Dj5UiyPBm4U.jpg"},{"id":912632,"name":"Jella Haase","photo":"/kwbw9Q4Cnk1Oiwz8ktIQXgECLTx.jpg"},{"id":149124,"name":"Ioana Iacob","photo":"/iI8lwVmyNtGaRrirwMSPic0mgm.jpg"},{"id":10236,"name":"Jörg Schüttauf","photo":"/fxQYG2JbWTZv2HRKo7GWl7xaOlH.jpg"},{"id":1264417,"name":"Anja Schneider","photo":"/l6hftBROf3py1rNtgGvVgllSpMf.jpg"},{"id":223477,"name":"Joel Basman","photo":"/uaBcyvAe8t5x5OuRiX50rPkTda6.jpg"},{"id":1146850,"name":"Emma Bading","photo":"/poQW3xdy6XhebW7bjIYtx9gHlM0.jpg"},{"id":70457,"name":"Peter Kremer","photo":"/ejVoS58S3LW0CakAW12ZDTsN8No.jpg"}],"genres":["Drama"],"id":835355,"original":"Lieber Thomas","overview":"Die DDR ist noch jung, aber Thomas Brasch passt schon nicht mehr rein. Es ist vor allem sein Vater Horst, der den neuen deutschen Staat mit aufbauen will. Doch Thomas will lieber Schriftsteller werden. Thomas ist ein Träumer, ein Besessener und ein Rebell. Schon sein erstes Stück wird verboten und bald fliegt er auch von der Filmhochschule. Sein eigener Vater verrät ihn und Thomas Brasch kommt ins Gefängnis.Ohne Aussicht, gehört zu werden, verlässt Thomas mit der Frau, die er liebt die Heimat. Im Westen wird er anfangs bejubelt, dreht mehrere Kinofilme, wird zweimal nach Cannes eingeladen. Doch Brasch lässt sich nicht vereinnahmen","poster":"/2SO5X6pnMlOyoaSPGL5WtiixQIi.jpg","runtime":150.0,"title":"Lieber Thomas","type":"movie","va":6.2,"vc":22,"year":"2021"},"movie:840427":{"cast":[{"id":1113157,"name":"Adrian Titieni","photo":"/cXTDbbmrPXvxrznP2ZAGYzVv1hn.jpg"},{"id":1888001,"name":"Elena Purea","photo":"/zXEAWiqVMgQCoyxorSd9A81vFdw.jpg"},{"id":1034687,"name":"Valeriu Andriuta","photo":"/AlyrK6JNl3fg6kEEhbs9jpeWvyy.jpg"},{"id":1617045,"name":"Judith State","photo":"/2Q4Ve3GlKDXbBQyJj9URmp4xxDk.jpg"},{"id":1747539,"name":"Virgil Aioanei","photo":"/zVKBgqIMOTpJesdYCKJLUUqd8nG.jpg"},{"id":1859382,"name":"Cristian Bota","photo":"/2YevUjzYP2D2jfnUeEtbRQs4ATp.jpg"},{"id":1700820,"name":"Adrian Păduraru","photo":"/kt8pSUaEaUiEgxwN6oaHaviHVsm.jpg"},{"id":1899149,"name":"Lucian Iftime","photo":"/f7m8hbGE0djZE8XByUCPhMG541b.jpg"}],"genres":["Drama","Thriller"],"id":840427,"original":"Tata mută munții","overview":"Mircea (Adrian Titieni), ein pensionierter Geheimdienstoffizier, erfährt, dass sein Sohn in den Bergen verschwunden ist. Nach tagelanger Suche stellt Mircea sein eigenes Rettungsteam zusammen, was zu Auseinandersetzungen mit der örtlichen Polizei führt.","poster":"/mFuFgPVuPmcYw0QtTub7HVj77AW.jpg","runtime":108.0,"title":"The Father Who Moves Mountains","type":"movie","va":5.8,"vc":99,"year":"2021"},"movie:854062":{"cast":[{"id":502397,"name":"Aylin Tezel","photo":"/em6Gouq0OvrAf77O7QJoArYBXlO.jpg"},{"id":1475231,"name":"Chris Fulton","photo":"/pFpXQvGTTJhMpDrgqezjiXCC2b1.jpg"},{"id":1267122,"name":"Rory Fleck-Byrne","photo":"/iwPrSa41IxD5jy3Fb7IVF0O5DQ2.jpg"},{"id":1403115,"name":"Alexandra Dowling","photo":"/r82iduLbDcvN4VvwfWtkFn6Libn.jpg"},{"id":55465,"name":"Samuel Anderson","photo":"/155QL3ZdGm6NseuA2bMnAXyB6hZ.jpg"},{"id":1213838,"name":"Juliet Cowan","photo":"/8zBYU2fqciM8kV6NAg1R6y6JHoh.jpg"},{"id":933272,"name":"Olwen Fouéré","photo":"/jvBLYkqqEdZGGcg4YVUZhBl6or4.jpg"},{"id":199055,"name":"Michael Carter","photo":"/k7ASHV3vaJcA6NBwXnz4AkcWe9v.jpg"}],"genres":["Liebesfilm","Drama"],"id":854062,"original":"Falling into Place","overview":"Kira (Aylin Tezel) und Ian (Chris Fulton), zwei Mittdreißiger, sind auf der Flucht – raus aus London, weg von ihrer Vergangenheit, raus aus ihren derzeitigen Leben. So treffen die beiden auf der Isle of Skye an der schottischen Westküste erstmals aufeinander. Sofort verspüren beide eine regelrecht magnetische Anziehung zueinander – und doch lösen sie sich anderthalb Tage später wieder voneinander und kehren zurück in den Süden, zurück in die Hauptstadt des Vereinigten Königreichs, zurück in den alten Trott. Nur wissen die beiden trotz ihrer intensiven Begegnung in Schottland immer noch nicht, dass sie beide in der britischen Metropole leben und immer nur Zufälle davon entfernt sind, sich zu begegnen. Aber beide müssen aufhören, vor sich selbst wegzulaufen, bevor sie bereit sind, sich wirklich auf jemand anderen einzulassen. Und vielleicht schaffen sie es dann nicht nur zu sich selbst, sondern auch zum anderen zu finden.","poster":"/ssw5hHhV6Prj4CVegSp44TyF0U0.jpg","runtime":113.0,"title":"Falling into Place","type":"movie","va":6.6,"vc":21,"year":"2023"},"movie:854567":{"cast":[{"id":3203811,"name":"Маріна Клімова","photo":"/54uNI98BdxIP9iOpIlaQyZs71W5.jpg"},{"id":3203812,"name":"Ірина Кір'язева","photo":""},{"id":3203813,"name":"Любовь Василина","photo":""},{"id":3795613,"name":"Vyacheslav Vygovskyi","photo":""},{"id":3795616,"name":"Oleksandr Mykhailov","photo":""},{"id":2618222,"name":"Ирина Токарчук","photo":"/vLx6SQw01W0tUTzlIvBcJhtZ4p4.jpg"},{"id":3795620,"name":"Raisa Roman","photo":""},{"id":3795622,"name":"Tetyana Klishch","photo":""}],"genres":["Drama","Dokumentarfilm"],"id":854567,"original":"Цензорка","overview":"Leysa wird zu sieben Jahren Haft in einem Frauengefängnis in Odessa verurteilt, nachdem sie ihren Mann aus Eifersucht getötet hat. Im Gefängnis kommt ihr Sohn Kolya zur Welt, womit auf eine Leysa auch eine schwere Entscheidung zukommt: Sie kann ihren Sohn entweder zur Adoption freigeben und ihn wahrscheinlich nie wieder sehen, oder aber von einem Familienmitglied adoptieren lassen, damit der Junge zumindest in der eigenen Familie aufwächst. Aber ihre Beziehung zu ihrer Mutter und ihrer Schwester, die in prekärer Situation leben, ist ziemlich schlecht. Die einzig gute Wahl scheint ihre trauernde Schwiegermutter zu sein…","poster":"/jGKmyhdBvBOw4pVhs79Gti14Vxv.jpg","runtime":90.0,"title":"107 Mothers","type":"movie","va":6.0,"vc":22,"year":"2021"},"movie:854765":{"cast":[{"id":60003,"name":"Cassandra Magrath","photo":"/wZTQ1dyVslqNYVFm7PHGEoMVEmi.jpg"},{"id":1242533,"name":"John Voce","photo":"/ht2RAEM1NloM62Mzx4NacsUftp7.jpg"},{"id":3174565,"name":"Nicholas Denton","photo":""},{"id":1