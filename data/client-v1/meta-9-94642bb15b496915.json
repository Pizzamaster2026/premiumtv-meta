/vQBxmLtlGqT8CuOnBwtzIWdwnNH.jpg"},{"id":79494,"name":"Matt Dallas","photo":"/kFGLCt1OEwWwCl8tdKhkcO8dnm.jpg"},{"id":52374,"name":"Bruce Davison","photo":"/41JtouCUhnnBwWmdsemPydtk3FB.jpg"},{"id":935720,"name":"Madison Lintz","photo":"/rr6tpaVVdeYAmZKl509HCizYFwg.jpg"},{"id":1659265,"name":"Heather DeVan","photo":"/vO9GMzm4WyH0TWLlZvrkJV52K64.jpg"},{"id":1389027,"name":"Austin Filson","photo":"/qjk0duMZCFgppDM7z8RPy5v5P8b.jpg"},{"id":1615594,"name":"Ahmed Lucan","photo":"/kKTco7xlaMtFwrUgh6PEwHYYAyM.jpg"}],"genres":["Thriller","Horror","Drama"],"id":409056,"original":"Along Came the Devil","overview":"Teenagerin Ashley hatte eine schwere Kindheit, doch nachdem ihr Vater verstorben, ihre ältere Schwester auf dem College und ihre Mutter auf mysteriöse Weise verschwunden ist, zieht sie zu ihrer Tante Tanya . Zehn Jahre später, als genug Gras über alles gewachsen zu sein scheint, begibt sich Ashley jedoch wieder zurück in die Stadt, wo sie aufwuchs – nur um dort wieder auf unheimliche Weise die Anwesenheit ihrer Mutter zu spüren. Sie geht dem nach und verhält sich plötzlich wie ein ganz anderer Mensch. Das hat einen Grund: Ein bösartiger Dämon hat Besitz von der Teenagerin ergriffen. Und so ist bald Priester Michael die einzige Hoffnung, denn er ist in der Lage, einen Exorzismus durchzuführen...","poster":"/tEiu83QxMMWWD8gWUtXR4piF1Iw.jpg","runtime":89.0,"title":"Along Came the Devil","type":"movie","va":5.4,"vc":112,"year":"2018"},"movie:414906":{"cast":[{"id":11288,"name":"Robert Pattinson","photo":"/3qZ09UE7lN6AtorfXFRYpEtSY93.jpg"},{"id":37153,"name":"Zoë Kravitz","photo":"/n0mhAgmY6eJQmA7kaugsTZEJgHo.jpg"},{"id":2954,"name":"Jeffrey Wright","photo":"/yGcuHGW4glqRpOPxgiCvjcren7F.jpg"},{"id":72466,"name":"Colin Farrell","photo":"/5FdalJbrbZ5UCsED5rFrXpvbqJa.jpg"},{"id":17142,"name":"Paul Dano","photo":"/idiW4qPI4wuP21CFARoRnES2qxC.jpg"},{"id":1241,"name":"John Turturro","photo":"/6O9W9cJW0kCqMzYeLupV9oH0ftn.jpg"},{"id":1333,"name":"Andy Serkis","photo":"/eNGqhebQ4cDssjVeNFrKtUvweV5.jpg"},{"id":133,"name":"Peter Sarsgaard","photo":"/5UANyM4co2nwYPgSEmGeNlZRm7V.jpg"}],"genres":["Krimi","Mystery","Thriller"],"id":414906,"original":"The Batman","overview":"Zwei Jahre lang jagte Bruce Wayne als Batman Verbrecher auf der Straße und geriet immer tiefer in die Schattenwelt Gothams. Im korrupten Netzwerk der Beamten und VIPs konnte er nur auf wenige Vertraute zählen, daher verkörperte er bald als Einziger die Rache der Bürger. Als ein Killer es mit einer Vielzahl an sadistischen Machenschaften auf die Elite Gothams abgesehen hat, führt eine Spur aus mysteriösen Hinweisen den weltbesten Detective in die Unterwelt, wo er auf Selina Kyle a.k.a. Catwoman, Oswald Cobblepot a.k.a. der Pinguin, Carmine Falcone und Edward Nashton a.k.a. der Riddler stößt. Mit der Zeit wird das wahre Ausmaß des verbrecherischen Plans klar und die Beweise deuten immer mehr auf einen Kriminellen im näheren Umfeld Batmans hin. Nun muss Batman neue Kontakte knüpfen, den Verbrecher entlarven und den Machtmissbrauch und die Korruption, die Gotham schon lange im Griff haben, gnadenlos niederschlagen.","poster":"/6zm78OqO4jWCpuaZ7q6Mb5j1beM.jpg","runtime":176.0,"title":"The Batman","type":"movie","va":7.7,"vc":12886,"year":"2022"},"movie:418047":{"cast":[{"id":221787,"name":"Jim Al-Khalili","photo":"/iF8MyKj0ApdoTMAmwLgeJqUGYBa.jpg"}],"genres":["Dokumentarfilm"],"id":418047,"original":"The Secret Life of Chaos","overview":"","poster":"/9wzBuTuxUmgxdZ37WQ4oWeISqY8.jpg","runtime":60.0,"title":"The Secret Life of Chaos","type":"movie","va":7.1,"vc":27,"year":"2010"},"movie:424408":{"cast":[{"id":1704271,"name":"Miguel Altieri","photo":""},{"id":1704272,"name":"Eshel Ben-Jacob","photo":""},{"id":1704273,"name":"Jamie Boyd","photo":""},{"id":1704274,"name":"John Calverly","photo":""},{"id":1704275,"name":"Han-Kyu Cho","photo":""},{"id":1704276,"name":"Geoffrey Donovan","photo":""},{"id":1704277,"name":"Robert Ferretti","photo":""},{"id":1704278,"name":"Connor Garrett","photo":""}],"genres":["Dokumentarfilm"],"id":424408,"original":"In Search of Balance","overview":"","poster":"/yjDf7K47YSEzeF0EVcJnRoizP92.jpg","runtime":74.0,"title":"In Search of Balance","type":"movie","va":7.2,"vc":9,"year":"2016"},"movie:4587":{"cast":[{"id":38225,"name":"Cher","photo":"/yDglV70XMu2cBWZigp5Jxd4etfv.jpg"},{"id":382,"name":"Bob Hoskins","photo":"/qOeE7bVHAsNTbP77Qk6TwrrWHZc.jpg"},{"id":1920,"name":"Winona Ryder","photo":"/8RVrlgtua8b53wmK7oZAAkm0N5O.jpg"},{"id":140777,"name":"Michael Schoeffling","photo":"/sTsceqPYxcxGbtNEF65oerKVHvn.jpg"},{"id":6886,"name":"Christina Ricci","photo":"/m2cY5Er1loPgHkZYdFMEz6YeiwG.jpg"},{"id":38226,"name":"Caroline McWilliams","photo":"/9ZTyhQD0aXXxQHTKbx3ID4oCKSA.jpg"},{"id":162287,"name":"Jan Miner","photo":"/erffIl6A5DrKKBKc3m463D4DcF9.jpg"},{"id":39040,"name":"Betsy Townsend","photo":""}],"genres":["Komödie","Drama","Liebesfilm"],"id":4587,"original":"Mermaids","overview":"Die attraktive Mrs. Flax ist alles andere als seßhaft. Wann immer eine ihrer Romanzen in die Brüche geht, zieht sie in eine neue Stadt. Bislang 18 mal. Die Töchter reagieren äußerst eigenwillig auf ihre unstete Mutter. Die 15jährige Charlotte sucht Zuflucht im katholischen Glauben. Ihre kleine Schwester Kate ist eine besessene Schwimmerin. Neueste Bleibe der Familie Flax ist eine kleine Stadt in New England. Kaum angekommen, stürzt sich Mama sogleich in ein Abenteuer mit dem liebestrunkenen Schuhverkäufer des Ortes. Doch auch die ernste, streng gläubige Charlotte erfährt schon bald, jenseits aller Gebete, irdische Zuwendung...","poster":"/hVByHaNjxmF1vI6i5vcPT5SYmE1.jpg","runtime":110.0,"title":"Meerjungfrauen küssen besser","type":"movie","va":6.7,"vc":635,"year":"1990"},"movie:482321":{"cast":[{"id":1774679,"name":"Jack Dylan Grazer","photo":"/lSE2LLt1ZEVf2n1X2CycTl0ehyV.jpg"},{"id":58225,"name":"Zach Galifianakis","photo":"/qsDfoUlRnXHUiqZeBPWHzmgmKGX.jpg"},{"id":27105,"name":"Ed Helms","photo":"/gPZ8tZaNQGAc3KZRIPp9rgGbEnN.jpg"},{"id":39187,"name":"Olivia Colman","photo":"/lawJUdbLb1YW0niaYjiVGR9IBG8.jpg"},{"id":1091324,"name":"Rob Delaney","photo":"/xirfT1znRkkughLiPemKu3NhkKQ.jpg"},{"id":1029934,"name":"Justice Smith","photo":"/htJrcOzYkLVcnF4ExT4O1bDN5e5.jpg"},{"id":2309874,"name":"Kylie Cantrall","photo":"/wLEvYdLjfWn7LzxBYHMGgCSs7jV.jpg"},{"id":1634120,"name":"Ricardo Hurtado","photo":"/jz8uatjwVN3lV1R0VqsPQLEclT9.jpg"}],"genres":["Animation","Science Fiction","Familie","Komödie"],"id":482321,"original":"Ron's Gone Wrong","overview":"Barney fühlte sich als Teenager noch nie wohl im Umgang mit Gleichaltrigen. Umso erfreuter war er von der Meldung, dass es fortan für jedes Kind einen B-Bot geben soll. Der kleine rundliche Roboter soll nicht nur die fortschrittlichste Maschine der Welt sein, sondern zugleich zum besten Freund für die Kinder werden. Dumm nur, dass Barneys Roboter mit Namen Ron bereits beim Hochfahren einige Defekte aufzeigt. Ron läuft schief und müsste, so denkt man, eigentlich sofort umgetauscht werden. Doch lässt sich ein neuer bester Freund so einfach ersetzen? Für Barney und Ron beginnt ein kurioses Abenteuer in der beide über die Wirrungen von wahrer Freundschaft noch einiges lernen werden.","poster":"/x6IJu1zILeR6mxSdejIhAQg62ib.jpg","runtime":107.0,"title":"Ron läuft schief","type":"movie","va":7.8,"vc":2111,"year":"2021"},"movie:499974":{"cast":[{"id":1964533,"name":"Suivai Pilisipi Autagavaia","photo":"/fVCb1PX0s5eOpybtjAXwrPfjlDB.jpg"},{"id":1964534,"name":"Haanz Fa'avae-Jackson","photo":"/xxetXALhsX4LLqDabL3W3RPGLVl.jpg"},{"id":1964535,"name":"Yvonne Maea-Brown","photo":""},{"id":1964536,"name":"Lafitaga Mafaufau","photo":""},{"id":1964537,"name":"Thierry Martel","photo":"/gPEwz13hyN4GIn0pnvzfElLM86U.jpg"},{"id":1964538,"name":"Daya Sao-Mafiti","photo":""},{"id":1964539,"name":"Anna-Maree Thomas","photo":"/nF5cyvCS4qRDokRyoP07yrqIPt3.jpg"}],"genres":["Komödie","Drama"],"id":499974,"original":"Hibiscus & Ruthless","overview":"","poster":"/6oUZ04Cd3D1h7sbLTDOItcRYMID.jpg","runtime":97.0,"title":"Hibiscus & Ruthless","type":"movie","va":5.0,"vc":5,"year":"2018"},"movie:619635":{"cast":[{"id":1687059,"name":"Davis Schulz","photo":""},{"id":1109767,"name":"Michael Krug","photo":"/9USEKgJJ6t8wcl1qJMy32fl2n93.jpg"},{"id":1375050,"name":"David Brückner","photo":"/zA9bTpZHSJsyo8Ms2o6zeRDRUrI.jpg"},{"id":2375463,"name":"Michael von der Brelie","photo":""},{"id":2375465,"name":"Tabea Georgiamo","photo":"/f698n9OuXuWAG4iWSL8yUQiHUNF.jpg"},{"id":2375467,"name":"Sophie Swan","photo":"/3gLufANmZdnTjLj1Z8L2A9gqfUX.jpg"},{"id":1871831,"name":"Olivia Dean","photo":"/ugJypYzYiSiE60cLw4R1TnCkjIO.jpg"},{"id":2375481,"name":"Hartmut Engel","photo":""}],"genres":["Horror","Mystery","Thriller"],"id":619635,"original":"Rapunzels Fluch","overview":"Im Jahre 1697 schlug ein Exorzismus an dem jungen  französischen Mädchen Rapunzel Gothel in Deutschland fehl.  Das Mädchen wurde dabei getötet, doch der Dämon lebte weiter  im Schloss des den Exorzismus ausführenden Paters  Petrosinus, welcher das Gebäude kurz darauf verkaufte.  Jahrhunderte später betritt eine der letzten Verwandten des  Paters das Schloss. Alina Grimm und ihre Freunde wollen  ihren studentischen Abschlussfilm, einen Horrorfilm, in dem  Schloss drehen. Nichts ahnend, dass ihre Anwesenheit den  Dämon von Rapunzel Gothel wieder heraufbeschwört,  durchstreifen sie das Schloss, um Testaufnahmen für ihr  Projekt zu machen. Doch der Dämon will Rache... und wenn er  schon nicht den Pater bekommt, dann wenigstens eine  Verwandte des gleichen Blutes.","poster":"/bBjPojWcHDftxNH0PTD8vpw08wj.jpg","runtime":80.0,"title":"Rapunzels Fluch","type":"movie","va":5.2,"vc":7,"year":"2020"},"movie:648361":{"cast":[{"id":1003249,"name":"Sven Ruygrok","photo":""},{"id":133669,"name":"D. David Morin","photo":"/lxyNfFFALU3JgKuArh55VgwrTTS.jpg"},{"id":123526,"name":"Sonny Liston","photo":"/aHYGR3Zmr73WFH42EZHlSp8v3Sz.jpg"},{"id":80757,"name":"Mike Tyson","photo":"/7eI1WK9985q8XiUgg3rDjOwa3MR.jpg"},{"id":3249989,"name":"Jerry