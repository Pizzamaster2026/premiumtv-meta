pg"}],"genres":["Horror","Thriller"],"id":1418657,"original":"The Yeti","overview":"1947 verschwinden der Öl-Magnat Merriell Sunday Sr. (Corbin Bernsen) und der Abenteurer Hollis Bannister (William Sadler) während einer Expedition in Alaska. Daraufhin begeben sich Bannisters Tochter Ellie (Brittany Allen) und Sundays Sohn Merriell Jr. (Eric Nelsen) mit einem Team von Spezialisten auf eine Rettungsmission in die eisige Wildnis. Zwischen hohen Gletschern und verschneiten Wäldern werden sie jedoch bald von einem riesigen, affenähnlichen Monstrum angegriffen und nach und nach dezimiert – dem leibhaftigen, mythenumwitterten Yeti, der seine Beute gnadenlos durch die arktische Finsternis jagt.","poster":"/zaqEfoKcWkVni2eONhJ7DRhMO8Q.jpg","runtime":93.0,"title":"The Yeti","type":"movie","va":5.9,"vc":85,"year":"2026"},"movie:1704846":{"cast":[{"id":4281713,"name":"Alex Murdaugh","photo":""},{"id":6457610,"name":"Craig Moyer","photo":""},{"id":945907,"name":"Lester Holt","photo":"/x8uipNVcxFKqJdKPuxJKH0ByknB.jpg"},{"id":1232737,"name":"Norah O'Donnell","photo":"/4e2yjO6UsgwaY1R5BzHKwtwP2wa.jpg"},{"id":38361,"name":"David Muir","photo":"/cfPYD71ByMkqW7XJIsb47xG7yRz.jpg"},{"id":1596937,"name":"Dana Bash","photo":"/vGCWaLWeKvwv14G9UUd1w7VrvDo.jpg"},{"id":6457618,"name":"Joe McCulloch","photo":""},{"id":6457623,"name":"Myra Crosby","photo":""}],"genres":["Dokumentarfilm"],"id":1704846,"original":"Instadocs: Alex Murdaugh, Unconvicted","overview":"","poster":"/3hhrFvWvcH6k11j7ZXS2c749Ywp.jpg","runtime":31.0,"title":"Instadocs - Der Fall Alex Murdaugh","type":"movie","va":6.8,"vc":12,"year":"2026"},"movie:1722860":{"cast":[{"id":86018,"name":"Manoj Joshi","photo":"/u7GllU8dO2bkAvRC0i8yszogYqY.jpg"},{"id":1568078,"name":"Arpit Ranka","photo":"/z0bF9XeHdJW67DgKQYrcWE2JM2c.jpg"},{"id":4360025,"name":"Bhushan Pradhan","photo":""},{"id":3001858,"name":"Spandana Palli","photo":"/gcKUmuROkK7OFij44xBGuIduFUa.jpg"},{"id":4195274,"name":"Tripti Sahu","photo":"/lTG8iRsQ08rYhY3UkoJ8rplpo7i.jp