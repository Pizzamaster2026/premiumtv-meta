:"/lbE8z4Aw9NTG8ZTzMEQjWdEBCK0.jpg"},{"id":21356,"name":"D. B. Woodside","photo":"/xdyGewr108rQWojpYlKw2QjrxCz.jpg"},{"id":2680806,"name":"Scott Swope","photo":"/p8layN9F0PUtSinpUc7ZMwAccFs.jpg"},{"id":5301158,"name":"Maurice Alpharicio","photo":""},{"id":1590269,"name":"Dominique Toney","photo":"/y780LXIDfFQUFo94uHJ945TstLo.jpg"},{"id":4375542,"name":"Greg Mathis Jr.","photo":""},{"id":5301161,"name":"David Hammond","photo":""}],"genres":["Drama"],"id":1431464,"original":"Fighting to Be Me: The Dwen Curry Story","overview":"","poster":"/fAduA9axr9dhciXdk00yjffAibR.jpg","runtime":117.0,"title":"Fighting to Be Me: The Dwen Curry Story","type":"movie","va":8.0,"vc":3,"year":"2025"},"movie:1545859":{"cast":[{"id":3724001,"name":"Mircea Popa","photo":"/rSzlRo5D9BoVYAIPiz1vRsXVKZc.jpg"},{"id":3867898,"name":"Oana Zara","photo":"/aLLoATtcyQncqFT2lUpNoP6ybvK.jpg"},{"id":3724006,"name":"Elena Moldovan","photo":"/m1mlqqlqpE8MWMGvJPARbo9RJND.jpg"},{"id":3724004,"name":"Adrian Cucu","photo":"/85v6egYiGzCki5eqFGZ27dFWFrk.jpg"},{"id":4997990,"name":"Bogdan Bob Radulescu","photo":"/4TkEkbudXXfCZ6n2doKC08YV5U5.jpg"},{"id":2514719,"name":"Costel Bojog","photo":"/da5UNbj5GPnuELU09LIHCBJr4De.jpg"}],"genres":["Komödie"],"id":1545859,"original":"Vecina","overview":"","poster":"/ei0DvzKK1izu4yxlNpVWGYnm3E1.jpg","runtime":89.0,"title":"Vecina","type":"movie","va":6.8,"vc":23,"year":"2025"},"movie:15588":{"cast":[{"id":56024,"name":"Jean Dujardin","photo":"/iPtSWWoO8vajj6fIUQLQeuGOCsk.jpg"},{"id":78425,"name":"Louise Monot","photo":"/jsPGwiU4QnAhkVugKFUi9pSTD5r.jpg"},{"id":1146860,"name":"Alex Lutz","photo":"/rrZcNAIOrTOLFLZqmpi1enF57Lp.jpg"},{"id":583687,"name":"Reem Kherici","photo":"/nfOOJB41gb0aFrPxfyF3u3i4HZn.jpg"},{"id":5266,"name":"Rüdiger Vogler","photo":"/8q5HOiqdWC2Y23IHjnOnsTeUBX8.jpg"},{"id":583686,"name":"Pierre Bellemare","photo":"/4erDwVH6IgGHjRTJWgAFLTid5pk.jpg"},{"id":131404,"name":"Ken Samuels","photo":"/w2tZD7Jkcg2UznuPxsVGn7rul4t.jpg"},{"id":54274,"name":"Serge Hazanavicius","photo":"/sEAptpSaByeYh4qupKkKPqRN3XZ.jpg"}],"genres":["Krimi","Action","Komödie"],"id":15588,"original":"OSS 117 : Rio ne répond plus","overview":"Nach dem Zweiten Weltkrieg sind nicht nur einige hochrangige Nazis in Südamerika untergetaucht, sie haben auch belastendes Material aus der Zeit der Okkupation mitgehen lassen. So auch der ehemalige SS-Offizier Von Zimmel, der sich nach Brasilien abgesetzt hat und eine Liste mit Namen französischer Kollaborateure mit sich führt. Diese möchte er nun dem französischen Staat verkaufen und OSS 117 soll nun nach Rio fliegen, um die Geldübergabe durchzuführen. Doch auch in Südamerika ist Frankreichs Antwort auf James Bond nicht sicher, haben doch noch ganz andere Geheimdienste ihre Finger im Spiel und zu allem Überfluss bekommt OSS 117 auch noch die israelische Agentin Dolorès an seine Seite gestellt. Mit seiner bekannt liebenswürdigen Art hat er auch schnell das Herz seiner Partnerin erobert und kann sich nun ganz mit den Gepflogenheiten der Hippie-Kultur, hungrigen Krokodilen und machtsüchtigen Alt-Nazis auseinandersetzen...","poster":"/gGdUV7aU5OMc4f7FcuFWWXA0Xpf.jpg","runtime":101.0,"title":"OSS 117 - Er selbst ist sich genug","type":"movie","va":7.1,"vc":1585,"year":"2009"},"movie:17968":{"cast":[{"id":84819,"name":"Pim Wessels","photo":"/9YiXVrOI9hzKlMPlYVAEF8oidzW.jpg"},{"id":84820,"name":"Martijn Hendrickx","photo":""},{"id":84821,"name":"Billy Zomerdijk","photo":""},{"id":84823,"name":"Reena Giasi","photo":""},{"id":84824,"name":"Peter Tuinman","photo":"/sr7GoYcunb09joBwdcXSMb2ngZ.jpg"},{"id":84825,"name":"Sanneke Bos","photo":"/q6nTmhd4On54hthFfscGAnZ80UM.jpg"},{"id":84638,"name":"Cees Geel","photo":"/clLwUanbbYrEWOm10lG254Muxgu.jpg"},{"id":27831,"name":"Thomas Acda","photo":"/12ZKfJv3FGCxEnLWpvf9PetbgeO.jpg"}],"genres":["Abenteuer","Historie"],"id":17968,"original":"De Scheepsjongens van Bontekoe","overview":"Niederlande, 17. Jahrhundert: Der 14-jährige Hajo träumt von der großen See! Er möchte einmal ein so tapferer Matrose werden wie sein einst auf hoher See verunglückter Vater. Noch weiß er nicht, dass ein großes unvergessliches Abenteuer auf ihn wartet! So wie das Schicksal es will, heuert er ausgerechnet auf der \"Nieuw-Horn\" an, dem Schiff des legendären Kapitän Bontekoe, das in Richtung Ostindien in See sticht. An Bord lernt Hajo die gleichaltrigen Schiffsjungen Padde und Rolf kennen, worauf die drei den Widrigkeiten an Bord fortan gemeinsam trotzen.","poster":"/qQD4dvV0pOenm0JuALWlanZyTp8.jpg","runtime":132.0,"title":"Die Abenteuer von Kapitän Bontekoes Schiffsjungen - Der Fluch der Gezeiten","type":"movie","va":6.2,"vc":19,"year":"2007"},"movie:25969":{"cast":[{"id":175630,"name":"Charlie Talbert","photo":"/4OHHVt0BtpfSYcOTbQTejplFEtD.jpg"},{"id":8534,"name":"Kathy Bates","photo":"/3MsayDvY73uXGVbCFHyy1ABTacV.jpg"},{"id":26999,"name":"Chris Owen","photo":"/lbpz1BSNahnkyE7FZ1tWcIy35w0.jpg"},{"id":19210,"name":"James Van Der Beek","photo":"/romoF6aNi4v9UcUqRSElfeDvBuJ.jpg"},{"id":233298,"name":"Robert Curtis Brown","photo":"/rbMhXK1U9zZXcPHQKAoJ677qeak.jpg"},{"id":862,"name":"George C. Scott","photo":"/iZON8v2ExgNzY943W0UDWXeRZrz.jpg"},{"id":16666,"name":"Kevin Connolly","photo":"/1QDmx5t0anO0wkfABfgLtkuLFOy.jpg"},{"id":3908,"name":"Tony Denman","photo":"/pHflMRqifW6jfmZ5MEwlX4Zun29.jpg"}],"genres":["Komödie","Drama","Familie","Liebesfilm"],"id":25969,"original":"Angus","overview":"Obwohl der übergewichtige Teenager Angus ein guter Schüler ist und auch auf dem Football-Feld eine gute Figur macht, ist er das Gespött seiner Highschool und muß täglich die Gemeinheiten seiner Mitschüler hinnehmen. Das schlimmste für Angus ist allerdings, daß er sich unsterblich in das begehrteste Mädchen der Schule Melissa verliebt hat. Die hat jedoch noch nie Notiz von ihm genommen und ist auch noch die Freundin von seinem verhaßten Erzrivalen, dem Mädchenschwarm und Quarterback des Football-Teams Rick.  Durch einen Trick werden Angus und Melissa zum Königspaar des anstehenden Winterballs gewählt, bei welchem Rick und seine Clique Angus bis auf die Knochen blamieren wollen...","poster":"/x1Py4TB8Y0Wx9IZ62derpSDqwjd.jpg","runtime":87.0,"title":"Angus - voll cool","type":"movie","va":6.6,"vc":100,"year":"1995"},"movie:30299":{"cast":[{"id":56442,"name":"Gene Barry","photo":"/mID3v17GuVINVL96gWM0rlxdzd0.jpg"},{"id":91640,"name":"Valerie French","photo":"/iArvTrU0bGeMSgm34mtQl23Wxfe.jpg"},{"id":5254,"name":"Jiří Voskovec","photo":"/nxW7pLtG8xLo4J3QHXzLxt8fd8P.jpg"},{"id":106006,"name":"Azemat Janti","photo":"/6yCEWBH9dRmoErql5OFkv9w6qT7.jpg"},{"id":87457,"name":"Stefan Schnabel","photo":"/aCXaxUC2uTJO1Rb0Lak7qVS5S7O.jpg"},{"id":91971,"name":"Friedrich von Ledebur","photo":"/bBRaajqzljFK8PYsaiY2rEnvOYq.jpg"},{"id":106005,"name":"Ralph Clanton","photo":"/pTwRLszCuLcc2iqO8oPJQUd72dT.jpg"},{"id":15676,"name":"Arnold Moss","photo":"/qwtc2O8JZ2OM13NS8Fi5LIV4Ily.jpg"}],"genres":["Science Fiction"],"id":30299,"original":"The 27th Day","overview":"Als eine Gruppe von Menschen aus aller Welt von einem Außerirdischen entführt wird, ahnt niemand der Auserwählten, welche Folgen das haben wird. Der Fremde aus dem All ist Vertreter einer Gemeinschaft, deren Heimatplanet dem Untergang geweiht ist. Aus ethischen Gründen nicht zu einer Invasion fähig, statten die Außeririschen die Entführten mit einer Superwaffe aus, in der Erwartung, dass sich die Menschheit selbst vernichtet. Nach 27 Tagen wird die Waffe nutzlos und die Fremden sind dem Untergang geweiht. Damit der Plan funktioniert, wird jedoch die Identität der Auserwählten bekannt gemacht, die nun Gefahr laufen, zum Spielball der Großmächte zu werden.","poster":"/406Bbeu15c9ikaHMr0vMQO96g3l.jpg","runtime":75.0,"title":"Der 27. Tag","type":"movie","va":6.2,"vc":41,"year":"1957"},"movie:35689":{"cast":[{"id":19159,"name":"Thomas Haden Church","photo":"/74NK9HCYvNafMggSp1PAK5Nwkpe.jpg"},{"id":1951,"name":"Elisabeth Shue","photo":"/1pmjDSLvOuqKW1P2KRPlpFMeUFe.jpg"},{"id":6832,"name":"Melissa Leo","photo":"/ueAIX0