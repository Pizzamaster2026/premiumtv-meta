HgdZAv39tj.jpg"},{"id":1205416,"name":"Christian Stavrakis","photo":"/1QgjSqpIyC5iBizxeSnceBECBAb.jpg"},{"id":1996506,"name":"Pat Jankiewicz","photo":"/hHp8GM4jAMTH9d8KHfTGcp9TEAF.jpg"},{"id":1198330,"name":"George Demick","photo":""},{"id":2058915,"name":"Michael McGee","photo":""}],"genres":["Dokumentarfilm"],"id":1019923,"original":"George A. Romero's Resident Evil","overview":"1998 engagierte der japanische Videospielkonzern Capcom Kultregisseur George A. Romero (1940-2017, „Die Nacht der lebenden Toten“), um einen Werbespot zur Veröffentlichung seines damals brandneuen „Resident Evil 2“ zu drehen. Der fertige Clip beeindruckte die Verantwortlichen des Hollywood-Studios Sony Pictures so sehr, dass sie Romero kontaktierten, damit dieser eine Realfilm-Adaption des ersten Videospiels anfertigen möge. Innerhalb von sechs Wochen schrieb Romero ein Drehbuch, das sehr nah an das Vorbild angelehnt war. Bis jetzt konnte nur darüber spekuliert werden, warum Sony und Capcom dieses Skript jedoch ablehnten. Der Dokumentarfilm von Brandon Salisbury versucht nun darzulegen, wie Romeros Vision für die Verfilmung des Gaming-Megahits „Resident Evil“ ausgesehen hätte und warum diese nie realisiert werden konnte.","poster":"/8E4WLQJYv7ycuqaJbmst76n9nQN.jpg","runtime":110.0,"title":"George A. Romero's Resident Evil","type":"movie","va":6.2,"vc":15,"year":"2025"},"movie:11001":{"cast":[{"id":78029,"name":"Martin Lawrence","photo":"/y3SQzIPUPJpdueb1DkbTYph68nk.jpg"},{"id":36422,"name":"Luke Wilson","photo":"/nH1h9dZGSBuWIOyX27HpYyYykvr.jpg"},{"id":4169,"name":"Dave Chappelle","photo":"/hDVe67wjmjtbOTzDrFaJfcobcE.jpg"},{"id":11803,"name":"Peter Greene","photo":"/n49XdJsMwNRdc4qT9XVAGb3fIQW.jpg"},{"id":74615,"name":"Nicole Ari Parker","photo":"/uy630vFQOKWpuEDFF2DuCQ1Oiez.jpg"},{"id":4520,"name":"William Forsythe","photo":"/g9lvl6Gz8Tbx4Uxd4FwFxJKpduY.jpg"},{"id":6110,"name":"Graham Beckel","photo":"/duFny0c11zVA37XG1bHFTNOCvRG.jpg"},{"id":20625,"name":"Robert Miranda","photo":"/3a2eqVbjiJd6FR3cYx0WBwy3SAp.jpg"}],"genres":["Action","Komödie","Krimi"],"id":11001,"original":"Blue Streak","overview":"Durch einen Juwelenraub kommt der Dieb Miles Logan in den Knast. Aber bevor er verhaftet wurde, konnte er einen Diamanten im Luftschacht einer Baustelle verstecken. Nach zwei Jahren Haftaufenthalt möchte sich Miles seine Beute abholen. Das wird nicht so einfach, denn auf dieser Baustelle ist eine Polizeistation entstanden. Miles hat zwei Möglichkeiten, um zu seiner Beute zu gelangen, entweder als Dieb oder als Polizist. Tatsächlich gelingt es dem findigen Gauner, sich in den Polizeidienst einzuschleusen. Gemeinsam mit seinem neuen Partner Carlson muss Logan nun auf Verbrecherjagd gehen, während er in ruhigen Momenten versucht, an den Edelstein zu gelangen. Aber er ist nicht der einzige, der ein Auge auf das wertvolle Stück geworfen hat. Ein alter Komplize will ihm die Beute streitig machen.","poster":"/vB0x0TOO0o73BDUER1WwhfvlJQT.jpg","runtime":93.0,"title":"Der Diamanten-Cop","type":"movie","va":6.5,"vc":1745,"year":"1999"},"movie:1108786":{"cast":[],"genres":["Drama"],"id":1108786,"original":"To A Moral Certainty","overview":"","poster":"/raz4U8EODAIiIV3jPZHMEg4u9Ny.jpg","runtime":34.0,"title":"To A Moral Certainty","type":"movie","va":6.0,"vc":1,"year":"2022"},"movie:111":{"cast":[{"id":1158,"name":"Al Pacino","photo":"/m8HAAjq1T75JypKk0v1FFQn4ysZ.jpg"},{"id":1159,"name":"Steven Bauer","photo":"/eMSeKPgfilE2v5VcmwSt5pxbp0x.jpg"},{"id":1160,"name":"Michelle Pfeiffer","photo":"/8qwNMFzmM3BxGKIj1iIqiHHBpx3.jpg"},{"id":1161,"name":"Mary Elizabeth Mastrantonio","photo":"/vbZ1E557K5oj34xLHR5ErO8wPCi.jpg"},{"id":1162,"name":"Robert Loggia","photo":"/mRSUgJnfprCNw83pyVfpfW7ryfK.jpg"},{"id":1163,"name":"Miriam Colon","photo":"/9jnz7htVMCTDNRDmoi2mdOKv6Pj.jpg"},{"id":1164,"name":"F. Murray Abraham","photo":"/p2RYVGdrcP0m70BkkiKcwyrDeim.jpg"},{"id":1165,"name":"Paul Shenar","photo":"/kc0I4h9fTY8WP3wyQbwVWEzbmil.jpg"}],"genres":["Action","Krimi","Drama"],"id":111,"original":"Scarface","overview":"1980 wandert der politisch verfolgte Kubaner Tony Montana nach Florida in den USA aus. Bald wird er seinem Job als Tellerwäscher überdrüssig und beteiligt sich an einem Kokainschmuggel. Der mächtige Drogenhändler Alejandro Sosa findet Gefallen an dem zielstrebigen Kubaner und integriert ihn in seine dunklen Machenschaften. Mit starkem Willen und kompromisslosem Handeln bahnt sich Tony Montana schnell den Weg an die Spitze. Als er jedoch dem Größenwahn verfällt, fühlt sich Sosa bedroht und möchte Montana beseitigen lassen.","poster":"/iQ5ztdjvteGeboxtmRdXEChJOHh.jpg","runtime":170.0,"title":"Scarface","type":"movie","va":8.2,"vc":13688,"year":"1983"},"movie:1137959":{"cast":[{"id":3003725,"name":"Jordee Kopanski","photo":""},{"id":3045814,"name":"Christian Klein","photo":""},{"id":4103680,"name":"Garrett McClenahan","photo":""},{"id":2079740,"name":"Heather Cunningham","photo":""},{"id":1706192,"name":"Jake Hammond","photo":""},{"id":4103682,"name":"Isabelle McGilvray","photo":""}],"genres":[],"id":1137959,"original":"The Other Side of the Door","overview":"","poster":"/e1kQhxdQFz4RKzUl1JnRMB8Gyjq.jpg","runtime":7.0,"title":"The Other Side of the Door","type":"movie","va":0.0,"vc":0,"year":"2018"},"movie:1188405":{"cast":[{"id":4309527,"name":"Jacqueline Fuchs","photo":""},{"id":6104,"name":"Julian Sands","photo":"/8TYtEyKZle2B3cUYT7FBM9HJRtZ.jpg"},{"id":2048814,"name":"Jacelyn Parry","photo":"/bywhK4tB6O7b9VsCVNgtCejqOq8.jpg"},{"id":1803376,"name":"Nicolò Pasetti","photo":"/frDjCKXnuiVp3EnOYIIj2FNf3nI.jpg"},{"id":84263,"name":"Jun Ichikawa","photo":"/14I8xU8EbFstCKaxZ43fr7iLa6L.jpg"},{"id":1944193,"name":"Tim Pritchett","photo":"/qlnHsd3VQfwhCCSib8jP4Rs9FEN.jpg"},{"id":1431773,"name":"Lukas Loughran","photo":"/eOrJMtKarv5VYIIdL9r7loAut3u.jpg"},{"id":1405291,"name":"Adam Mišík","photo":"/byCSaerX7Kv5OUEmOlifQa0rANk.jpg"}],"genres":["Drama"],"id":1188405,"original":"Body Odyssey","overview":"Mona ist Bodybuilderin und ständig damit beschäftigt, ihren Körer auf Perfektion und Schönheit zu trimmen. Doch das ist ihr ganz eigenes Schönheitsideal. In den Augen anderer sieht Mona aus wie eine Frau von einem anderen Stern.","poster":"/ilXZX763moSPio3vsm9zqQ3yiUa.jpg","runtime":106.0,"title":"Body Odyssey","type":"movie","va":3.3,"vc":3,"year":"2023"},"movie:1296195":{"cast":[{"id":1798569,"name":"Olivier Giroud","photo":"/qqi8xS8o1j8fiwXrpR3KZhJAiKG.jpg"},{"id":19732,"name":"Didier Deschamps","photo":"/d2el7oK37NqekLWGBCUCNAUNP60.jpg"},{"id":4737827,"name":"Jennifer Giroud","photo":"/igjGLhBvSwVA53UVo2h3F9fwKki.jpg"},{"id":1066986,"name":"Zlatan Ibrahimović","photo":"/eMf30zie0PwlfRFjzObHTUHhcat.jpg"},{"id":1071619,"name":"Arsène Wenger","photo":"/ahrwgPVFGG7fLoAGOvT7g93bhWH.jpg"},{"id":545042,"name":"Frank Lampard","photo":"/5RmIWjs4ABqeVKiqTi0zBzmEc5J.jpg"},{"id":2519543,"name":"Hervé Mathoux","photo":"/6zhjzitXX4NtK5ijWC3p5AYTZa8.jpg"},{"id":4737828,"name":"Grégory Nowak","photo":""}],"genres":["Dokumentarfilm"],"id":1296195,"original":"Giroud","overview":"Olivier Giroud hat fast alles gewonnen: die Weltmeisterschaft, die Champions League, die Europa League, den FA Cup, die Serie A und die Ligue 1. Im Jahr 2022 wurde er zum besten Torschützen in der Geschichte der französischen Nationalmannschaft. Trotz seiner Erfolge wird er manchmal heftig kritisiert. Dieser mit Hindernissen gepflasterte Weg ist auch die Geschichte seines Lebens: Als Jüngster von vier Geschwistern, mit einem älteren Bruder, dem eine Karriere als Profifußballer sicher schien, und als junger Spieler, dessen Karriere nur langsam in Gang kam, hat Olivier Giroud alle Herausforderungen gemeinsam mit seiner Frau Jennifer und seinen vier Kindern gemeistert. Wie der heute 37-Jährige sagt: „Das trifft mich nicht, das gibt mir Kraft!“","poster":"/i3c5fFDK1Y75Wgz1jUbV08V0STr.jpg","runtime":0.0,"title":"Giroud","type":"movie","va":6.3,"vc":5,"year":"2024"},"movie:1325958":{"cast":[{"id":972356,"name":"Luke Bracey","photo":"/ot2h7IrXpC8XSnIZDS