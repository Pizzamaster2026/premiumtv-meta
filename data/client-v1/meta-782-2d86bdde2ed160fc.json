hb9D55VuKr5EYA1R.jpg"},{"id":1032396,"name":"Jens Andersen","photo":"/bXDxa6wmmgHXWPlEB6VXaOuid0l.jpg"},{"id":111786,"name":"Bengt C.W. Carlsson","photo":"/u8YrM44kw12KLRbAhxitEdJAZRw.jpg"},{"id":1811490,"name":"Eeva Putro","photo":"/jy1kjrGc6wZglry875Xv3qHjMkJ.jpg"},{"id":2760389,"name":"Oksana Kniazeva","photo":""}],"genres":["Horror","Thriller"],"id":718135,"original":"Breeder","overview":"Ein Experiment mit Biohacking, durchgeführt von Dr. Isabel Ruben (Signe Egholm Olsen), bringt ein junges Paar in eine gefährliche und desorientierende Situation: Als Mia (Sara Hjort Ditlevsen) auf dem PC ihres Mannes Thomas (Anders Heinreichsen) das Bild einer nackten gefesselten Frau findet, folgt sie ihm zum Geheimversteck von Dr. Ruben. Doch dort wird Mia selbst überwältigt und eingesperrt. Auf albtraumhafte Weise stellt das Experiment grundlegendes menschliches Verhalten in Frage. Wie weit werden wir gehen, um für immer jung zu bleiben?","poster":"/uZP8kMo1jvUqhuTgHc84Z5aVbKG.jpg","runtime":107.0,"title":"Breeder - Die Zucht","type":"movie","va":5.2,"vc":74,"year":"2020"},"movie:725867":{"cast":[{"id":121966,"name":"Titi Kamal","photo":"/ddHbNYjjmisE55CldqBedvf4sYQ.jpg"},{"id":1259062,"name":"Samuel Rizal","photo":"/uPdFOZ5cB4phUvp2AGPbBdlyRRI.jpg"},{"id":1352048,"name":"Marcella Zalianty","photo":"/hR7zkZOxwjMdmKQ5X0qy44KDM0G.jpg"},{"id":1832871,"name":"Dea Panendra","photo":"/yboY2KfBvAhJcBh2I5I41bAG9na.jpg"},{"id":5296213,"name":"Jason Bangun","photo":"/3FkPlk4iR5QRsySq4Xy45QVKz3F.jpg"},{"id":1455471,"name":"Otig Pakis","photo":"/jYzPDDu7fKN2p0y6tsaPqZzwmfL.jpg"},{"id":2124662,"name":"Pritt Timothy","photo":"/cgc0BBQAuL6tR4MwcK1HYIBkN0k.jpg"},{"id":1157712,"name":"Fuad Idris","photo":"/kxgoUFeX1ERJ6ENDYAFnPXzNgaz.jpg"}],"genres":["Horror"],"id":725867,"original":"Makmum 2","overview":"","poster":"/rhAlFq5LbNEG6YN60NXmWrFWnAr.jpg","runtime":92.0,"title":"Makmum 2","type":"movie","va":3.8,"vc":11,"year":"2021"},"movie:763380":{"cast":[{"id":3067154,"name":"Kimonti Carter","photo":""}],"genres":["Dokumentarfilm"],"id":763380,"original":"Since I Been Down","overview":"","poster":"/oQXv8wmIjKlZr23SvXX5zI98UZp.jpg","runtime":105.0,"title":"Since I Been Down","type":"movie","va":8.0,"vc":2,"year":"2020"},"movie:776791":{"cast":[{"id":1842856,"name":"David Lafontaine","photo":"/1jUM0Cj5DXMenTZfb2kMhmthzTK.jpg"},{"id":1832707,"name":"Eva Paris Cicinyte","photo":"/oZBgZTSFDpnOBB3sng6KQWBn5Uw.jpg"},{"id":2482346,"name":"Penny Eizenga","photo":"/Ag20rPoAfYhsndpfHt2SPsjGFlh.jpg"},{"id":37431,"name":"John Novak","photo":"/xh8EyWCDggvZkyAlNGsTvH6KarE.jpg"},{"id":1251968,"name":"Alex Spencer","photo":"/dbthJumLbtaPmgIKgbfXSpgwnjF.jpg"},{"id":1752167,"name":"Matthew Willson","photo":"/i4lUUaEl1dsLvJucdIcTbaA570S.jpg"},{"id":2668874,"name":"Paul Ebejer","photo":""},{"id":4702469,"name":"Jordon Ford","photo":""}],"genres":["Drama","Liebesfilm"],"id":776791,"original":"The Road Ahead","overview":"Gerade als Liam Griffon (David Lafontaine) beschlossen hat, seine leidenschaftslose Ehe mit Mia (Eva Paris Cicinyte) zu beenden, erhält diese eine schwere Krebsdiagnose. Ohne Behandlung hat sie nur noch wenige Monate zu leben. Aus Angst im Krankenhaus dahin zu siechen, entscheidet sich Mia jedoch gegen eine Therapie. Stattdessen überzeugt sie Liam davon, seinen Job zu kündigen und die verbleibende Zeit für einen gemeinsamen Roadtrip zu nutzen. Unterwegs entdecken die Beiden völlig unerwartet ihre Liebe zueinander wieder...","poster":"/ntxZ2qcep1P1sWi8RaH8gSy90z.jpg","runtime":100.0,"title":"The Road Ahead","type":"movie","va":5.1,"vc":7,"year":"2020"},"movie:800089":{"cast":[{"id":65717,"name":"Jon Hamm","photo":"/mrXE5fZbEDPc7BEE5G21J6qrwzi.jpg"},{"id":56323,"name":"Tina Fey","photo":"/yPTAi1iucXf85UpiFPtyiTSM6do.jpg"},{"id":2066217,"name":"Micah Stock","photo":"/vjSEK5zUAxodogOBRNj8bPN0q2n.jpg"},{"id":1509615,"name":"Nick Mohammed","photo":"/2cFSHotCLLauzqq8iDKWK6meRAY.jpg"},{"id":1370986,"name":"Happy Anderson","photo":"/xdkUre1Yr9F0B40tFhhwbCJoE7c.jpg"},{"id":131871,"name":"Louisa Krause","photo":"/xkIx3PWJUumeUjOa2b3GPdMHp46.jpg"},{"id":1488952,"name":"Mary Holland","photo":"/iwEK2fIrU1q7aijjD8FI9hCUMEL.jpg"},{"id":76539,"name":"Derek Basco","photo":"/tLosl17sH5rzH5l3K301apAOMIr.jpg"}],"genres":["Mystery","Komödie"],"id":800089,"original":"Maggie Moore(s)","overview":"Jordan Sanders (Jon Hamm) hat als Polizeichef in seinem staubigen US-Wüstenkaff eigentlich so gut wie nie etwas zu tun. Hier eine Kneipenschlägerei, dort ein Diebstahl – mehr passiert nicht. Das ändert sich jedoch, als innerhalb kürzester Zeit gleich zwei Frauenleichen auftauchen. Seltsam dabei: die beiden Ermordeten hatten denselben Namen: Maggie Moore! Nur ein Zufall – oder steckt mehr dahinter? Die Ermittlungen Jordans und seines Cop-Partners Reddy (Nick Mohammed) führen zunächst zum Ehemann eines der Opfer, Andy Moore (Christopher Denham), Manager eines Fastfood-Diners mit massivem Hygieneproblem. Weiterhelfen könnten vor allem die Aussagen von dessen Nachbarin Rita (Tina Fey), aber auch ein aktionistischer, gehörloser Kleinkrimineller sowie weitere skurrile Gestalten haben ihren Platz in dieser kauzigen Krimikomödie.","poster":"/6LYWrDgVzAJj7d9w0Pth17X4hT2.jpg","runtime":99.0,"title":"Maggie Moore(s)","type":"movie","va":5.8,"vc":189,"year":"2023"},"movie:802366":{"cast":[],"genres":["Dokumentarfilm"],"id":802366,"original":"The Hunt For Planet B","overview":"Am 25. Dezember 2021 wurde das High-Stakes-Webb-Weltraumteleskops der NASA gestartet wurde. Diese Doku zeigt nicht nur die Entstehung dieser gewaltigen Maschine, sondern auch die Geschichte der verantwortlichen Wissenschaftler.","poster":"/yYPIxSYeKKYDiB6urnWL8JWrL8J.jpg","runtime":93.0,"title":"Die Suche nach Planet B","type":"movie","va":7.2,"vc":6,"year":"2021"},"movie:805051":{"cast":[{"id":3035227,"name":"Sema'j Alexander Cunningham","photo":""},{"id":3035228,"name":"Kya Stein","photo":""},{"id":3035230,"name":"Lily Held","photo":""},{"id":3028629,"name":"Tony Clark","photo":""},{"id":1