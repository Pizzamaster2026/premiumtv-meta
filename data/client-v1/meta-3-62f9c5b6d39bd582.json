7zolANGJ0BCyiZtcX.jpg"}],"genres":["Thriller","Drama"],"id":331885,"original":"Walhalla","overview":"","poster":"/gvrFh5CkAvttbCSyvduLZRvPUNt.jpg","runtime":90.0,"title":"Walhalla","type":"movie","va":4.0,"vc":3,"year":"1995"},"movie:340030":{"cast":[{"id":1270111,"name":"Jonathan Howard","photo":"/a02kAZBDWaFEnoN31oNsGsRtBv2.jpg"},{"id":142694,"name":"Jonathan Demurger","photo":"/vFen5Y5KXSH9m5f1UcTH1HhcHYB.jpg"},{"id":144760,"name":"Fanny Valette","photo":"/iNoFtpQ9dzSP7w4eNcP3EB89X1i.jpg"},{"id":88630,"name":"Jess Liaudin","photo":"/9YUopTXfT9HCQsGyXONwmqKFDz1.jpg"},{"id":1825304,"name":"Jean-François Lenogue","photo":"/sKD3pwIvg2lAKVcKFl59piZ027g.jpg"},{"id":5441,"name":"Édouard Montoute","photo":"/fWbTkHyL7ByGUuz8C77US8tuDNF.jpg"},{"id":1083559,"name":"Zakariya Gouram","photo":"/25LLQa7drEajgipYDr5P1ADPR5i.jpg"},{"id":1126301,"name":"Alix Bénézech","photo":"/fUz1bKAX3vxDwoa9sjsiwkGpwM6.jpg"}],"genres":["Thriller","Horror"],"id":340030,"original":"Night Fare","overview":"Luc (Jonathan Demurger) und Chris (Jonathan Howard) verbringen eine aufregende Nacht in Paris. Chris kommt aus Großbritannien und will das französische Nachtleben voll auskosten. Nach einer durgefeierten Nacht nehmen sie ein Taxi nach Hause – allerdings ohne Geld in den Taschen. Als sie endlich angekommen sind, rennen sie weg und lassen den Fahrer ohne Bezahlung stehen. Ein kleiner Streich, den sie schnell bereuen werden – schließlich versteht nicht jeder Taxiunternehmer Spaß. Egal wohin es Luc und Chris in dieser Nacht verschlägt: der mysteriöse Fahrer verfolgt sie auf Schritt und Tritt und hat mörderische Absichten. Die Pariser Straßen werden zum Set einer rasanten Hetzjagd, bei der es für die zwei Jugendlichen schnell um Leben und Tod geht. Eins ist sicher – sollten sie diese Nacht überleben, werden sie nie wieder die Zeche prellen…","poster":"/snljK4rCHwcEqiu5zEsYdFuiFda.jpg","runtime":80.0,"title":"Night Fare - Bezahl mit deinem Leben","type":"movie","va":5.1,"vc":77,"year":"2015"},"movie:403232":{"cast":[{"id":78335,"name":"Paul Sloan","photo":"/xv187orDP1MOO0aKp2LadhMI81T.jpg"},{"id":1437135,"name":"Jessica Uberuaga","photo":"/nl8oK1K2v1Lxaq0TIVuCDpLMiFy.jpg"},{"id":64856,"name":"Michael Jai White","photo":"/YPoHYuzR37wFpPpwEXZYQlhLln.jpg"},{"id":78811,"name":"Quinton 'Rampage' Jackson","photo":"/1FcZPbXNJRAUJTN2U6choOgaq51.jpg"},{"id":147,"name":"Michael Madsen","photo":"/fvr2EXEPrVwsF2JlfRp0Olbj4g8.jpg"},{"id":19302,"name":"Jason Mewes","photo":"/jVL4WC8NbJFL894Z2FBYY3XuHW5.jpg"},{"id":11160,"name":"Danny Trejo","photo":"/7JrUkRGBscZ1Hy5JinaaXjjzSCF.jpg"},{"id":1682245,"name":"Kevin L. Walker","photo":""}],"genres":["Action","Krimi","Thriller"],"id":403232,"original":"Vigilante Diaries","overview":"Sie nennen ihn Vigilante. Früher war er bei den Special Forces. Früher… Und jetzt hat er eine Mission. Er führt seinen persönlichen Kampf gegen Unrecht, Korruption und Drogen. Zusammen mit ein paar anderen Freunden ist er in der ganzen Welt unterwegs und macht mit seinen eigenen Gesetzen von Los Angeles bis in den Nahen Osten den Drogendealern und Gangstern das Leben schwer. Bis er bei einer Mission von seinen Feinden in die Falle gelockt wird. Seitdem hat man nichts mehr von ihm gesehen. Zehn Jahre später ist Vigilante immer noch verschwunden. Man findet heraus, dass er möglicherweise in Mexiko von einem Drogenkartell gefangen gehalten wird. Ohne Zögern beschließen seine engsten Freunde, ihn zu befreien und entwerfen einen genialen Plan. Angeführt von seinen Kumpels Wolfman und Kid startet das verrückte Team bis an die Zähne bewaffnet einen gnadenlosen Rachefeldzug…","poster":"/sDbOwy3oTNzB24r7ehhOdzwq10r.jpg","runtime":107.0,"title":"L.A. Outlaws - Die Gesetzlosen","type":"movie","va":4.2,"vc":64,"year":"2016"},"movie:421131":{"cast":[{"id":1503534,"name":"Elise Bauman","photo":"/lsItiN8M8XgOX2QyJ5vlidJ7iVf.jpg"},{"id":1503535,"name":"Natasha Negovanlis","photo":"/5o843BNtmFfeok7z8RAzwx0MeEp.jpg"},{"id":1565854,"name":"Annie Briggs","photo":"/gUmG7kVIGa3N0LmObmfrZKCHftz.jpg"},{"id":1565853,"name":"Kaitlyn Alexander","photo":"/xnB1lIpSoxCNvStrA34m9ljfXR7.jpg"},{"id":1635683,"name":"Nicole Stamp","photo":"/kWG861XpVFBNkHxxYuLDJMXQ3e1.jpg"},{"id":5939,"name":"Grace Lynn Kung","photo":"/4iJEk5nwNOQGLOmLOHizvw5rorM.jpg"},{"id":1197122,"name":"Cara Gee","photo":"/7CEwxz6S2JQBEPmwpB7Se1gXQAW.jpg"},{"id":1565855,"name":"Matt O'Connor","photo":"/661PHjJ6CWSuZz7QO7jdr5bzfOH.jpg"}],"genres":["Horror","Komödie","Liebesfilm"],"id":421131,"original":"The Carmilla Movie","overview":"Es sind nun genau fünf Jahre vergangen, seitdem Laura und Carmilla den Weltuntergang verhindert und überlebt haben. Carmilla, auferstanden von den blutsaugenden Untoten, gewöhnt sich allmählich an ihr wiedergewonnenes, herz-schlagendes Menschendasein, während Laura sich ganz ihren journalistischen Ambitionen und Social Media Projekten widmet. Doch plötzlich und unerwartet mehren sich Anzeichen dafür, daß sich Carmilla zurück in einen Vampir verwandelt, während Laura des nachts von seltsamen Albträumen geplagt wird. Gemeinsam mit ihren alten Freunden von der Silas Universität müssen sie dieser skurrilen Sache auf den Grund gehen - und ganz nebenbei vermutlich erneut die Welt vor dem Untergang retten.","poster":"/jL8FaFdMLoxCaXhZfPY4tFbXwe7.jpg","runtime":94.0,"title":"The Carmilla Movie","type":"movie","va":7.2,"vc":115,"year":"2017"},"movie:424402":{"cast":[{"id":55266,"name":"Catherine Mary Stewart","photo":"/vfqO0CmD7gkNwr8ErEm82F8bOqL.jpg"},{"id":112560,"name":"Quinton Aaron","photo":"/yoK8q52hZ0oTEpRHtZfByIA7sEd.jpg"},{"id":92808,"name":"Gabriel Jarret","photo":"/m353LQhbbxRcsECrcXkwX7uzKPg.jpg"},{"id":1197418,"name":"Nicole Fox","photo":"/19phvVGKZzK3gIvDeexEKDz7HUW.jpg"},{"id":168865,"name":"Krista Kalmus","photo":"/oJLWvuOffjnfl5Jpdbika1LwvTC.jpg"},{"id":76544,"name":"Chris Ashworth","photo":"/w7stKTRuDcFnT7Is5NrBfHIjwBn.jpg"},{"id":915692,"name":"Lisa Varga","photo":"/wu5kNf7IC8TQapOvM3stIeHKnjb.jpg"},{"id":76315,"name":"Tom Malloy","photo"