8E9zWcHhxPMLkk8H.jpg"},{"id":26283,"name":"Gerrit Graham","photo":"/itz1a5P3RxCt8BySFbMxKCQ5yeZ.jpg"},{"id":7665,"name":"Macdonald Carey","photo":"/o9lTQsuzEGimjjMGISKjppT4CxA.jpg"},{"id":57359,"name":"Neal Israel","photo":"/ta6GivAxCQotJz2eMpmD0zhVy40.jpg"},{"id":133585,"name":"Art Lund","photo":"/9UV3NOJq5lMt7gwxqADBcNBUhsY.jpg"}],"genres":["Horror"],"id":49684,"original":"It's Alive III: Island of the Alive","overview":"Mordgierige Monsterbabys werden auf einer einsamen Insel ausgesetzt. Steven Jarvis, Vater des ältesten Kindes, leidet unter seinem Ruf als \"Monstervater\". Als eine Regierungsexpedition nach 5 Jahren eines der Monster zurückholen will, werden alle Teilnehmer bis auf Jarvis getötet. Die inzwischen erwachsenen Monster fahren in die USA, um Jarvis' Frau ein Enkelkind zu übergeben. Jarvis überredet sie, das Kind anzunehmen, bevor die Polizei die Monster vernichtet. Jarvis, seine Frau und das Enkelkind stehlen sich unbemerkt davon.","poster":"/rmi6F3qtYnP0NdLiL0zkABtg1MY.jpg","runtime":91.0,"title":"Die Wiege des Schreckens","type":"movie","va":5.3,"vc":85,"year":"1987"},"movie:66997":{"cast":[{"id":5462,"name":"Pinto Colvig","photo":"/jslBLHuV1cOKsyx763CA1RqsrQU.jpg"},{"id":78077,"name":"Clarence Nash","photo":"/x2g2hbu4RRIcn6Q5RT8gpWR1FKV.jpg"},{"id":2106,"name":"Walt Disney","photo":"/xtnOuQtUHv2Pu0ryhsqGKpAPCmK.jpg"}],"genres":["Animation","Komödie"],"id":66997,"original":"Magician Mickey","overview":"Mickys Zaubervorstellung wird durch den im Publikum sitzenden Donald gestört, der Mickys Zauberkunst zu übertreffen versucht.","poster":"/2vyLRQWWDOxwTsEZTQL8FhF1ogT.jpg","runtime":7.0,"title":"Micky, der Zauberer","type":"movie","va":7.0,"vc":72,"year":"1937"},"movie:68339":{"cast":[{"id":21605,"name":"Dirk Bogarde","photo":"/f0S6MxxcYb367KtnXWTH8DoWHMt.jpg"},{"id":8238,"name":"Brenda De Banzie","photo":"/zG113jpcgT1z7R0n6b0bt9BQpLG.jpg"},{"id":3783,"name":"Brigitte Bardot","photo":"/vqYOnEZyA3AO7sx3SxIFWYrggQJ.jpg"},{"id":11130,"name":"James Robertson Justice","photo":"/u0fYhKndmqr99KGV6SOhjXuMOnX.jpg"},{"id":39952,"name":"Maurice Denham","photo":"/emSAhipSEjxZfAeymqlWHLvC5rT.jpg"},{"id":29307,"name":"Michael Medwin","photo":"/ta4gIRV6JnbT9CEH8XJDTdCJJeR.jpg"},{"id":153160,"name":"Hubert Gregg","photo":"/x46310DmFEAzVOu8vtLS5CYXfzG.jpg"},{"id":118427,"name":"James Kenney","photo":"/dG7Dco7SBcrBlpOncWfpJIDhkgg.jpg"}],"genres":["Komödie"],"id":68339,"original":"Doctor at Sea","overview":"Als der Landarzt Herbert Sperling in einer kompromittierenden Situation aufgefunden wird, muss er seinen Arbeitsplatz Hals über Kopf verlassen. Rettung in letzter Not findet er auf einem Schiff, wo er als Schiffsarzt anheuert. Auf dem Schiff stellt er schnell fest, dass er eigentlich überflüssig ist. Für die kleinen Wehwehchen geht die Crew lieber zu seinem Assistenten, der ein \\\"Wundermittel\\\" hat. Und der brummelige, strenge Kapitän des Schiffes, Kapitän Hogg, macht ihn seinen Start auch nicht leicht. Im Hafen werden - sehr zum Unmut des Kapitäns – zwei Passagiere an Bord genommen. Zum einen Muriel Mallet die Tochter des Schiffseigners, die dem Kapitän schöne Augen macht, und die junge, hübsche Tänzerin Helene Colbert . Zwischen ihr und Sperling beginnt eine Romanze, was der Kapitän überhaupt nicht duldet.","poster":"/phPAiLXPjmLV78uFz6Fhj9qYJvk.jpg","runtime":94.0,"title":"Doktor ahoi","type":"movie","va":5.8,"vc":26,"year":"1955"},"movie:78239":{"cast":[{"id":16214,"name":"Mario Van Peebles","photo":"/fiExKjVttfePRwmfVvMHPjC7F9n.jpg"},{"id":14326,"name":"Patsy Kensit","photo":"/r60KQk3xOmMIhGmJqCeHQq6RX68.jpg"},{"id":27422,"name":"Bruce Payne","photo":"/kj5J14Ayhrfv3Kz1JPuh1S636eY.jpg"},{"id":85154,"name":"Tony Denison","photo":"/yt3umgKk1UFRrrVJHhl92wX21RT.jpg"},{"id":37203,"name":"Jason Beghe","photo":"/hrTwOPWek7nkPJgFhh6inFu7vSS.jpg"},{"id":59449,"name":"Paula Marshall","photo":"/7jujYCDltWVQAGv4L6eHDs5wfxq.jpg"},{"id":194725,"name":"John Verea","photo":"/AksfbhlfmlJLGd4dhjTJqw4XchS.jpg"},{"id":14329,"name":"Dean Norris","photo":"/mKRrEbsxAX3ro700HsViFArRM7l.jpg"}],"genres":["Horror","Action","TV-Film","Krimi","Science Fiction"],"id":78239,"original":"Full Eclipse","overview":"Das Verbrechen läuft auf Hochtouren. Als Jim, der Partner von Max (Mario van Peebles), bei einer Razzia ums Leben kommt, geht Max wieder auf Streife. Seltsamerweise trifft er im Umkleideraum auf seinen scheinbar verstorbenen Partner mit dem etwas nicht stimmt. Als bei einem Einsatz Jim eigentlich tödliche Schussverletzungen erleidet, bestätigt sich Max' Vermutung. Max findet bald heraus dass eine seltsame Droge, für die Wiederbelebung von Jim verantwortlich ist. Welche von einer eigenartigen Gruppe verwendet wird, um Unsterblichkeit und animalische Kräfte zu erlangen...","poster":"/lCtgDrPfhdeIhqRanyAYVG59Ew7.jpg","runtime":93.0,"title":"Full Eclipse","type":"movie","va":5.1,"vc":55,"year":"1993"},"movie:86955":{"cast":[{"id":98568,"name":"Paul Robeson","photo":"/kwi1iyhlpvQ9GhxUto1vwwEdSc0.jpg"},{"id":1471707,"name":"Mercedes Gilbert","photo":"/2b1nl67wKJVxbhcuLNAp8YGcTs2.jpg"},{"id":2395942,"name":"Julia Theresa Russell","photo":"/eqKcMEFUGfyE22SYhf0t6aaXc8F.jpg"},{"id":1534164,"name":"Marshall Rogers","photo":"/9wWp5iEbMEZqoG0UlWabbbiohmT.jpg"},{"id":1279006,"name":"Lawrence Chenault","photo":"/vcNaTOgR0HnhA4W3KbC1PjxvFwy.jpg"},{"id":1534165,"name":"Chester A. Alexander","photo":"/8qQtd91zSLvYk8tQVKl9I1quY33.jpg"},{"id":1534166,"name":"Walter Henry Cornick","photo":"/m0bDfy4pQyCgEAcfsZVrmGh89g8.jpg"},{"id":5559605,"name":"Lillian Johnson","photo":"/1WChqsQdd4vyFRAVdQ1viN5BZsr.jpg"}],"genres":["Drama"],"id":86955,"original":"Body and Soul","overview":"","poster":"/3Xl7ZaNt1ThVCvsXZDW5ISXsP7K.jpg","runtime":94.0,"title":"Body and Soul","type":"movie","va":6.3,"vc":33,"year":"1925"},"movie:94831":{"cast":[{"id":40174,"name":"Lucille Ball","photo":"/gcJ5Qwg9lcadvdCxC22AjFuJC4A.jpg"},{"id":11998,"name":"Eddie Albert","photo":"/kYAYnVuU15SHkKf6CWTNzFV27Qx.jpg"},{"id":81180,"name":"Carl Benton Reid","photo":