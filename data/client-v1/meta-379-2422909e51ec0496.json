FTsNG8qTv.jpg"},{"id":108637,"name":"Nigel Stock","photo":"/rdZKlqJug1cZQqfSKv3zwhVdUD7.jpg"},{"id":3676,"name":"Wylie Watson","photo":"/m4GFdXopAxP2m2h2IHzk6iD0mur.jpg"},{"id":122951,"name":"Carol Marsh","photo":"/s6j3vkyHRrL9HrjnzmlBiYSvAOS.jpg"},{"id":12000,"name":"Harcourt Williams","photo":"/oAt2rpN9lvLNkVqo7Ez33dG6kXY.jpg"},{"id":1972231,"name":"Virginia Winter","photo":"/eS0VcGGmoI3QkR26AYy2vYfHHlB.jpg"}],"genres":["Krimi","Drama","Thriller"],"id":13385,"original":"Brighton Rock","overview":"Der skrupellose Kleinganove Pinkie treibt Schutzgelder auf der Pferderennbahn ein und geht dabei über Leichen. Als er seinen Rivalen Fred um die Ecke bringt, beginnen für ihn die Probleme. Der Mord wird zufällig von der Kellnerin Rose beobachtet und Freds Freundin Ida stellt auf eigene Faust Nachforschungen an. Um seine Spuren zu verwischen, bleibt Pinkie nur eine Möglichkeit: Er muss Rose zum Schweigen bringen.","poster":"/qUBEWe9gd9ZDNdDs2zWbvzSA1Xs.jpg","runtime":92.0,"title":"Brighton Rock","type":"movie","va":6.8,"vc":138,"year":"1948"},"movie:1561834":{"cast":[{"id":1255433,"name":"Öykü Karayel","photo":"/rzMUT2OMgnlsDLKUIdPDM0q2mgf.jpg"},{"id":1250945,"name":"Özcan Deniz","photo":"/1xugZDdp0vskwozHBSTCIFQPjCV.jpg"},{"id":98834,"name":"Nejat İşler","photo":"/xFhmBekB2odhRY335lJ6rWiIdyw.jpg"},{"id":2091979,"name":"Helin Kandemir","photo":"/9ivMPksoFlRaL1eKRTZu4mkScOQ.jpg"},{"id":1258448,"name":"Gonca Vuslateri","photo":"/wu2gvPyKKAGEVn1VX5WmHJ5szYI.jpg"},{"id":46070,"name":"Tilbe Saran","photo":"/ciN8qfqgII8T45jAAspqv722qXZ.jpg"},{"id":1603806,"name":"Özgür Emre Yıldırım","photo":"/pekejv4I94Hp1UbLq3G3ksf3jkB.jpg"},{"id":115008,"name":"Ceyda Düvenci","photo":"/1lmyMdhQCPuxo8gIjwLpZTUwEza.jpg"}],"genres":["Liebesfilm","Drama"],"id":1561834,"original":"Son Yemek","overview":"Die talentierte Pianistin Canan (Öykü Karayel) verliebt sich in den mysteriösen Agenten Bekir (Özcan Deniz), nachdem sie sein Leben rettet. Dann verschwindet er jedoch plötzlich. Als er Jahre später zurückkehrt, hat Canan bereits einen anderen Mann geheiratet, sie empfindet jedoch noch immer starke Gefühle für Bekir und muss sich nun zwischen den beiden entscheiden.","poster":"/5VhfAWFs005xxN9akWJ2VIF5ozJ.jpg","runtime":122.0,"title":"Ein unmöglicher Gefallen","type":"movie","va":9.3,"vc":3,"year":"2026"},"movie:26954":{"cast":[{"id":554043,"name":"Elizabeth Maclellan","photo":"/eR3rro435dTWEsB4tHSVnR6TXOH.jpg"},{"id":43753,"name":"Collin Bernsen","photo":"/ajmWBx0XUhXYD8guoOAsSn3wspq.jpg"},{"id":157968,"name":"Steve Welles","photo":"/iDqGocHnrAAZHsYr8UvzeBp7zwY.jpg"},{"id":194599,"name":"Greg Webb","photo":"/4jAi0fm734IEpgt5TA5Zk7OFPti.jpg"},{"id":147396,"name":"Charlie Spradling","photo":"/neqwIFjMXisftd8bhrCVXRneF8D.jpg"},{"id":93922,"name":"Jeff Celentano","photo":"/529TK0OU7AmosBtsqVrOV3cB5sg.jpg"},{"id":83436,"name":"Nita Talbot","photo":"/nktDWY3Bpz8u9ScqC2YOPRTzMjl.jpg"},{"id":1232170,"name":"Sage Allen","photo":"/jnWAAI2G2D4Bi6LtUtFFpA4YjSQ.jpg"}],"genres":["Horror"],"id":26954,"original":"Puppet Master II","overview":"Eine Gruppe von Parapsychologen macht sich in dem leerstehenden Hotel von Andre Toulon breit und entdeckt seltsame Unterlagen. Macht man sich auf die Suche nach dem Übersinnlichen. In Wirklichkeit stößt man aber auf die Todespuppen des Andre Toulon, die die Substanz des Lebens besitzen und ihren Meister aus dem Grab erwecken. Dieser braucht nun massenhaft Gehirnlappen, um mehr von dem Lebenselixier herzustellen. Die im Haus befindlichen Wissenschaftler machen bald Bekanntschaft mit einem Dämon.","poster":"/dy5tzZFWFTjbNyG4KNP6yMjZ6l9.jpg","runtime":88.0,"title":"Puppet Master II","type":"movie","va":6.0,"vc":230,"year":"1990"},"movie:29403":{"cast":[{"id":14974,"name":"Barbara Stanwyck","photo":"/xBfikc66lCnShogMZX1k9cV7H26.jpg"},{"id":82216,"name":"Robert Taylor","photo":"/1CDILPhiOQztlvZwsU55kKBspIV.jpg"},{"id":34624,"name":"Judi Meredith","photo":"/eyLmXEFkAQVch6NUtTqTYIWsdGu.jpg"},{"id":2777,"name":"Rochelle Hudson","photo":"/2Mi0CBL9pvzLnCBTnfekH0JizcM.jpg"},{"id":40623,"name":"Hayden Rorke","photo":"/8HuJziNroZGIv6NFZMO6baifZSP.jpg"},{"id":97257,"name":"Marjorie Bennett","photo":"/1lnpsdUkhE72p8ydn8PLbYv6cU8.jpg"},{"id":13399,"name":"Lloyd Bochner","photo":"/khch0Jh2N4XcyrmvczD6Eo61vAm.jpg"},{"id":81187,"name":"Jess Barker","photo":"/cDkbObt37tz07XjwTLH2wB2X1vV.jpg"}],"genres":["Thriller","Horror","Mystery"],"id":29403,"original":"The Night Walker","overview":"Der reiche und blinde Howard Trent glaubt, dass seine Frau Irene fremdgeht, da sie in der Nacht spricht und er so einiges erfährt. Er verdächtigt seinen Anwalt Barry Moreland, den er zu Unrecht zur Rede stellt. Als er am selben Abend auch noch seine Frau mit seiner Eifersucht vertreibt, stirbt er durch eine Explosion. Doch Irenes Träume werden immer abstruser, sie kann sich nicht vorstellen, dass sich das alles nur in ihrer Fantasie abspielt. Nach einer geträumten Hochzeit mit ihrem imaginärem Liebhaber offenbart sie sich Barry. Gemeinsam gehen sie dem nach und finden sogar die Kirche, die jedoch verlassen ist. Ist Irene wirklich wahnsinnig oder treibt jemand ein makaberes Spiel mit ihr?","poster":"/a3LHttZy6c0x2jqN07LyHvblZpE.jpg","runtime":86.0,"title":"Er kam nur nachts","type":"movie","va":6.4,"vc":54,"year":"1964"},"movie:297":{"cast":[{"id":287,"name":"Brad Pitt","photo":"/ajNaPmXVVMJFg9GWmu6MJzTaXdV.jpg"},{"id":4173,"name":"Anthony Hopkins","photo":"/iaf7SHSkGDpnyrDh1Jolilwk2TD.jpg"},{"id":4174,"name":"Claire Forlani","photo":"/e0Uk6QphxHZ9VTtxUT0ZkPgYWNs.jpg"},{"id":4177,"name":"Jake Weber","photo":"/z1RTh4qvyMFha8nKd5Uw1dKwkZz.jpg"},{"id":4726,"name":"Marcia Gay Harden","photo":"/5vxcHIHABJxqhweAsTiXVOhT4SE.jpg"},{"id":4175,"name":"Jeffrey Tambor","photo":"/e4IkxsEo5O4oUWrIpXlEhWa6lqB.jpg"},{"id":4192,"name":"David S. Howard","photo":""},{"id":4193,"name":"Lois Kelly-Miller","photo":"/vGVvQzu2PTD09mTgqmKGfZUmyT1.jpg"}],"genres":["Fantasy","Drama","Liebesfilm"],"id":297,"original":"Meet Joe Black","overview":"Als Joe Black sich nach der schönen Susan Parrish, einer Zufallsbekanntschaft, umdreht, übersieht er ein heranrasendes Auto. Tage später begegnet Susan ihm wieder. Da sie den Unfall nicht bemerkt hat, wundert sie sich, daß Joe sie nicht wiedererkennt. Doch das ist gar nicht möglich, denn Susan steht der Tod gegenüber - in Gestalt von Joe Black. Er ist gekommen, um ihren Vater in sein Reich zu holen. Susans Liebreiz bringt ihn davon allerdings schon bald ab - und eine einzigartige Romanze nimmt ihren Lauf...","poster":"/1xmFvEtVhh23Lx1X9c9k3IN26Sg.jpg","runtime":178.0,"title":"Rendezvous mit Joe Black","type":"movie","va":7.4,"vc":6050,"year":"1998"},"movie:29887":{"cast":[{"id":95624,"name":"Shirley Temple","photo":"/5jBfns8fqeFp5WrrmO6NZThpia2.jpg"},{"id":131618,"name":"James Dunn","photo":"/kDp98yuPJxvLuvX4ViOH8bItYkx.jpg"},{"id":8515,"name":"Jane Darwell","photo":"/xWTsj5z2N94OOnimMmUYewQXOIi.jpg"},{"id":143670,"name":"Judith Allen","photo":"/f5rn0HbZpYS6uKYpUajRHLvAtzh.jpg"},{"id":148836,"name":"Lois Wilson","photo":"/fSQS8avO1WLCdD8BfDuwEtLLsCa.jpg"},{"id":97995,"name":"Charles Sellon","photo":"/afTnl6HF8CV5SPjVniFDUMG8MtR.jpg"},{"id":120768,"name":"Walter Johnson","photo":"/IwWgXz2HvwJksY9yjruPGwtEJa.jpg"},{"id":18736,"name":"Jane Withers","photo":"/x7y0sortn3q8e6KpYojGIT5YKjp.jpg"}],"genres":["Drama","Familie","Musik"],"id":29887,"original":"Bright Eyes","overview":"","poster":"/jEEtxWvQWB9OXUzocGCLqquZYVs.jpg","runtime":83.0,"title":"Bright Eyes","type":"movie","va":6.7,"vc":30,"year":"1934"},"movie:37945":{"cast":[{"id":515,"name":"Glenn Close","photo":"/4VHZ1GfLwN7MUgApy0LCBzdDF9L.jpg"},{"id":2387,"name":"Patrick Stewart","photo":"/ufqtnLh3JJjPbEgxEag3MM5nZyv.jpg"},{"id":67206,"name":"Andrew Howard","photo":"/kba1JeCUYHufjB933G5xPRhO8lV.jpg"},{"id":56303,"name":"Konrád Antal","photo":""},{"id":28847,"name":"Rafe Spall","photo":"/zcqUqAvO7RQnitcCNNfTVPaiQtS.jpg"},{"id":65642,"name":"John Light","photo":"/9ilMEZ2l40gd2fyU2CvLmNVTjY.jpg"},{"id":1868898,"name":"Soma Marko","photo":""},{"id":1244,"name":"Jonathan Rhys Meyers","photo":"/3MvT0B15nt5JLp1dUcxmbqmjHUc.jpg"}],"genres":["Drama","Historie","TV-Film","Liebesfilm"],"id":37945,"original":"The Lion in Winter","overview":"England im frühen 12. Jahrhundert. König Henry II. ist der Streitereien müde und möchte die Thronfolge regeln. Also lässt er seine Frau Eleanor aus der Gefängniszelle holen, in der sie seit zehn Jahren sitzt, und lädt auch beide älteren Söhne, die sich einst unter Mutters Ägide gegen ihn verschworen, zur Weihnachtsfeier auf sein Schloss. Ebenfalls mit von der Partie ist der König von Frankreich, dessen Schwester Henry als Mätresse dient. So nehmen die Intrigen ihren unvermeidbaren Lauf...","poster":"/f6yEfCBBMNp6jdny9AD4ZTG9tgi.jpg","runtime":161.0,"title":"The Lion in Winter - Kampf um die Krone des Königs","type":"movie","va":5.9,"vc":32,"year":"2003"},"movie:41944":{"cast":[{"id":974,"name":"Dexter Fletcher","photo":"/gCmb47jus3aKjylqAIi3yEZA9jd.jpg"},{"id":3126,"name":"Ione Skye","photo":"/ye8qsi6fn51HW93c7065Jogbh9p.jpg"},{"id":378,"name":"Jonathan Pryce","photo":"/3nQ01F9WPNPzzLblY7XyaihT9JT.jpg"},{"id":13548,"name":"James Spader","photo":"/3gurW3OgDOD4hcqDfgcqUnoNg34.jpg"},{"id":104795,"name":"Bill Paterson","photo":"/mk5vpYLmER7asqOhEwVKXD3P3YE.jpg"},{"id":5658,"name":"Michael Gambon","photo":"/3jdWkDKf4IODbG4JKTeaC7AzxZH.jpg"},{"id":80366,"name":"Lesley Sharp","photo":"/uqYQG4HSRLrOSSQdNH7mFmS4Xjo.jpg"},{"id":15440,"name":"Jared Harris","photo":"/r9nIq0jPz1oBm4WwtlZhqlsX8p0.jpg"}],"genres":["Komödie","Liebesfilm"],"id":41944,"original":"The Rachel Papers","overview":"Charles ist noch keine 20, aber als Gigolo ein Vollprofi. In seiner Londoner Kellerwohnung hat er für jeden Mädchentyp ein passendes Frauen-Anmach-Computerprogramm ausgetüftelt. Da läuft ihm die absolute Traumfrau über den Weg: Rachel ist hübsch, reich und unnahbar. Charles versucht alles, um sie zu erobern.","poster":"/15KvepBOjWQb2YJ8nYiHkievVIv.jpg","runtime":91.0,"title":"Er? Will! Sie nicht?","type":"movie","va":5.2,"vc":39,"year":"1989"},"movie:44972":{"cast":[{"id":52263,"name":"Arjun Rampal","photo":"/1F81WNcVV5cW9O4D5Otk1Y2WHV9.jpg"},{"id":55061,"name":"काजोल","photo":"/h4m0TkDuEMCUNaPrQxMRyFb2AQ7.jpg"},{"id":37233,"name":"Kareena Kapoor Khan","photo":"/kp9xnwDALUt6nuPBGuJHlvnxGnM.jpg"},{"id":131839,"name":"Aanchal Munjal","photo":"/vgUv7SO4Lwx7iNzjiX1f4wU5BFC.jpg"},{"id":131840,"name":"Diya Sonecha","photo":""},{"id":131841,"name":"Nominath Ginsburg","photo":""}],"genres":["Drama","Familie"],"id":44972,"original":"वी आर फैमिली","overview":"","poster":"/dy2qAtTqe83zCCB55sqVK2g7i1m.jpg","runtime":115.0,"title":"वी आर फैमिली","type":"movie","va":5.7,"vc":40,"year":"2010"},"movie:47825":{"cast":[{"id":10823,"name":"Kris Kristofferson","photo":"/efD2Uu8QYBN7ZWSFa79mm3Pkk4L.jpg"},{"id":4515,"name":"Treat Williams","photo":"/jbRMOU2K7ePg7Zs59nfgEYLeD1e.jpg"},{"id":9626,"name":"Rip Torn","photo":"/jP74MHyQl6R8mH7aZKHrrD2Qjj2.jpg"},{"id":27116,"name":"Kevin Conway","photo":"/803hyktASensafHsdvDCnlzWK8k.jpg"},{"id":2115,"name":"Kurtwood Smith","photo":"/7dqsk4NYbNZNnmppv2zPuf1hKBn.jpg"},{"id":15860,"name":"Miguel Ferrer","photo":"/n6VZ8OQmozHmnJQRwR55gBH8Tl0.jpg"},{"id":5376,"name":"Jean Smart","photo":"/gOvEAOtrtedfgS7oQvPgHuJV4F8.jpg"},{"id":19752,"name":"Guy Boyd","photo":"/naVCBAb6GRUmYCXVreEECUetHYv.jpg"}],"genres":["Krimi","Thriller","Western"],"id":47825,"original":"Flashpoint","overview":"Morde gibt es immer wieder, hier an der texanischen Grenze zu Mexiko. Dealer, die sich gegenseitig umbringen, Schmuggler, Immigranten. Doch das, was die beiden Border Guards diesmal aus dem Wüstensand schaufeln, verspricht keine Routine. Neben der skelettierten Leiche im Jeep liegt ein Riesen-Vermögen an Dollar-Noten. Wer ist der Tote ? Woher stammt das Geld ? Kaum wird der Fall publik, schaltet sich das FBI ein. Die Arbeit der zuständigen District-Polizei wird plötzlich blockiert, Ermittlungs-Ergebnisse vertuscht, falsche Spuren gelegt und schließlich mit blanker Gewalt gegen die sich abzeichnende Wahrheit vorgegangen. Was soll hier mit aller Macht verheimlicht werden?","poster":"/xAMzujbmShAG6W13z71ov5wnfTA.jpg","runtime":94.0,"title":"Die Grenzwölfe","type":"movie","va":6.2,"vc":65,"year":"1984"},"movie:47960":{"cast":[{"id":231410,"name":"Νένα Μεντή","photo":"/kdR5M1e8Q14BHvOcu9dUuuM92I8.jpg"},{"id":1274544,"name":"Μαρία Καβογιάννη","photo":"/ponAG7CTYxHIfabbGvqEOnipis0.jpg"},{"id":980216,"name":"Ακύλλας Καραζήσης","photo":"/s4AQ0ttN3bM4KdadcAyhWCA6Zer.jpg"},{"id":576491,"name":"Τζόυς Ευείδη","photo":"/jwGBVqqcb8yWHOlCqSnhSxwVUtH.jpg"},{"id":89705,"name":"Alexis Georgoulis","photo":"/6R8fwSp48qU4eeZm20QRrVbXMwU.jpg"},{"id":1274546,"name":"Τζίνη Παπαδοπούλου","photo":"/fFKCaaGKfsuAlDkqEJPjMCDmCmA.jpg"},{"id":935678,"name":"Γιάννης Τσιμιτσέλης","photo":"/v7L4OI3VnVyaluCXfiKTUAJEg06.jpg"},{"id":82504,"name":"Αλέξανδρος Αντωνόπουλος","photo":"/gyhGBT1F8ODEjvdKo5eeDJe4TlZ.jpg"}],"genres":["Drama"],"id":47960,"original":"Οξυγόνο","overview":"","poster":"/30qgJW6ZxlKJAwlYnRsaraOhfPw.jpg","runtime":100.0,"title":"Οξυγόνο","type":"movie","va":5.3,"vc":26,"year":"2003"},"movie:48653":{"cast":[{"id":140891,"name":"Mostafa Qmar","photo":"/uZull5mK6khuL0cJR7S3YYayRq7.jpg"},{"id":140879,"name":"ياسمين عبدالعزيز","photo":"/6WevW0u4fa47n5NSSps18leaPep.jpg"},{"id":140892,"name":"Ola Ghanem","photo":"/u5crUAuOlylo0yFq0dCzZyZv9Om.jpg"},{"id":140893,"name":"Basma","photo":"/uHesQTc5W7cEIzC7LktGX9isl62.jpg"},{"id":140894,"name":"داليا البحيري","photo":"/asZcD9JJAhD5NZbayPKqXE19Qui.jpg"},{"id":140895,"name":"Reham Abdelghafour","photo":"/nLYYmE7KYZT4yVgr4dnoCRlFdfZ.jpg"},{"id":140878,"name":"طلعت زكريا","photo":"/9eC3kDLAzhlPI9MqqgXrIiaMEEQ.jpg"},{"id":141000,"name":"Edward","photo":"/4zMVIGh9IQoDiTWvEy9i2lGYCZA.jpg"}],"genres":["Komödie","Liebesfilm"],"id":48653,"original":"حريم كريم","overview":"","poster":"/MdRbjpqRn5WOvwjJukRKuTRAfd.jpg","runtime":112.0,"title":"حريم كريم","type":"movie","va":5.0,"vc":25,"year":"2005"},"movie:54872":{"cast":[{"id":74351,"name":"Simone Griffeth","photo":"/ymMesyN2UvhgzlfRRklGDZBnuPi.jpg"},{"id":140384,"name":"Steve Marachuk","photo":"/sLe8uqvWGQMfW3ASwW86TQiEM7q.jpg"},{"id":76184,"name":"Bryan Marshall","photo":"/7g6rBCW7N49J9wwuFxoUr3KSeFk.jpg"},{"id":29096,"name":"Peter McCauley","photo":"/7cY8ZMinlBQSZgSpnh0jd4oPVkf.jpg"},{"id":5533,"name":"Elizabeth Hawthorne","photo":"/mEL8pNamxnhIGvLwEro0H1vTmkm.jpg"}],"genres":["Thriller"],"id":54872,"original":"Hot Target","overview":"","poster":"/qqWGOuvs8UIk6s9wP9qTJYAXgwJ.jpg","runtime":93.0,"title":"Hot Target","type":"movie","va":3.4,"vc":7,"year":"1985"},"movie:56816":{"cast":[{"id":111217,"name":"Pavel Liška","photo":"/kjtMEeCbYzX9Pky1ZfGIVyWJ7Gu.jpg"},{"id":225015,"name":"Vitali Bobrov","photo":""},{"id":148012,"name":"Jorma Tommila","photo":"/ll9ZZR4kMnHS8FU2yHx76bnm0P.jpg"},{"id":937720,"name":"Emilia Ikäheimo","photo":""},{"id":125601,"name":"Pauli Poranen","photo":""},{"id":1158489,"name":"Lauri-Kare Laos","photo":"/dQflTz51iLzAqj03nsvKSBrKYsH.jpg"},{"id":1158490,"name":"Valmar Kass","photo":""},{"id":137536,"name":"Hendrik Toompere","photo":"/exBDfMlIehPuC5cnvCzAbaj2Vfq.jpg"}],"genres":["Drama"],"id":56816,"original":"Muukalainen","overview":"Inmitten der menschenleeren finnischen Wälder leben ein Junge, der nicht spricht, und seine Mutter auf einem verfallenen Bauernhof. Der Vater sitzt im Gefängnis, und regelmäßig besucht ihn der Junge, um ein Kästchen mit geheimnisvollem Inhalt zu ihm zu schmuggeln, den er vorher aus einer Ruine im Wald geholt hat. Eines Tages taucht ein Mann mit einer Schußverletzung auf und wird von der Frau aufgenommen. Der Vater scheint darüber Bescheid zu wissen und es zu billigen, doch der Junge bleibt dem Besucher gegenüber mißtrauisch. Dieser teilt nämlich bald mit der Mutter auch das Bett, wird von der Polizei gesucht und scheint an den Ruinen im Wald und an dem, was sie enthalten, interessiert zu sein.","poster":"/p4Qtr79EXgLQBuy6goOH4nxieQi.jpg","runtime":105.0,"title":"Der Besucher","type":"movie","va":6.2,"vc":20,"year":"2008"},"movie:78355":{"cast":[{"id":66776,"name":"Liza Minnelli","photo":"/1oGwXBirjCwPOfi2Qib9ZLFCTM4.jpg"},{"id":47498,"name":"Robert Moore","photo":"/eNGByR4e2jPO1D3ZGSk8aKFiZZC.jpg"},{"id":18328,"name":"Ken Howard","photo":"/YYMWMAqp6dpd18PIbo0aLiIabg.jpg"},{"id":41220,"name":"James Coco","photo":"/sJRnrOeQfhP3r541nSTQqGKSHWx.jpg"},{"id":83393,"name":"Kay Thompson","photo":"/bFNq0fWlid7kOCpj3VDVtazgWXH.jpg"},{"id":9811,"name":"Fred Williamson","photo":"/h8cWu4xwqUGmkYUkl5LF9OFJyOg.jpg"},{"id":90163,"name":"Ben Piazza","photo":"/io4ieCby2cPioQaAbnTFVniKu2D.jpg"},{"id":1232039,"name":"Emily Yancy","photo":"/nUIYt7Cp2Usje6WpDKUzZqtOVnw.jpg"}],"genres":["Komödie","Drama","Liebesfilm"],"id":78355,"original":"Tell Me That You Love Me, Junie Moon","overview":"","poster":"/m8gntXfzQGZtjnAc7cixC2khiw7.jpg","runtime":113.0,"title":"Tell Me That You Love Me, Junie Moon","type":"movie","va":5.5,"vc":17,"year":"1970"},"movie:83869":{"cast":[{"id":33397,"name":"Sarah Bolger","photo":"/A3K2l5kkqTMQHtAkctzICqtbZMY.jpg"},{"id":1142720,"name":"Thomas Mann","photo":"/cJO10vU19SL82pgMB6LdAijDSJv.jpg"},{"id":11006,"name":"James Marsden","photo":"/lf7OnfKZnMgNh9b98764tqSocGK.jpg"},{"id":6194,"name":"Claire Danes","photo":"/mb23NPDMRB7csC5xl4cgrdNkPXr.jpg"},{"id":8553,"name":"Seth Adkins","photo":"/pFWVcO6Y1fB1tIgflBCyGwP5R7n.jpg"},{"id":23958,"name":"Jeremy Sisto","photo":"/1XfuASLjBhGOhJ4os7juRJot2we.jpg"},{"id":15563,"name":"Anika Noni Rose","photo":"/d7aLtuNXBqVtqNnZl8wXsFV4ML5.jpg"},{"id":4602,"name":"Jon Tenney","photo":"/ktb1RA23pHJKMdcFenQ2cosnCkp.jpg"}],"genres":["Komödie","Drama"],"id":83869,"original":"As Cool as I Am","overview":"An Selbstbewusstsein mangelt es Lucy (Sarah Bolger) gewiss nicht. Etwas anderes bleibt der burschikosen Teenagerin aber auch nicht übrig, denn ihr Vater Chuck (James Marsden), zu dem sie tiefe Zuneigung verspürt, ist immer für Monate beruflich unterwegs in Kanada, und ihre Mutter Lainee (Claire Danes) ist sehr auf sich selber fokussiert. Die Pubertät gerät für Lucy zu einer Zeit der Umwälzungen, als sie sich nicht nur für Jungs zu interessieren beginnt, was ihr bisheriges unbekümmertes Verhältnis zu dem gleichaltrigen Kenny (Thomas Mann) belastet, sondern auch erfahren muss, dass ihre Mutter ein Verhältnis hat. Die Offenbarung, dass ihre Eltern damals nur wegen Lainees Schwangerschaft geheiratet haben, bringt Ernüchterung, aber auch die Chance auf einen Neuanfang für Lucys Familie.","poster":"/izoKkDJCbYhIkrPzpCcwrqg2K90.jpg","runtime":92.0,"title":"As Cool as I Am","type":"movie","va":5.9,"vc":137,"year":"2013"},"movie:89481":{"cast":[{"id":1017259,"name":"Simon Phillips","photo":"/uGD1Wm0AIFCOcOoY9kdONGdpXMC.jpg"},{"id":94956,"name":"Craig Conway","photo":"/ebOO4G9bgOSv46ea9uCApoDH6Aq.jpg"},{"id":139834,"name":"Gemma Atkinson","photo":"/iCIbLcERZqJc9Djbgm86FI1eudV.jpg"},{"id":23587,"name":"Stephanie Leonidas","photo":"/b1Cs2UI6FoPM64OZL2XgshIF241.jpg"},{"id":63073,"name":"Billy Murray","photo":"/tg3TrFaljOnIEd7lm7hKhddQOoj.jpg"},{"id":47652,"name":"Martin Kemp","photo":"/cex68RbEL5FW6VbcL1e52shUF1p.jpg"},{"id":20766,"name":"Richard E. Grant","photo":"/92oaBntIXhndCxUXaGywUyILIIE.jpg"},{"id":937273,"name":"Keeley Hazell","photo":"/6JpvHdd0ad78WahGQr40e5770mL.jpg"}],"genres":["Komödie"],"id":89481,"original":"How to Stop Being a Loser","overview":"Endlich Frauenheld – bis zu diesem Auspruch ist es noch ein langer Weg für James (Simon Phillips), dessen Selbstvertrauen genauso schlecht ist wie seine Flirttricks. Der Druck eine Partnerin zu finden ist groß und nachdem sich ein guter Bekannter von ihm mit dem gleichen Problem sogar umbringt, intervenieren seine Freunde – es muss sich etwas ändern. Wer könnte da besser helfen, als einer, der zum Thema massenhaft Bücher geschrieben und Seminare geleitet hat: Liebesguru Ampersand (Craig Conway). Doch die zwielichtigen Methoden bringen nicht ganz, was er verspricht. Doch es kommt Bewegung in die Sache.","poster":"/nnCIr9yQxc