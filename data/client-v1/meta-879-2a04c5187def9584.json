":"movie","va":6.8,"vc":4012,"year":"2022"},"movie:800198":{"cast":[{"id":81321,"name":"Amy Carlson","photo":"/zKFfc32qv97padj54XNCTEUSHGE.jpg"},{"id":59690,"name":"David Alan Basche","photo":"/oL1tgbkggx4POSxSfWN38Vd4M01.jpg"},{"id":1969994,"name":"Mallory Bechtel","photo":"/knFuxxTKvZOTZaqy7M3V8ZWndY5.jpg"},{"id":1790597,"name":"Jack DiFalco","photo":"/819nz6a51qmJzty7TwA4msi2qay.jpg"},{"id":2376900,"name":"Meeya Davis","photo":"/7dlbiscSLhul2gUJZ4grBkkhqFQ.jpg"},{"id":2816193,"name":"Susan Feinman","photo":"/8oEtdeoZO3a8hNMrDvyVMPDqPk8.jpg"},{"id":1981811,"name":"Chase Bolnick","photo":"/dZO0BiZXuA8RUsdTteoqjZperje.jpg"},{"id":1397406,"name":"Mike Nguyen","photo":""}],"genres":["Horror"],"id":800198,"original":"Know Fear","overview":"Die Eheleute Donald (David Alan Basche) und Wendy Capel (Amy Carlson) ziehen in ein neues Haus, deren vorherigen Bewohner nach einem mysteriösen Zwischenfall spurlos verschwunden sind. Als Wendy ein geheimnisvolles Buch entdeckt, das die ehemaligen Hausbesitzer offenbar zurückgelassen haben, beginnt sie sich zu verändern. Glücklicherweise ist Donalds und Wendys Nichte Jami (Mallory Bechel) eine angehende Geisterjägerin und weiß, was zu tun ist: ein Ritual, das jedes Familienmitglied dazu zwingt, auf seine eigene Art und Weise mit dem Dämon zu kommunizieren: ihn zu sehen, zu hören oder mit ihm zu sprechen...","poster":"/bVMnaPV3QcAmMRbZjEJ3cBpCEPq.jpg","runtime":77.0,"title":"Know Fear","type":"movie","va":5.8,"vc":20,"year":"2022"},"movie:801526":{"cast":[{"id":1108120,"name":"आलिया भट्ट","photo":"/lAgBZgHKTo6amIO9CfNxUbm1usH.jpg"},{"id":120430,"name":"Shefali Shah","photo":"/9F8UGARvP7w10Chq5povDPHpfUC.jpg"},{"id":1551045,"name":"विजय वर्मा","photo":"/A46ekiPFC3vA1442FJmiIudpxX1.jpg"},{"id":1697412,"name":"Roshan Mathew","photo":"/9BzqaEdErGxF1EDELQEXpnRsqQu.jpg"},{"id":648087,"name":"Rajesh Sharma","photo":"/cBmZY1EICMD1q16Fx7GqpHkc6A1.jpg"},{"id":993640,"name":"Vijay Maurya","photo":"/bv5PBdLWy6MZxpDukrkHbaiLcsL.jpg"},{"id":582489,"name":"Santosh Juvekar","photo":"/py8kcmyFLWnzS9GB5nigtgAc0GS.jpg"},{"id":1106490,"name":"Kiran Karmarkar","photo":"/2fDF9Fspqbrsn9wYn1W8qXTV6GA.jpg"}],"genres":["Komödie"],"id":801526,"original":"डार्लिंग्स","overview":"","poster":"/lyA7kXCIAG17hVuvFOxlMmmv31A.jpg","runtime":134.0,"title":"डार्लिंग्स","type":"movie","va":7.0,"vc":86,"year":"2022"},"movie:801724":{"cast":[{"id":204384,"name":"Rene Rosado","photo":"/2m6y5nEU0z8pZR3SCulOPksukpo.jpg"},{"id":1207250,"name":"Lisa Roumain","photo":"/d2zC29HKEdcksHOAKKh8nJACLew.jpg"},{"id":963192,"name":"Tiffany Daniels","photo":"/h65BnS8f2ccwk1eVTp3nXng7mOu.jpg"},{"id":139234,"name":"Jessica Meza","photo":"/zL0dhlcfxKFAZxSAbOfnVIDvOh3.jpg"},{"id":1734222,"name":"Scotty Tovar","photo":"/jAVlTB9GM08jPDasXpMyABeXvqQ.jpg"},{"id":3079803,"name":"Jacory Gums","photo":""},{"id":1312357,"name":"Geo Santini","photo":"/4yJf0pVrIv5iTcnjF4A8eUnDgpC.jpg"}],"genres":["Komödie"],"id":801724,"original":"After the Reign","overview":"","poster":"/j7asOmHWpgMuSo6YzNj2GYZqcFm.jpg","runtime":95.0,"title":"After the Reign","type":"movie","va":5.0,"vc":1,"year":"2020"},"movie:804150":{"cast":[{"id":41292,"name":"Keri Russell","photo":"/4bLtisDjmCOemk3uC65NAlmdIjz.jpg"},{"id":71375,"name":"Alden Ehrenreich","photo":"/vOLiUSDT8rubu0J2YKwBkOL0K6V.jpg"},{"id":1371398,"name":"O'Shea Jackson Jr.","photo":"/kXJ02sXvnExbGNJ11piC6d6WMOc.jpg"},{"id":11477,"name":"Ray Liotta","photo":"/ve9sB0o1MYTaL2SXEisVW2RMkD5.jpg"},{"id":17490,"name":"Isiah Whitlock Jr.","photo":"/8OIhQb53rMX7VcTLZbAMeVd7tHc.jpg"},{"id":1704640,"name":"Brooklynn Prince","photo":"/k9oSIk7V8Sbgs0Dw8tX71f9YeXi.jpg"},{"id":1721268,"name":"Christian Convery","photo":"/tOR2tSrvHPVDltE4jBDEva3GNqY.jpg"},{"id":452,"name":"Margo Martindale","photo":"/6ANuYnZZJTuQLL4bbt8vH1qDYje.jpg"}],"genres":["Thriller","Komödie","Krimi"],"id":804150,"original":"Cocaine Bear","overview":"1985 stürzt ein randvoll mit Kokain beladenes Flugzeug irgendwo im Nirgendwo über den Wäldern Georgias ab. Sind die mehr als 200 Kilogramm Rauschgift und damit potenziell eine ganze Menge Geld also für immer verloren? Die Eigentümer, eine Handvoll Kriminelle, wollen es eher nicht darauf ankommen lassen und vor Ort lieber auf Nummer sicher gehen. Auf der Suche nach dem wertvollen Stoff merken sie jedoch, dass jemand anderes schneller als sie war. Denn fündig geworden ist nämlich ein riesiger Schwarzbär. Und der dreht nun völlig zugedröhnt am Rad. Touristen, ein paar Teenager, Polizisten und auch die Gangster passen auf Koks super in’s Beuteschema des monströsen Tieres. Jetzt heißt es nur noch eins: überleben und hoffen, dass die pelzige Kampfmaschine irgendwann von ihrem Trip runterkommt. Doch der Bär ist auf den Geschmack gekommen und will immer mehr von dem weißen Pulver.","poster":"/zTKAsyg0kmYwEzAiPn94rC3oYwQ.jpg","runtime":95.0,"title":"Cocaine Bear","type":"movie","va":6.0,"vc":2592,"year":"2023"},"movie:813165":{"cast":[{"id":2103243,"name":"Katharina Farnleitner","photo":""},{"id":1818017,"name":"Valentin Postlmayr","photo":"/o5BDahQqFX5aWlfnBETZMC6Uqgp.jpg"},{"id":141721,"name":"Rainer Egger","photo":"/nU45zcqSYiRbycFWhCBaFTfsq5U.jpg"},{"id":3034660,"name":"Milena Czernovsky","photo":""}],"genres":["Drama"],"id":813165,"original":"Schneemann","overview":"","poster":"/t6AiYKM3Ora4oIGpCZribsFwVZn.jpg","runtime":20.0,"title":"Schneemann","type":"movie","va":0.0,"vc":0,"year":"2018"},"movie:887609":{"cast":[{"id":3968,"name":"Michael Sheen","photo":"/nGxIcIcfJjdPN3k8zFabtA1gRqL.jpg"},{"id":2130,"name":"Cary Elwes","photo":"/9UszBdQJ9PmyBydIeIBxlStozhW.jpg"},{"id":1251069,"name":"Nathalie Emmanuel","photo":"/uh8EIhxKJxK7xsJlWcIgBkqyAKq.jpg"},{"id":543632,"name":"Katherine Kelly","photo":"/gh8uNkRvuC6cHpnXKtaT2iKg0Ht.jpg"},{"id":127164,"name":"Phyllis Logan","photo":"/jRNfzD3bA5fyPxXRTiDbfNsTcOV.jpg"},{"id":2674958,"name":"Anna Lundberg","photo":"/5XuhYQqZknEXmYYbqzbXUOltlO6.jpg"},{"id":7321,"name":"John Thomson","photo":"/p7oShR4yImaPszUh3ywnJEu5a5.jpg"},{"id":113236,"name":"Mia McKenna-Bruce","photo":"/zVmrUsxaLDiWyIKtMxX5N12D6G8.jpg"}],"genres":["Fantasy","Drama"],"id":887609,"original":"Last Train to Christmas","overview":"1985 steht Tony Towers (Michael Sheen) kurz davor, die Reise seines Lebens anzutreten. Er ist eine lokale Berühmtheit, ein erfolgreicher Nachtclubmanager und mit der sehr viel jüngeren Frau Sue (Nathalie Emmanuel) verlobt. Als er den 3:17 Uhr Zug nach Nottingham betritt, um zu einer familiären Weihnachtsfeier zu fahren, gerät sein Leben aus den Fugen. Im Buffetwagen angekommen, landet er im Jahr 1995 und Tony stellt fest, dass alle seine Clubs mittlerweile Pleite gegangen sind und sein Leben nicht mehr das ist, was es einst war. Indem er sich im Zug vorwärts und rückwärts bewegt, kann er sich nun an verschiedene Abschnitte seines Lebens versetzen. Doch dabei bleibt es nicht, auch alle Handlungen, die er in einem Waggon vornimmt, wirken sich direkt auf sein Leben im nächsten Abteil aus. Nun stellt sich die Frage: Kann Tony damit sein Leben und das seiner Liebsten positiv verändern oder macht er alles nur schlimmer?","poster":"/xkVUORoeRbRnAq5IkN4Pwq45R07.jpg","runtime":110.0,"title":"Last Train to Christmas","type":"movie","va":5.6,"vc":65,"year":"2021"},"movie:889122":{"cast":[{"id":104912,"name":"Jessica Morris","photo":"/vnRqsSs1iZenoGCJGc0vdUgjg7A.jpg"},{"id":1829679,"name":"Sarah Navratil","photo":"/7qJJBfMAprXP4upKDGBr7q6FYoX.jpg"},{"id":98658,"name":"Jason-Shane Scott","photo":"/prYGxoPr9nql2wv3kj1n9ul0qbG.jpg"},{"id":1214717,"name":"James Hyde","photo":"/yXVBAL5h339cnSkjlZykS2Qsc9v.jpg"},{"id":1215883,"name":"Jason Cook","photo":"/rKnyGHORFEOAoRPMPJrCFOki8t5.jpg"},{"id":1756667,"name":"Carrie Schroeder","photo":"/rnqhcnLRPB0p2JvdWRL2Ncm5XfB.jpg"},{"id":2041403,"name":"Daniel Joo","photo":"/7iZ8f1Hr8pmNKvP2AcyjKzicH7E.jpg"},{"id":564032,"name":"Helen Day","photo":"/qeCxjQzrDbKtl8vvmSQc6HvPSQA.jpg"}],"genres":["TV-Film","Thriller","Drama"],"id":889122,"original":"Abduction Runs in the Family","overview":"","poster"