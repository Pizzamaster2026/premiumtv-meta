o":""},{"id":2081517,"name":"Valerie Velardi","photo":""},{"id":136487,"name":"David Letterman","photo":"/nk1rMabb84e52G2oax6yO9FBiAd.jpg"},{"id":1385535,"name":"Bennett Tramer","photo":""},{"id":4509109,"name":"McLaurin Smith-Williams","photo":""},{"id":4509118,"name":"Frankie Williams","photo":""}],"genres":["Dokumentarfilm"],"id":493100,"original":"Robin Williams: Come Inside My Mind","overview":"Dieses witzige, intime Portrait von Robin Williams erzählt aus dem Leben der Comedy-Legende und stellt seinen Beitrag zur Comedy und zur Kultur im Allgemeinen in den Mittelpunkt, von den wilden Tagen der späten 70er-Jahre in L.A. bis zu seinem Tod 2014.","poster":"/ak9DZnzInl9oIUlXxsFsUd37ueh.jpg","runtime":116.0,"title":"Robin Williams: Come Inside My Mind","type":"movie","va":7.9,"vc":273,"year":"2018"},"movie:497489":{"cast":[{"id":2017397,"name":"Michal Kosinski","photo":""},{"id":2359378,"name":"David Carroll","photo":"/MIaVNPK5UzQKSWAoqt7rZahiAm.jpg"},{"id":2607983,"name":"Rosie Gray","photo":""},{"id":2607984,"name":"Brendan Fischer","photo":""},{"id":2359376,"name":"Carole Cadwalladr","photo":""},{"id":2607985,"name":"Tad Devine","photo":""},{"id":2607986,"name":"Sebastian Mallaby","photo":""},{"id":2607987,"name":"Kathy Frankovic","photo":""}],"genres":["Dokumentarfilm"],"id":497489,"original":"Trumping Democracy","overview":"Donald Trump wurde der 45. Präsident der Vereinigten Staaten, indem er drei wichtige Bundesstaaten gewann – ein Sieg, der von einer ultrakonservativen Fraktion inszeniert wurde, die sich mit Fake News, Lügen und Psychometrie still und leise den Weg zur Macht bahnte. Diese brisante Dokumentation folgt dem Geldfluss zu dem schwer fassbaren Multimilliardär Robert Mercer, der Breitbart News kaufte und die Kampagne finanzierte, während er Steve Bannon als Manager in die Präsidentschaftskampagne einführte.","poster":"/7eE1H8QbFiOdn7pRTWXx9TiOBfC.jpg","runtime":68.0,"title":"Trumping Democracy","type":"movie","va":5.3,"vc":7,"year":"2017"},"movie: