n.","poster":"/1DLUb9PTDqXMSgsD7RmiJs7ZJIx.jpg","runtime":114.0,"title":"One Night in Miami...","type":"movie","va":7.0,"vc":735,"year":"2020"},"movie:757329":{"cast":[{"id":1047711,"name":"Gulshan Devaiah","photo":"/6fOS4P9KiPFvIuLyvIUfMyXiF29.jpg"},{"id":88438,"name":"Sagarika Ghatge","photo":"/2CbIQNWuMSvivXORm2bAaHMq43R.jpg"},{"id":113690,"name":"Kunaal Roy Kapur","photo":"/l8EbUNJUbfyKuHIQiXWK91FGyea.jpg"},{"id":2829786,"name":"Ashish Pathode","photo":"/9dIIek5yM6CjRhi6XQ8ZV62pEF7.jpg"}],"genres":["Krimi","Thriller"],"id":757329,"original":"Footfairy","overview":"","poster":"/r9y30IiBZKQEZiwkP1aaST2Fjcn.jpg","runtime":115.0,"title":"Footfairy","type":"movie","va":4.2,"vc":10,"year":"2020"},"movie:786532":{"cast":[{"id":1070341,"name":"Derek Ting","photo":"/8432vvJne47UoLThh6FRRUfzImV.jpg"},{"id":2391,"name":"Michael Dorn","photo":"/6mVjb0YsidC0gW9P8mXMkQirfcK.jpg"},{"id":109858,"name":"Kayla Ewell","photo":"/erWiC1tRwFvPbj0KivUQk0Of9Xx.jpg"},{"id":1778568,"name":"Carole Weyers","photo":"/x0AMwBYXFv2XkLPnp8rNDYoIpLc.jpg"},{"id":1547148,"name":"Teo Briones","photo":"/cyykbm4Xht2Pi7brr88FcmS1LPb.jpg"},{"id":21398,"name":"Maxine Bahns","photo":"/6kcAbxss0gXt50J1KVGmobbLMHD.jpg"},{"id":1368011,"name":"Cory Tucker","photo":"/5M1SZOtrsaR1UPnkEokz20c1dcm.jpg"},{"id":1656647,"name":"Janelle Beaudry","photo":"/uWR2sNNYXSfEqebyqW5t1P8x3xI.jpg"}],"genres":["Action","Science Fiction","Drama"],"id":786532,"original":"Agent Revelation","overview":"","poster":"/lnihobYZTZZ88PUKKw30WpaCveV.jpg","runtime":86.0,"title":"Agent Revelation","type":"movie","va":5.6,"vc":34,"year":"2021"},"movie:818783":{"cast":[{"id":149124,"name":"Ioana Iacob","photo":"/iI8lwVmyNtGaRrirwMSPic0mgm.jpg"},{"id":3053600,"name":"Pola Geiger","photo":"/n6mD3lC0wzVujbK3lLoXI6hxaPd.jpg"},{"id":165,"name":"Knut Berger","photo":"/xRVqiLiYWiO7OmO9iIYALgDijhb.jpg"},{"id":49204,"name":"Susanne Wuest","photo":"/digwuYrLyKVJVTW8BAgGCFduRta.jpg"},{"id":10236,"name":"Jörg Schüttauf","photo":"/fxQYG2JbWTZv2HRKo7GWl7xaOlH.jpg"},{"id":239799,"name":"Şiir Eloğlu","photo":"/bkL8kf2XPuLFNeZdO6IceRijkbW.jpg"},{"id":1262244,"name":"Moritz Jahn","photo":"/qxAmxpTpZ3mFiW6Ls5v1otsCxxH.jpg"},{"id":1531137,"name":"Mina Sagdiç","photo":""}],"genres":["Komödie","Drama"],"id":818783,"original":"Wir könnten genauso gut tot sein","overview":"Ein Hund verschwindet. Iris schließt sich im Bad ein und ihre Mutter Anna – die Sicherheitsbeauftragte der Hochhausgemeinschaft – stellt sich einem absurden Wettkampf gegen die Angst, die sich unter den Bewohnern ausbreitet wie ein Virus.","poster":"/8Ops8d5fMrATx76foD6buqM7OWf.jpg","runtime":90.0,"title":"Wir könnten genauso gut tot sein","type":"movie","va":5.7,"vc":21,"year":"2022"},"movie:8489":{"cast":[{"id":2888,"name":"Will Smith","photo":"/8TlKqbXYgHmmaEoPBJ7djJ8Rxxa.jpg"},{"id":134,"name":"Jamie Foxx","photo":"/zD8Nsy4Xrghp7WunwpCj5JKBPeU.jpg"},{"id":10127,"name":"Jon Voight","photo":"/oxLsItDwLddXu8YYJCfkddYNejL.jpg"},{"id":16214,"name":"Mario Van Peebles","photo":"/fiExKjVttfePRwmfVvMHPjC7F9n.jpg"},{"id":21399,"name":"Ron Silver","photo":"/6urQBScK7Vq6q5niaMMEmzW3DGP.jpg"},{"id":2954,"name":"Jeffrey Wright","photo":"/yGcuHGW4glqRpOPxgiCvjcren7F.jpg"},{"id":34,"name":"Mykelti Williamson","photo":"/dR16zD9AjnHWbeN5OVmJWE0vSax.jpg"},{"id":9575,"name":"Jada Pinkett Smith","photo":"/3RyvVVSlgRbZANDFkYiAsRMaHW.jpg"}],"genres":["Drama"],"id":8489,"original":"Ali","overview":"Dem weltberühmten Boxer Cassius Clay gelingt es, Sonny Liston 1964 den Schwergewichtstitel abzunehmen. Der Champ konvertiert bald darauf zum Islam, erhält den Namen Muhammad Ali und heiratet die frei denkende Sonji. Die Ehe scheitert, und 1967 verweigert Ali den Kriegsdienst in Vietnam. Er wird daraufhin angeklagt und bekommt seine Boxlizenz entzogen. Auch als Weltmeister wird er nicht mehr anerkannt. Drei Jahre kämpft er gegen eine mögliche Haftstrafe, bis er begnadigt wird. Inzwischen ist Joe Frazier Weltmeister und auch Ali verliert sein WM-Comeback nach Punkten. Dreieinhalb Jahre später, 1974, fordert er den neuen Weltmeister George Foreman in Zaire zum Comeback-Fight heraus, zum \"Rumble in the Jungle\"...","poster":"/ye5ogyRprim9pyT8OpR4p8EVVSV.jpg","runtime":159.0,"title":"Ali","type":"movie","va":6.7,"vc":1953,"year":"2001"},"movie:8588":{"cast":[{"id":5049,"name":"John Hurt","photo":"/bjNSzt1d7uK3q5PbtFXUJrRt4qg.jpg"},{"id":12791,"name":"Hugh Dancy","photo":"/6UIiS3nxdNTbIo0G2kFNXpcDKhE.jpg"},{"id":39251,"name":"Dominique Horwitz","photo":"/3YuwwLvwuDjl6R9RnBQ03A6vp3R.jpg"},{"id":141354,"name":"Nicola Walker","photo":"/gZNT3kN254dASL2MZ6S2MpP6Nk2.jpg"},{"id":55411,"name":"David Gyasi","photo":"/1382u2e4jiGhuDKgeK9UZtXXqfh.jpg"},{"id":55412,"name":"Steve Toussaint","photo":"/9rJafPDkQP8YuLy9iY5v19ZfMIW.jpg"},{"id":64986,"name":"Clare-Hope Ashitey","photo":"/tuAfNiVgPnMzrw66pfZLKrb7oIn.jpg"},{"id":1318523,"name":"Susan Nalwoga","photo":""}],"genres":["Drama","Historie"],"id":8588,"original":"Shooting Dogs","overview":"Fliehen oder bleiben - vor dieser Frage stehen Pater Michael Thomas und sein junger Lehrerkollege Joe Connor. Die beiden leiten eine Missionsschule in Afrika und werden Zeugen der Ereignisse, welche das Land nach dem 6. April 1994 - nach der Ermordung des Präsidenten von Ruanda - in grosse Aufruhr versetzen. Unzählige Tutsi werden von den radikalen Hutu verfolgt und ermordet. Mittendrin steht die kleine Schule, die zum Zufluchtsort der Tutsi wird. Die beiden Europäer setzen sich, als selbst die UN nicht mehr handelt, vom eigenen Idealismus angetrieben, persönlich mit allen Kräften für die Verfolgten ein. Sie müssen aber bald einsehen, dass sie machtlos sind. Sollen sie ihr eigenes Leben aufs Spiel setzen, um die Gewalt abzuwehren?","poster":"/9xC2yUgqPVvoHykYuigrxLyunya.jpg","runtime":115.0,"title":"Shooting Dogs","type":"movie","va":7.5,"vc":170,"year":"2006"},"movie:9499":{"cast":[{"id":11661,"name":"Kate Hudson","photo":"/s79lH1QzEg2fkXULKBxRmU9aNr8.jpg"},{"id":3489,"name":"Naomi Watts","photo":"/7ysvff7ZhW388SIh2YjQ0XI