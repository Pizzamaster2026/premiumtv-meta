n scheinen leichte Beute. Melinda wittert die Chance, mit Billy in ein wildes und gefährliches Leben auszubrechen. Doch dann läuft der Überfall völlig aus dem Ruder…  (splendid-film.de)","poster":"/sHHlXYEK7yk7CFDoRw5C6VFspd.jpg","runtime":88.0,"title":"Burn - Hell of a Night","type":"movie","va":6.1,"vc":372,"year":"2019"},"movie:521100":{"cast":[],"directors":[],"genres":["Dokumentarfilm"],"id":521100,"original":"Le code secret des Aztèques","overview":"","poster":"/h2UBi4M24EZgnhH4eF8RAlU6aEm.jpg","runtime":0.0,"title":"Le code secret des Aztèques","type":"movie","va":0.0,"vc":0,"year":"2009"},"movie:538238":{"cast":[{"id":2092985,"name":"Barry W. Jerald Jr.","photo":""},{"id":1070248,"name":"Jerry Chesser","photo":"/2WPyXyl2XvqyhP4xiKlPOkX3YPf.jpg"},{"id":2148643,"name":"Catherine Jerald","photo":"/ofA9VjDxk9EorFDsYFAFNCLXQmf.jpg"},{"id":2093378,"name":"Brad Lea","photo":""},{"id":1678909,"name":"Jezibell Anat","photo":"/oeElnRQ5GItH0nA0YOj3i24y9nQ.jpg"},{"id":2093379,"name":"Shere Ladd","photo":""},{"id":2088703,"name":"Joseph Zuchowski","photo":""},{"id":1201978,"name":"Dan Beck","photo":""}],"directors":[],"genres":["Action"],"id":538238,"original":"Cheat the Hangman","overview":"","poster":"/xECnE1Qj47PG3G766aePBx2ct9d.jpg","runtime":90.0,"title":"Cheat the Hangman","type":"movie","va":4.0,"vc":2,"year":"2018"},"movie:585843":{"cast":[{"id":1384277,"name":"李现","photo":"/z8cD7qVR2hyXNpgGr0Yhrj0LjL7.jpg"},{"id":1838723,"name":"顾璇","photo":"/dDzd9vHp3edSTBI9hc9V0r52fzB.jpg"},{"id":1781818,"name":"Dong Borui","photo":"/hQ0ZIJzLrlYV9z0GxVPs3v9Jo6X.jpg"},{"id":1707676,"name":"林晓凡","photo":"/1iiI1azIsLN4VIQyY7kwT28Mm58.jpg"},{"id":2484483,"name":"Liu Weibo","photo":""}],"directors":[{"id":2255655,"name":"Song Wen"}],"genres":["Drama","Thriller","Mystery"],"id":585843,"original":"抵达之谜","overview":"","poster":"/xJKyNVaEazpndRvVbub8Sdi6QaD.jpg","runtime":114.0,"title":"抵达之谜","type":"movie","va":5.0,"vc":1,"year":"2020"},"movie:596850":{"cast":[{"id":550947,"name":"Cün