ZgVi5MgDi.jpg"},{"id":8691,"name":"Zoe Saldaña","photo":"/vQBwmsSOAd0JDaEcZ5p43J9xzsY.jpg"},{"id":2229,"name":"Catherine Keener","photo":"/n4CTwGszs6cwS1wJRlDQ5Mlh7Ex.jpg"},{"id":1020687,"name":"Alex Mallari Jr.","photo":"/nhFJW8vwez6KzdYDgNu5B5L94lV.jpg"},{"id":2004111,"name":"Braxton Bjerken","photo":"/21vO66zI6tMv1EmFY0sWpHv6dMs.jpg"}],"directors":[{"id":17825,"name":"Shawn Levy"}],"genres":["Abenteuer","Science Fiction","Komödie"],"id":696806,"original":"The Adam Project","overview":"Der 12-jährige Adam Reed, der immer noch den plötzlichen Tod seines Vaters ein Jahr zuvor betrauert, betritt eines Nachts seine Garage und stellt fest, dass sich dort ein verwundeter Pilot versteckt. Dieser Pilot entpuppt sich als eine ältere Version von ihm selbst – aus einer Zukunft, in der die Zeitreiserei noch in den Kinderschuhen steckt. Er hat alles riskiert, um auf einer geheimen Mission in der Zeit zurückzureisen. Zusammen müssen sie sich auf ein Abenteuer in die Vergangenheit begeben, um ihren Vater zu finden und alles in Ordnung zu bringen. Erschwerend kommt hinzu, dass sich die zwei Adams nicht wirklich mögen. Wenn sie die Welt retten wollen, werden sie zuerst lernen müssen, miteinander auszukommen.","poster":"/3Mc3egy0a8SguQqOggouQvhTY1i.jpg","runtime":106.0,"title":"The Adam Project","type":"movie","va":7.0,"vc":5287,"year":"2022"},"movie:829051":{"cast":[{"id":299743,"name":"Sebastian Maniscalco","photo":"/bvJQGVOI8fJ9Y4eAvYqoQcOAbHZ.jpg"},{"id":380,"name":"Robert De Niro","photo":"/cT8htcckIuyI1Lqwt1CvD02ynTh.jpg"},{"id":57451,"name":"Leslie Bibb","photo":"/g3a1O9lOTZvrwQupUtg4Fc3CdTd.jpg"},{"id":521563,"name":"Anders Holm","photo":"/fgH6wEjj5tzEUcncUifBRVuidug.jpg"},{"id":33533,"name":"David Rasche","photo":"/bWPhfa4m8pXVneP1gf37xvuMUCA.jpg"},{"id":110475,"name":"Brett Dier","photo":"/o6qpQsBtIpU7EonNDktecfP9qTi.jpg"},{"id":2109,"name":"Kim Cattrall","photo":"/6X6x8gLSOWxwhoquIi37769m0k0.jpg"},{"id":3469887,"name":"Arielle Prepetit","photo":"/tNWitZ7A33dHwhdiASM4PZbLO2b.jpg"}],"directors":[{"id":1405645,"name":"Laura Terruso"}],"genres":["Komödie"],"id":829051,"original":"About My Father","overview":"Sebastian wird von der superreichen und exzentrischen Familie seiner Freundin Ellie zum standesgemäßen Familienwochenende eingeladen. Allerdings ausgerechnet über den Feiertag, den er normalerweise mit seinem Vater Salvo verbringt. Da schlägt Ellie kurzerhand vor, ihn einfach mitzunehmen. Doch Salvo ist das absolute Gegenteil von Ellies Familie: ein traditionsbewusster, italienischer Immigrant, der sein Geld nicht ohne Stolz als Friseur verdient. Und so prallen zwei Welten aufeinander, wie sie unterschiedlicher nicht sein könnten. Dies führt zu reichlich Chaos und Sebastian und seinen Vater Salvo am Ende zur Erkenntnis, dass das Beste an Familie schlichtweg ALLES ist.","poster":"/jTm3kqT1ewuWzpXeni8b2ohzZc1.jpg","runtime":90.0,"title":"Und dann kam Dad","type":"movie","va":6.0,"vc":446,"year":"2023"},"movie:849772":{"cast":[{"id":1841650,"name":"Crystal-Lee Naomi","photo":"/9ZpIjKgdSiIgRPJUAaBl50zw1hH.jpg"},{"id":1216509,"name":"Jennifer Freeman","photo":"/3JaUK9ZKmafZ6q54G0N6uIywBjJ.jpg"},{"id":1636772,"name":"Ali Amin Carter","photo":"/tUQCrlIevQZ5SxDEP7uGtSprZaf.jpg"},{"id":2189111,"name":"Kareem Lewis","photo":"/lMo6GRR1c2NLgpvPIL5E0ByVkYw.jpg"},{"id":2489910,"name":"Tyler Kay Whitley","photo":"/NlX8efmhEV6dSDppwvpufQiUkj.jpg"},{"id":2775083,"name":"Suzanne Salhaney","photo":""},{"id":2871383,"name":"Melanie Kiran","photo":"/HBruK3Korst4eWJE6h3LISWZyp.jpg"},{"id":2096296,"name":"Aisha Duran","photo":"/mCPhS5BePmoSmy1RcjoJnJ2ATmR.jpg"}],"directors":[{"id":1460750,"name":"Courtney Miller"}],"genres":["TV-Film","Mystery","Thriller"],"id":849772,"original":"Twisted House Sitter","overview":"","poster":"/lMnaQIy21b99ejz4oMDZCoEfWTN.jpg","runtime":84.0,"title":"Twisted House Sitter","type":"movie","va":6.8,"vc":13,"year":"2021"},"movie:858288":{"cast":[{"id":105650,"name":"Amol Palekar","photo":"/kUnejDjArzNVxouIaIj3WxxC83G.jpg"},{"i