 Gregor in ihre erste große Krise, mit der keiner von beiden umgehen kann. Erschrocken müssen sie feststellen, dass ihnen die Liebe droht abhanden zu kommen.","poster":"/7SkwempyrEcJk1dLF5owTCe3Wv6.jpg","runtime":88.0,"title":"Wo ist die Liebe hin?","type":"movie","va":0.0,"vc":0,"year":"2020"},"movie:928730":{"cast":[{"id":1182590,"name":"岸井ゆきの","photo":"/fjEBGShTFv62P8znolt3dcCGCVj.jpg"},{"id":33134,"name":"Tomokazu Miura","photo":"/2tKusMF6dzGOfH7MM73FCsJzRoJ.jpg"},{"id":1014998,"name":"三浦誠己","photo":"/7s42GpmTNLWe8r3MSafDebGa5wK.jpg"},{"id":2145148,"name":"松浦慎一郎","photo":"/h7LVT8jYTV8MHYu3N0QPwnoq0QB.jpg"},{"id":3065215,"name":"佐藤緋美","photo":"/sBHUVDg82HbAQeEtqraTVwhgiBV.jpg"},{"id":1029726,"name":"中島ひろ子","photo":"/gAnmmCCbzoSEraW1ehh4Bhlj1Ps.jpg"},{"id":1551472,"name":"Nobuko Sendo","photo":"/e2MCFCkMWxSn2vpgBKBvzSPDFFd.jpg"},{"id":3319303,"name":"Nana Nakahara","photo":"/uehmt2x0sCfsUpz5t8JsTmyk8fX.jpg"}],"directors":[{"id":2223841,"name":"三宅唱"}],"genres":["Drama"],"id":928730,"original":"ケイコ 目を澄ませて","overview":"","poster":"/jacXaxDsjtj8sFC3GYglH1UDPk3.jpg","runtime":99.0,"title":"ケイコ 目を澄ませて","type":"movie","va":6.8,"vc":65,"year":"2022"},"movie:980372":{"cast":[],"directors":[{"id":2061321,"name":"Laurent Portes"}],"genres":["Dokumentarfilm","Historie"],"id":980372,"original":"La guerre de Troie a bien eu lieu","overview":"","poster":"/utwAanji3wIzWB3u16mBxKG301I.jpg","runtime":0.0,"title":"La guerre de Troie a bien eu lieu","type":"movie","va":6.2,"vc":2,"year":"2021"},"movie:985506":{"cast":[],"directors":[{"id":3274690,"name":"Laurent Huberson"},{"id":3160467,"name":"Virginie Kahn"}],"genres":["Dokumentarfilm","Kriegsfilm"],"id":985506,"original":"1940-1944 : de Gaulle seul contre tous","overview":"","poster":"/v3Ds1pEFLaD2UKwJUPwjNkm3AEK.jpg","runtime":56.0,"title":"1940-1944 : de Gaulle seul contre tous","type":"movie","va":0.0,"vc":0,"year":"2022"},"movie:985883":{"cast":[{"id":74376,"name":"Cem Yılmaz","photo":"/n8J3f4Ua0FWM29icutaKcg6PxFJ.jpg"},{"id":