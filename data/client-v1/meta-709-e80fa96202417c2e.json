enres":["Drama"],"id":285937,"original":"Jal","overview":"","poster":"/OFWT8XZN7D7Q5y6J4kG9gWkwNu.jpg","runtime":126.0,"title":"Jal","type":"movie","va":7.2,"vc":8,"year":"2014"},"movie:318954":{"cast":[{"id":1450535,"name":"Andrew Cheney","photo":"/whVhKrtMneOWD1NRtWNwql0oRed.jpg"},{"id":1371298,"name":"Kara Killmer","photo":"/bfiSQa9YZXrYhlXgKazWc4jtoqD.jpg"},{"id":655,"name":"John Rhys-Davies","photo":"/qpXl1YnqQsUKYEDm3BB2zK5wbhe.jpg"},{"id":208096,"name":"Adetokumboh M'Cormack","photo":"/p8yvhgwB1L9JlKf2mhRjgwIQsei.jpg"},{"id":1123012,"name":"Alan Madlane","photo":"/q0TmaTOrrzEJw37tvMUOP7QyS7d.jpg"},{"id":163515,"name":"Steve Blackwood","photo":""},{"id":1452207,"name":"Thomas D. Mahard","photo":"/wN2FIlyUv5fNExaSgCk4NZGWVUM.jpg"},{"id":113693,"name":"Samrat Chakrabarti","photo":"/yBbJLufuA5Rxy7jhqWHxgMBT2hm.jpg"}],"genres":["Action","Abenteuer","Drama"],"id":318954,"original":"Beyond the Mask","overview":"Ein Söldner der British East India Company hat sich in die amerikanischen Kolonien gerettet, nachdem sein Arbeitgeber ein falsches Spiel mit ihm getrieben hat. Er unternimmt alles, um seinen Namen wieder reinzuwaschen, nimmt eine neue Identität an, setzt eine Maske auf, und hofft seinen ehemaligen Arbeitgeber überführen zu können. Als seine Vergangenheit ihn einholt, muss er das Vertrauen seiner geliebten Charlotte zurück gewinnen, die er ebenso belogen hat, wie einen gewissen Benjamin Franklin. Ein Wettlauf gegen die Zeit beginnt, den er nicht verlieren darf. Die Zukunft einer ganzen Nation, die gerade erst geboren wird, steht auf dem Spiel.","poster":"/vjT9b9APDdR1akhJQC0ykppnxgM.jpg","runtime":103.0,"title":"Der Mann hinter der Maske","type":"movie","va":5.5,"vc":106,"year":"2015"},"movie:319966":{"cast":[{"id":1229136,"name":"Barney Frank","photo":"/u5r3vdh4AnjLx5VB1COFUJOrf9a.jpg"},{"id":1633782,"name":"Spencer Bachus","photo":""},{"id":1238771,"name":"Mike Barnicle","photo":""},{"id":1633783,"name":"Neil Barofsky","photo":""},{"id":123997,"name":"Dustin Lance Black","photo":"/fFTO10hKeZ2286i72a7GFPaM2Q5.jpg"},{"id":1633784,"name":"Steve Elmendorf","photo":""},{"id":1633785,"name":"Charles Halpern","photo":""},{"id":1633786,"name":"Susan Halpern","photo":""}],"genres":["Dokumentarfilm"],"id":319966,"original":"Compared To What: The Improbable Journey of Barney Frank","overview":"","poster":"/pvTCcsIh9noumUBnjkGD2HsB7qp.jpg","runtime":87.0,"title":"Compared To What: The Improbable Journey of Barney Frank","type":"movie","va":5.9,"vc":7,"year":"2014"},"movie:325789":{"cast":[{"id":17419,"name":"Bryan Cranston","photo":"/7Jahy5LZX2Fo8fGJltMreAI49hC.jpg"},{"id":9824,"name":"Diane Kruger","photo":"/o5gVowcjVw4ThYi0L3883Y4X7kH.jpg"},{"id":5723,"name":"John Leguizamo","photo":"/kwYCdxTlDh9zauUCg4mp2XTCQTw.jpg"},{"id":1670,"name":"Daniel Mays","photo":"/2qmA5mXnhA7Nelu2BTbJTvzq35u.jpg"},{"id":4589,"name":"Benjamin Bratt","photo":"/hBenHPT4iJEG2kt5z2TOGnkRZwh.jpg"},{"id":39388,"name":"Amy Ryan","photo":"/rE0YBJr3R6GcKu6Gw4K2lGW0ctC.jpg"},{"id":3623,"name":"Elena Anaya","photo":"/hSkjzOfvRQ8DUJdhWveIKgRlyXb.jpg"},{"id":225610,"name":"Joseph Gilgun","photo":"/A8wFwzX8ejdfgeNG7OPbz87ZCrs.jpg"}],"genres":["Krimi","Drama","Thriller"],"id":325789,"original":"The Infiltrator","overview":"In den 80er Jahren arbeitet der Agent der US-Drogenvollzugsbehörde Robert Mazur fünf Jahre lang als schmieriger Geschäftsmann Bob Musella undercover und wäscht Geld für das internationale Verbrechen. Mazur dringt dabei bis in die innersten Kreise des organisierten Verbrechens vor. Dabei unterstützen ihn Kathy Ertz, die sich als seine Verlobte ausgibt, sowie sein Agenten-Kollege Emir Ebreu Gemeinsam ermitteln sie gegen kriminelle Banker und Geschäftsleute, die ihren Einfluss auf der ganzen Welt ausüben und milliardenschwere Drogengeschäfte tätigen. Die in dieser Zeit gesammelten Erkenntnisse setzt Mazur später ein, um die weltweit größten Kartelle zu stürzen - darunter auch den berühmt-berüchtigten Drogenbaron Pablo Escobar, mit dessen rechter Hand Roberto Alcaino  er sich zuvor anfreundet...","poster":"/f2jS04SfTW9APAJDDQIsmcaJML1.jpg","runtime":127.0,"title":"The Infiltrator","type":"movie","va":6.7,"vc":1902,"year":"2016"},"movie:3573":{"cast":[{"id":12052,"name":"Gwyneth Paltrow","photo":"/r4wbWWEEjmtRFZ0GU10XbLTgp47.jpg"},{"id":18325,"name":"Jeremy Northam","photo":"/lnvV2sEAl1oUkUuUEr51UjxIuRr.jpg"},{"id":3051,"name":"Toni Collette","photo":"/lzXRh16qe4HHeBN6tMyw0DHvaMn.jpg"},{"id":10697,"name":"Alan Cumming","photo":"/axil8ufunARfqyU4ceZNh36fkVQ.jpg"},{"id":3061,"name":"Ewan McGregor","photo":"/q2UDxfwWnmXTB7khOUF3J9puBVP.jpg"},{"id":21245,"name":"Greta Scacchi","photo":"/kgWjsnt0SWrypL6vkGQijJNkgS0.jpg"},{"id":32990,"name":"Sophie Thompson","photo":"/tRPHovRBLwZTeWodLBqUD2arrlH.jpg"},{"id":6238,"name":"Juliet Stevenson","photo":"/qiS6E7t5EbqRpWToggQwC3xIdDF.jpg"}],"genres":["Liebesfilm","Komödie","Drama"],"id":3573,"original":"Emma","overview":"Emma Woodhouse sucht einen Mann für ihre Freundin Harriet und merkt nicht, daß sie selbst verliebt ist. Mrs. Weston: Emmas ehemalige Lehrerin. Dank Emmas Hilfe jetzt glücklich verheiratet. Mr. Elton: Harriet sehnt sich nach diesem Snob, der aber nur für Emma Augen hat. Mr. Knightley: Emmas Schwager, Freund, Vertrauter und vielleicht auch mehr? Mr. Churchill: Wen wird dieser begehrte Junggeselle zur Frau nehmen? Jane Fairfax taucht überraschend auf und verzaubert alle Männer. Mr. Martin: Ist dieser einfache Farmer wirklich der Richtige für Harriet? Harriet Smith: Emma will sie mit Mr. Elton verkuppeln, und als der Emma den Hof macht, mit Mr. Churchill. Aber Harriet verliebt sich in Mr. Knightley – sehr zu Emmas Kummer. Eine bezaubernde Komödie nach Jane Austen's Klassiker.","poster":"/s8DBIitsNoKHv3FyCfqA2ZlFtWd.jpg","runtime":107.0,"title":"Jane Austens Emma","type":"movie","va":6.6,"vc":694,"year":"1996"},"movie:4723":{"cast":[{"id":18918,"name":"Dwayne Johnson","photo":"/5QApZVV8FUFlVxQpIK3Ew6cqotq.jpg"},{"id":57599,"name":"Seann William Scott","photo":"/Afti