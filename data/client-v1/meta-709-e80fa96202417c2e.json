pdJS4ry0hr7tlvoHpeEh.jpg"},{"id":1211316,"name":"Jahar Roy","photo":"/1oqJHimc76xJ1UIa8LT9NI0Ywyz.jpg"}],"genres":["Drama"],"id":631978,"original":"এখানে পিঞ্জর","overview":"","poster":"/bj2XomNVAWbwxzhjudwsbV9boO4.jpg","runtime":153.0,"title":"এখানে পিঞ্জর","type":"movie","va":0.0,"vc":0,"year":"1971"},"movie:656968":{"cast":[{"id":529,"name":"Guy Pearce","photo":"/vTqk6Nh3WgqPubkS23eOlMAwmwa.jpg"},{"id":1333,"name":"Andy Serkis","photo":"/eNGqhebQ4cDssjVeNFrKtUvweV5.jpg"},{"id":1115,"name":"Stephen Graham","photo":"/yguEO9zFvuccq87kOJpFLsmUgvs.jpg"},{"id":1496392,"name":"Joe Alwyn","photo":"/jAdaAeaDVYWlU8I5X5p5DuUI8Ii.jpg"},{"id":21679,"name":"Vinette Robinson","photo":"/bGX5h30ozEZb5PQuNrXt0gbOcQF.jpg"},{"id":973,"name":"Jason Flemyng","photo":"/nYl0180ACnLzVlGbaAfuPtdGr9K.jpg"},{"id":115679,"name":"Charlotte Riley","photo":"/cTZ8RhEk67OtOa4yosJLA4l5v5r.jpg"},{"id":32300,"name":"Johnny Harris","photo":"/6W9SJ8ebalDAqZNhfYCOzThycF5.jpg"}],"genres":["Drama","Fantasy"],"id":656968,"original":"FX's A Christmas Carol","overview":"Ebenezer Scrooge ist ein geiziger Unternehmer im London des Viktorianischen Zeitalters. Da er schon sich selbst keinen Komfort gönnt, ist er auch gegenüber seinen Angestellten sehr knauserig. Das wird zum Weihnachtsfest deutlich, als er nicht nur keine Geschenke macht, sondern auch einfordert, dass die Angestellten an den feierlichen Tagen zur Arbeit erscheinen. Des Nachts wird er vom Geist seines ehemaligen Geschäftspartners Jacob Marley heimgesucht. Drei Geister gewähren Scrooge einen Blick auf das Weihnachtsfest seiner Jugend, das aktuelle Fest aus den Augen seiner Angestellten und auch einen Ausblick auf eine grimme Zukunft.","poster":"/Aml2ZwT2Om8o0uLEx8w7jQF5Jzu.jpg","runtime":173.0,"title":"A Christmas Carol","type":"movie","va":7.2,"vc":221,"year":"2019"},"movie:698948":{"cast":[{"id":110,"name":"Viggo Mortensen","photo":"/vH5gVSpHAMhDaFWfh0Q7BG61O1y.jpg"},{"id":72466,"name":"Colin Farrell","photo":"/5FdalJbrbZ5UCsED5rFrXpvbqJa.jpg"},{"id":33192,"name":"Joel Edgerton","photo":"/r2TTDZ8cG5wrZqx7Drz1M95S9z3.jpg"},{"id":1364004,"name":"Tom Bateman","photo":"/6elQzmY4EJHlLvHsaeoeo2dXOQ1.jpg"},{"id":55866,"name":"Paul Gleeson","photo":"/dgup9t4MlDzDf8GlQwBeqj61Nqn.jpg"},{"id":1809208,"name":"ธีรดนย์ ศุภพันธุ์ภิญโญ","photo":"/vgpjzR4Hitaw8p2sj6VHwUrhTJZ.jpg"},{"id":3657642,"name":"Girati Sugiyama","photo":""},{"id":2661136,"name":"Pasakorn Hoyhon","photo":""}],"genres":["Drama","Thriller"],"id":698948,"original":"Thirteen Lives","overview":"Es sollte ein unvergesslicher Ausflug für das Jungen-Fußballteam und ihren Trainer werden. – Auf einem gemeinsamen Trip durch Thailand beschließt die Mannschaft, eine Exkursion zu einer unterirdischen Höhle zu unternehmen. Auf der Suche nach Abenteuer und Spannung macht sich die Gruppe auf, den beeindruckenden Naturschauplatz zu besichtigen. Obwohl sie zuvor gewarnt wurde, dass heftige Regenfälle drohen und das Unterfangen zu einer gefährlichen Angelegenheit machen, lassen sie sich nicht aufhalten. Die Warnung kam nicht grundlos: Als die Mannschaft und ihr Trainer in der Höhle sind, setzt der Regen ein und flutet die Höhle. Eine der weltweit aufsehenerregendsten Rettungsmissionen beginnt.  Basierend auf der wahren Begebenheit der thailändischen Tham-Luang-Höhlenrettung im Jahr 2018.","poster":"/zpkd8ZNGmFo93efN7u7wiIRsXDx.jpg","runtime":147.0,"title":"Dreizehn Leben","type":"movie","va":7.8,"vc":1627,"year":"2022"},"movie:785585":{"cast":[{"id":1115225,"name":"ദുൽഖർ സൽമാൻ","photo":"/cKngC3leAnZRXTzg0N8N2DYn4HY.jpg"},{"id":1643582,"name":"Sobhita Dhulipala","photo":"/cV5JtQKtkOyv3SVMhsv0Db7zYGI.jpg"},{"id":448468,"name":"Indrajith Sukumaran","photo":"/32YxjXVmgkPCVKUQAkNqWUGbBIl.jpg"},{"id":1263974,"name":"Tovino Thomas","photo":"/uySCXY4TZxEDcVJD8WOjDQmMHc9.jpg"},{"id":1296632,"name":"Shine Tom Chacko","photo":"/lIfhgkTK8bgM5jS2R91ZvCxKIwj.jpg"},{"id":1071565,"name":"Sunny Wayne","photo":"/hDItNlwPcxDLHzSKDUYoEztp2yo.jpg"},{"id":1150850,"name":"P Balachandran","ph