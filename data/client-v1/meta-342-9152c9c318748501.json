vanni Ribisi","photo":"/8EAiS9D3YtGOrwNM0OrwmDpWK7s.jpg"},{"id":21044,"name":"Lynn Collins","photo":"/ajPwDxFs3D0gbsaphHyB0ufWc3V.jpg"},{"id":1894,"name":"Scott Caan","photo":"/hX5X4K7BfzOOGcxiNQ24EpPZrfC.jpg"},{"id":8211,"name":"Mena Suvari","photo":"/xjqKvy0bos02oSKNYzC4mxLbQ0W.jpg"},{"id":164945,"name":"Sarah Shahi","photo":"/shiLCJNyvi9xlUZw4bTuRkhrKpm.jpg"},{"id":18472,"name":"Kevin Corrigan","photo":"/obSUGc68mQDvFONalMg25Xw5GZM.jpg"},{"id":83522,"name":"Tito Ortiz","photo":"/ivG0rCc5FE1XWdh6CIBTWfeIgBk.jpg"},{"id":82013,"name":"Kimo Leopoldo","photo":""}],"genres":["Komödie","Liebesfilm"],"id":14848,"original":"The Dog Problem","overview":"","poster":"/hErQSzvfemQDawgMvbNmN1UgcCA.jpg","runtime":88.0,"title":"The Dog Problem","type":"movie","va":6.1,"vc":60,"year":"2006"},"movie:27958":{"cast":[{"id":1158,"name":"Al Pacino","photo":"/m8HAAjq1T75JypKk0v1FFQn4ysZ.jpg"},{"id":7004,"name":"Paul Sorvino","photo":"/1gF0UskusEdDcNaBDJ2CMsz5Agi.jpg"},{"id":650,"name":"Karen Allen","photo":"/eJszpndpRzrXbSlz7RUlApoTykn.jpg"},{"id":31186,"name":"Richard Cox","photo":"/1bbFNMCqaVp5wHwaojM4w4itkPh.jpg"},{"id":93419,"name":"Don Scardino","photo":"/3yGJ8GcYZLURUweqmYhC77QyA1K.jpg"},{"id":16525,"name":"Joe Spinell","photo":"/rdDEi8SJSx9OwVJQaHNa3VfZBRM.jpg"},{"id":42547,"name":"Jay Acovone","photo":"/ltaJoC5NUsE97f3GuP3d7BkANKJ.jpg"},{"id":94766,"name":"Gene Davis","photo":"/lqV4IB94P79wjypkjqHd41Sffj4.jpg"}],"genres":["Krimi","Mystery","Thriller"],"id":27958,"original":"Cruising","overview":"Eine brutale Mordserie verbreitet Angst und Schrecken in New Yorks schwuler Lederszene. Der sadistische Täter scheint aus den eigenen Reihen zu kommen. Der Polizist Steve Burns wird beauftragt, in die Szene einzutauchen und den Lockvogel zu spielen, da er äußerlich dem Typus der Mordopfer entspricht. Für den heterosexuellen Burns beginnt eine Reise in eine unbekannte Welt, die ihn in seiner sexuellen Identität verunsichert. So bahnt sich eine Freundschaft zwischen ihm und seinem schwulen Nachbarn Ted an, was zu einer Eifersuchtsszene mit Teds Freund führt. Die Ermittlungen belasten auch seine Beziehung zu seiner Freundin, weshalb sich beide vorübergehend trennen. Ein erster Tatverdächtiger, der während des Verhörs eingeschüchtert und verprügelt wird, entpuppt sich als unschuldig. Schließlich kann Burns den vermutlichen Mörder dingfest machen, aber der Film deutet an, dass sich die Mordserie fortsetzen und Burns nicht von der SM-Szene loskommen wird.","poster":"/aWpiguhLp6ZIrJMj1i5hj4m0m9u.jpg","runtime":101.0,"title":"Cruising","type":"movie","va":6.6,"vc":671,"year":"1980"},"movie:48481":{"cast":[{"id":99754,"name":"William Phipps","photo":"/g9470NcR184oPHn1K8sHAJBA7R1.jpg"},{"id":140583,"name":"Susan Douglas","photo":"/h2KVqid6caIuk3UvrZOp7pYgD0u.jpg"},{"id":8498,"name":"James Anderson","photo":"/hgoa30VXmgCy3Pyon2lNcKPrYXJ.jpg"},{"id":140584,"name":"Charles Lampkin","photo":"/ucRCH7TBjVLlqKyGIs8R6gQR33B.jpg"},{"id":140585,"name":"Earl Lee","photo":""}],"genres":["Science Fiction","Drama"],"id":48481,"original":"Five","overview":"Fünf Menschen verschiedener Rassen und unterschiedlicher politischer Überzeugungen überleben eine atomare Katastrophe. Strahlenkrankheit und mörderische Auseinandersetzungen fordern drei weitere Opfer. Allein Überlebende sind die charakterlich und körperlich Stärksten - ein Mann und eine Frau mit neugeborenem Baby; sie werden die Erde wieder bevölkern. Verquaster, geschwätziger utopischer Film mit einer fragwürdigen Elite-Ideologie.","poster":"/awMJBJpywUl7u75rLGohrRZ41wl.jpg","runtime":93.0,"title":"Die letzten Fünf","type":"movie","va":6.6,"vc":42,"year":"1951"},"movie:70006":{"cast":[{"id":64856,"name":"Michael Jai White","photo":"/YPoHYuzR37wFpPpwEXZYQlhLln.jpg"},{"id":557804,"name":"Gralen Bryant Banks","photo":"/mLxMcf6IoX6e0K1YpERdKY4t0Hc.jpg"},{"id":84217,"name":"Alex Meraz","photo":"/6ExBib0bOPaNzOeLOqJHgETCjl2.jpg"},{"id":557803,"name":"Stacey Asaro","photo":""},{"id":52483,"name":"Rus Blackwell","photo":"/hdW