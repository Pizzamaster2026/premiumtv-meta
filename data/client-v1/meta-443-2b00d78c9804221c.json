"/6mVjb0YsidC0gW9P8mXMkQirfcK.jpg"},{"id":2390,"name":"LeVar Burton","photo":"/tC74tISKpFGmJkrw24MMLix5nNa.jpg"}],"genres":["Dokumentarfilm"],"id":15800,"original":"Trekkies","overview":"Machen Sie sich bereit, um in eine Galaxie hochzubeamen, in der es Autogrammjäger, Zahnärzte in Sternenflottenuniform gibt und die Debatte um Trekkies oder Trekker geht weiter. Denise Crosby aus Star Trek: Das nächste Jahrhundert zeigt Ihnen diese oftmals urkomische Dokumentation über das Star Trek \"Fan\"-omen. Sie interviewte Hunderte von ergebenen Fans und Serienschauspieler, wie Leonard Nimoy, DeForest Kelley, Nichelle Nichols, Walter König, Kate Mulgrew und Brent Spiner. Der Film zeichnet ein unterhaltendes und liebenswürdiges Porträt dieser Ausnahmeserie, die das Leben vieler Menschen auf der ganzen Welt beeinflusst hat.","poster":"/o6MYZAcI2A7VfJkcIvCDbFPISLP.jpg","runtime":86.0,"title":"Trekkies","type":"movie","va":6.3,"vc":69,"year":"1997"},"movie:1676318":{"cast":[{"id":4071707,"name":"Jacob Rott","photo":"/yW0cienzeDOh4WzRgzYx5da9HHO.jpg"},{"id":5759597,"name":"Luis Freitag","photo":"/oxRp4WXWeuBbXEvlcWNTE9snOUI.jpg"},{"id":3859394,"name":"Bene Schulz","photo":"/43wvDDjoE2f46sxklkkf0FtGmle.jpg"},{"id":6151805,"name":"Julien Brown","photo":""},{"id":4398212,"name":"Tim Schäcker","photo":"/jyVXNRvEIUXrfpBXeCnQlg4T5TY.jpg"},{"id":4666474,"name":"Anja Pichler","photo":"/bV2kzhfVsgAE4IzgFih3ekAtGYg.jpg"},{"id":1357394,"name":"Luise Aschenbrenner","photo":"/piipXN00MaTNl6J3UsfsvGjcjh7.jpg"},{"id":4313041,"name":"Sidney Fahlisch","photo":"/k4NyWz5gEFb1UijBvEnW99GL9Gz.jpg"}],"genres":["Komödie","Liebesfilm","Musik"],"id":1676318,"original":"Back to the 90s","overview":"Eine aufstrebende Boyband landet durch einen Glitch plötzlich im Jahr 1995. Um es rechtzeitig zum größten Auftritt ihres Lebens zurück in die Zukunft zu schaffen, müssen sie den Zeitsprung irgendwie nachstellen - doch was als Missgeschick beginnt, wird zu einer berührenden Geschichte über Freundschaft, Musik und eine große Liebe, die alles auf den Kopf stellt.","poster":"/2T0j25ofU6aUei6J6ek2hlTL1wc.jpg","runtime":91.0,"title":"Back to the 90s","type":"movie","va":5.9,"vc":32,"year":"2026"},"movie:18498":{"cast":[{"id":104926,"name":"Peter Liapis","photo":"/mjlZqBCQpfjfdVUEvIcWKqpmwhc.jpg"},{"id":115888,"name":"Lisa Pelikan","photo":"/9pA1C6RTJ9OT2S0J2xeOKxVqvl4.jpg"},{"id":65334,"name":"Michael Des Barres","photo":"/1XVPUgGP7xJC7IP4ALNltHx2C1c.jpg"},{"id":5147,"name":"Ralph Seymour","photo":"/p7mAxGF0n94491Rsc49M70OxIaE.jpg"},{"id":152765,"name":"Victoria Catlin","photo":"/btTgIolnYum88TnFKsUocfeGTjH.jpg"},{"id":2743617,"name":"Keith Joe Dick","photo":"/idQ2KxF4SY5tiPPEBvcvcLw9Vcs.jpg"},{"id":3711578,"name":"Charene Cathleen","photo":"/AtELFltDGRH9NgWMxQaVAyQc9Jq.jpg"},{"id":6718,"name":"Jack Nance","photo":"/uYZ2D1gb7lO779L5nDn8XarZSvf.jpg"}],"genres":["Horror","Komödie"],"id":18498,"original":"Ghoulies","overview":"Jonathan Grave erbt an seinem achtzehnten Geburtstag einen alten Landsitz. Er ahnt nicht, das dort vor vielen Jahren sein Vater den bösen Mächten verfallen ist und Dämonenbeschwörungen abhielt. Mehr durch Zufall verfällt Jonathan denselben Mächten und fängt ebenfalls an, die Dämonen zu beschwören. Die Ghoulies, kleine grüne Monster, tauchen auf und auch Jonathans toter Vater kehrt zurück, um wieder die Macht zu übernehmen…","poster":"/yV8z6deULhH4oJAUj2YdhITPwfc.jpg","runtime":77.0,"title":"Ghoulies","type":"movie","va":4.9,"vc":311,"year":"1984"},"movie:22972":{"cast":[{"id":1892,"name":"Matt Damon","photo":"/aCvBXTAR9B1qRjIRzMBYhhbm1fR.jpg"},{"id":17141,"name":"Greg Kinnear","photo":"/iJezGc9XjY0DFPs00SypkuKImFK.jpg"},{"id":2039,"name":"Brendan Gleeson","photo":"/ctPPJu5ZYDZr1IPmzoNpezczrm0.jpg"},{"id":39388,"name":"Amy Ryan","photo":"/rE0YBJr3R6GcKu6Gw4K2lGW0ctC.jpg"},{"id":53480,"name":"Khalid Abdalla","photo":"/iYRhheaol1T19Qy8a8pTIPk9COK.jpg"},{"id":11355,"name":"Jason Isaacs","photo":"/s6XRFjqUsrDJfDQuXPOoExAYPmb.jpg"},{"id":41316,"name":"יגאל נאור","photo":"/ttVDrNvtOKBIoGIhJbZ2QzK52pu.jpg"},{"id":109670,"name":"Said Faraj","photo":"/svC8PC5NRXeBcKogGiKXsUCvrd8.jpg"}],"genres":["Kriegsfilm","Action","Abenteuer","Drama","Thriller"],"id":22972,"original":"Green Zone","overview":"2003 im Irak: Kurz nach der Eroberung Bagdads durch die USA rückt der US-Armee-Offizier Roy Miller mit seinem Team an, um die besetzten Gebiete zu kontrollieren. Diese abgesicherte \"Green Zone\" müssen sie bald darauf verlassen, um einer Spur nachzugehen, die sie zu Massenvernichtungswaffen führen soll. Doch die Fährte führt in eine Sackgasse: Sie stoßen nur auf Sprengfallen. Nach und nach stellt Roy Miller mit sein Team fest, dass sie nur Marionetten in einer ausgefeilten Verschwörung sind.","poster":"/czFIaeukSxNEccysQeys1PCkuOG.jpg","runtime":115.0,"title":"Green Zone","type":"movie","va":6.5,"vc":2507,"year":"2010"},"movie:28431":{"cast":[{"id":41235,"name":"Stewart Granger","photo":"/1DDF3dXe7nKVWqGX9HEvQyMHaHr.jpg"},{"id":20141,"name":"Deborah Kerr","photo":"/dHFhOEhHnn5cQjQN29IGRxzoxBP.jpg"},{"id":2091,"name":"James Mason","photo":"/vCABivuMBCT78sh5G0q8jO5rkT.jpg"},{"id":4343,"name":"Louis Calhern","photo":"/80l4tBYFQ08GLFk9wjilThyM8H.jpg"},{"id":10159,"name":"Jane Greer","photo":"/eqnPmly09oLsaRdzShzXuOtiF3P.jpg"},{"id":29259,"name":"Lewis Stone","photo":"/4RqVHEfQVLPMYHBkmMoUvVdduMP.jpg"},{"id":33484,"name":"Robert Douglas","photo":"/4UGnE8M7DiIxt8v47UyeQLFCCRU.jpg"},{"id":92908,"name":"Robert Coote","photo":"/sBzxbysXMqlLr82n5rV61SAkett.jpg"}],"genres":["Abenteuer"],"id":28431,"original":"The Prisoner of Zenda","overview":"Es ist am Vorabend der Krönung Rudolfs V. von Ruritanien. Der designierte König trifft auf der Jagd Rassendyll, einen jungen Engländer, der ihm gleicht wie ein Ei dem anderen. Sie trinken um die Wette. Rudolf gewinnt zwar, wird aber am nächsten Morgen bewusstlos aufgefunden. Irgendjemand muss ihm etwas in den Wein getan haben. Wie sich herausstellt, war das Rudolfs Stiefbruder Michael, der selber nach der Krone und der zukünftigen Königin Flavia strebt. Rudolfs Gefolgsleute sehen nur einen Ausweg: Solange der rechtmäßige Thronfolger nicht bei Sinnen ist, soll Rassendyll dessen Rolle spielen. Der lässt sich dazu überreden, wird König und bekommt Flavia zur Frau. Außer den wenigen Eingeweihten kennt keiner die wahre Identität des neuen Herrschers, selbst Flavia merkt nichts. Sie hatte Rudolf, ihren Zukünftigen, bisher wohl nur flüchtig gekannt.","poster":"/bFZs5ahPvTrYEi6cWydYsmHrrVG.jpg","runtime":90.0,"title":"Im Schatten der Krone","type":"movie","va":6.9,"vc":60,"year":"1952"},"movie:28512":{"cast":[{"id":2059,"name":"Adam Baldwin","photo":"/lfbyJWNWGbiYfU0Yr1tjn6Trd2V.jpg"},{"id":585,"name":"Rutger Hauer","photo":"/xyag0LbjocTwx2Ht7B3RofvCNMT.jpg"},{"id":26472,"name":"Steve Guttenberg","photo":"/ghTMepliFNcRQHNELs8pgNDsZyW.jpg"},{"id":29092,"name":"Bryan Brown","photo":"/x0NqVqpJSET0oVdJxbbwwd7hrFA.jpg"},{"id":2878,"name":"C. Thomas Howell","photo":"/739YbFWpAYyo9neHvBGThgmT4YH.jpg"},{"id":27811,"name":"Peter Weller","photo":"/mVRJX38zabRadVPJe0XOTObVzhp.jpg"},{"id":83701,"name":"Alex Kingston","photo":"/pBK1qMZEFkRAFcfdLb7Z28f6qd2.jpg"},{"id":100649,"name":"Alexa Hamilton","photo":"/tgFXzmEFXE6oL1uFaLvnW9i82c0.jpg"}],"genres":["Abenteuer","Thriller","Action","TV-Film"],"id":28512,"original":"The Poseidon Adventure","overview":"Auf dem Kreuzfahrtschiff Poseidon verbringt die Manschaft Weihnachten und freut sich bereits auf das neue Jahr. Doch einige jordanische Terroristen bringen im Maschinenraum Sprengstoff an und zünden diesen. Dadurch gerät das Schiff ins Schlingern und Kentert. Angeführt vom römisch-katholischen Bischof Schmitt machen sich die Überlebenden auf den Weg nach oben in den Maschinenraum. Am Ende befreit sich die Gruppe mit Hilfe eines nicht explodierten Fasses Sprengstoff der Terroristen, in dem sie ein Loch in den Rumpf sprengen und draußen zu den Rettern stoßen, die vom Land aus von Suzanne Harriso koordiniert wurden.","poster":"/heqrD8MxncBaAWVn3QtaM