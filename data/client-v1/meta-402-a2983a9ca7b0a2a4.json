ie gekümmert hat und beginnt auf eigene Faust zu ermitteln. Healy bittet ihn nach Boston. Er hat einen geständigen Raubmörder festgenommen, glaubt aber nicht, dass er die Tat begangen hat. Jesse soll ihm bei der Aufklärung helfen.","poster":"/z9cTxUt0inJ6TlXCfTZOH7tR6wg.jpg","runtime":90.0,"title":"Jesse Stone - Verlorene Unschuld","type":"movie","va":6.5,"vc":88,"year":"2011"},"movie:83817":{"cast":[{"id":19021,"name":"Kay Johnson","photo":"/qwSqdoA8QYtQSEbryYHVr1Pd2Nx.jpg"},{"id":3364,"name":"Reginald Denny","photo":"/wbR5zRDwZpDqDwuoW5hSQbIptHW.jpg"},{"id":136920,"name":"Lillian Roth","photo":"/8KRJZyHBIl9MG7Pi0VKuhEU7pbY.jpg"},{"id":14685,"name":"Roland Young","photo":"/hme2CvDcGqdZEsPKcdvhjgEvvDl.jpg"},{"id":1359743,"name":"Elsa Peterson","photo":"/57T0Mp8kvmvLO9S13Yk7eCCLiGB.jpg"},{"id":1806438,"name":"Jack King","photo":""},{"id":1485367,"name":"Eddie Prinz","photo":""},{"id":1186832,"name":"Boyd Irwin","photo":"/bpLCRZqEayIzt12McaOKao2f6AH.jpg"}],"genres":["Liebesfilm","Musik","Komödie"],"id":83817,"original":"Madam Satan","overview":"","poster":"/fMRAu0p3cT1p06TCbPDsjcLgs4O.jpg","runtime":116.0,"title":"Madam Satan","type":"movie","va":6.0,"vc":30,"year":"1930"},"movie:99234":{"cast":[{"id":33004,"name":"Preston Foster","photo":"/fBxlhD0k4N8zAJX1FR4Uuf1MtUy.jpg"},{"id":100589,"name":"John Sutton","photo":"/jdghkEOavykFhmI1kzjsDDDJLmN.jpg"},{"id":20124,"name":"Gene Tierney","photo":"/sexaQ4TPHEnwaiEAGpJDGlmEjF3.jpg"},{"id":93910,"name":"Jack Holt","photo":"/4xfh3Mlpqx8tZ991rhVTov0ILtN.jpg"},{"id":14299,"name":"May Whitty","photo":"/xjcKt4OBswpGUSGG0jkgr5fP5r4.jpg"},{"id":30276,"name":"George Barbier","photo":"/dhBDURtUCsFayX2Zx1rglLYgqN1.jpg"},{"id":29283,"name":"Richard Haydn","photo":"/zPaYFZhis7PKycFBMnguWiSXgVy.jpg"},{"id":3364,"name":"Reginald Denny","photo":"/wbR5zRDwZpDqDwuoW5hSQbIptHW.jpg"}],"genres":["Drama","Liebesfilm","Kriegsfilm"],"id":99234,"original":"Thunder Birds","overview":"","poster":"/wVoXOfbk3RakYImBJJt0jbHMhWz.jpg","runtime":78.0,"titl