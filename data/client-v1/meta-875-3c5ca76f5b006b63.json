to":"/5emVgsLFlU6SmeBIFsF2Y7aqwtG.jpg"},{"id":7026,"name":"Rhys Ifans","photo":"/5X8XcIqCDxsQYyHdx7mBwPVkSTs.jpg"},{"id":3349900,"name":"Ethan Jones Romero","photo":"/2flMj8MHqoKdWaCbnEQnlBdyi4j.jpg"},{"id":1695506,"name":"Luke Cosgrove","photo":"/x5w4FcG4Lj17OwQ7LZp2J8ADFDI.jpg"},{"id":2575217,"name":"Jeena Yi","photo":"/o283Yoj3pxaNLMNkARCXiGq48c.jpg"},{"id":1981849,"name":"Eric T. Miller","photo":"/vHylIzRB3aPwtdJfYVhYzIwj4Mi.jpg"},{"id":4471619,"name":"Anne Marie Kempf","photo":""}],"genres":["Drama","Historie"],"id":895549,"original":"NYAD","overview":"Im Alter von 60 Jahren widmet sich die Schwimmerin Diana Nyad einem fast unmöglichen Lebenstraum: dem Zurücklegen der 177 km von Kuba nach Florida.","poster":"/ydSqUhKFvg5cZ5OwImmf3K1R6SS.jpg","runtime":120.0,"title":"NYAD","type":"movie","va":7.1,"vc":590,"year":"2023"},"movie:916507":{"cast":[{"id":1687058,"name":"Jonas Ems","photo":"/xZrin8Ltrf83ehyFed6HiqQGgBq.jpg"},{"id":3466508,"name":"Sydney Amoo","photo":"/oFxczFWrMghPYkpfyIDomYT6aoo.jpg"},{"id":1958044,"name":"Vivien König","photo":"/lfq1pqv5oBNL60LrAgUpe7gKs7l.jpg"},{"id":3466509,"name":"Kayla Shyx","photo":"/q3MJfR5U0oEgmlkpq1xnmX2yit.jpg"},{"id":2209501,"name":"Dela Dabulamanzi","photo":"/bMft4GCc7wuZy6J541WriyQRhmv.jpg"},{"id":1709025,"name":"Zejhun Demirov","photo":"/zmCncLCPdSngnZ8bHafR6Sgr3pB.jpg"},{"id":1341436,"name":"Patrick Heinrich","photo":"/gjyPIBgSiRxmLtykuYaEiiKZZVL.jpg"},{"id":1591549,"name":"Robert Nickisch","photo":"/qvTBrrD9vAGDvvtJZg1ZpT28edn.jpg"}],"genres":["Komödie"],"id":916507,"original":"Krass Klassenfahrt - Der Kinofilm","overview":"Die 12. Klasse eines Berliner Gymnasiums fährt zu einer Abschlussfahrt nach Kroatien. Doch die Reise beginnt nicht so, wie sie es sich alle vorgestellt haben. Ihre Unterkunft ist ein Eco-Hotel, in dem es nach 18 Uhr keinen Strom mehr gibt und nur eine Steckdose pro Zimmer vorhanden ist. Für die Schüler ein absoluter Albtraum und vor allem ist es nicht Instagram-tauglich. Der erhoffte Strandurlaub und die vielen Partys scheinen sich in Luft aufzulösen. Vor allem für McLarry ist das ein großes Problem, denn er ist der einzige in der Klasse, der sein Abitur nicht bestanden hat und sich durch die Klassenfahrt ein wenig Ablenkung erhofft. Als bekannt wird, dass McLarrys Lieblingsrapper Zeno ebenfalls in Kroatien ist, scheint das die perfekte Gelegenheit für die Schüler zu sein, dem Musiker seine eigenen Songs zu zeigen. Also trennen sich McLarry, Bella, Alena und Cornelious vom Rest der Gruppe und machen sich auf den Weg zu Zenos Villa.","poster":"/9eycS8Yl87iVcU0te57KNAVqKrK.jpg","runtime":98.0,"title":"Krass Klassenfahrt - Der Kinofilm","type":"movie","va":5.5,"vc":18,"year":"2021"},"movie:925714":{"cast":[{"id":17882,"name":"Isabelle Huppert","photo":"/wGG9v1Uci3sfrbjt0bRXkLrTqjY.jpg"},{"id":223532,"name":"Grégory Gadebois","photo":"/AvF337m0eGL9JLPEgG6Dy1T2Zu4.jpg"},{"id":76820,"name":"Marina Foïs","photo":"/dLPo5cyKoH4Y8TNRkl2GIrd4Oae.jpg"},{"id":5644,"name":"Alexandra Maria Lara","photo":"/68YNY2TfvsE9T3tcCeHDVXbnzyB.jpg"},{"id":1071606,"name":"Pierre Deladonchamps","photo":"/egIMzrrjVXVTMVsp7nrIXIfP7TD.jpg"},{"id":76858,"name":"François-Xavier Demaison","photo":"/u2WWC1YAJuZLLk6Ho4IzhNAozqe.jpg"},{"id":17500,"name":"Gilles Cohen","photo":"/df8YyJdBcritBlohD9AEOQZDsPd.jpg"},{"id":2245,"name":"Yvan Attal","photo":"/ry7ncjRwREdzfNd1kFsrBVSS9NA.jpg"}],"genres":["Thriller","Drama","Mystery"],"id":925714,"original":"La Syndicaliste","overview":"Maureen Kearney wird gefesselt und traumatisiert in ihrer eigenen Wohnung aufgefunden. Vom Täter fehlt jede Spur und sie kann sich nur bruchstückhaft erinnern. Die Ermittler arbeiten unter Hochdruck, denn Maureen war als Gewerkschafterin dubiosen Geschäften in der Atomindustrie auf der Spur, die auch einflussreiche Entscheidungsträger belasten könnten. Da tauchen plötzlich neue Indizien auf, die den Überfall in Frage stellen. Maureen wird vom Opfer zur Verdächtigen.  Nach DIE FRAU MIT BERAUSCHENDEN TALENTEN lässt Regisseur Jean-Paul Salomé die grandiose Isabelle Huppert erneut eine Männerdomäne aufmischen.","poster":"/kLcrEgGHcLuXOw3JWshq6hovK1Q.jpg","runtime":122.0,"title":"Die Gewerkschafterin","type":"movie","va":6.6,"vc":192,"year":"2023"},"movie:955555":{"cast":[{"id":1024395,"name":"Don Lee","photo":"/xqnARIEzfyr3BalhFBWHmCusLKH.jpg"},{"id":1254630,"name":"이준혁","photo":"/hf3Yt9m9SE8I8uaoefDaYdBxwqh.jpg"},{"id":111640,"name":"Munetaka Aoki","photo":"/l5GdFPBBz717Kiimyqp5ieaglVo.jpg"},{"id":86330,"name":"Lee Beom-soo","photo":"/9CSDpnR1gjbulTQdusJMiGc59Ff.jpg"},{"id":573792,"name":"Kim Min-jae","photo":"/hqP15lbCyyGZYDqNJSvrtfPlAkd.jpg"},{"id":2159482,"name":"Lee Ji-hoon","photo":"/nGEQUdliUgn5RuVivan3tmfIQAf.jpg"},{"id":2291087,"name":"Kim Do-gun","photo":"/cchdKEF0Qw1twUQWu1Yu036hKSU.jpg"},{"id":1574622,"name":"Ko Kyu-pil","photo":"/uP18ldneBx5WcmHmvwoyGVSBArY.jpg"}],"genres":["Action","Krimi","Thriller"],"id":955555,"original":"범죄도시 3","overview":"Bestrafen und dienen! Nach diesem Motto will der Prügelpolizist Ma Seok-do von der Seouler Kriminaleinheit den Verbrechern ihre kriminelle Ader austreiben. Die Betonung legt er dabei eindeutig auf bestrafen. Diesmal legt sich Ma mit der japanischen Mafia an, die in Korea mit einer neuartigen Droge das große Geschäft macht. Alle Fäuste voll zu tun für Ma Seok-do!","poster":"/6Vz5T677fER4UDDUI66xVPYsu8F.jpg","runtime":105.0,"title":"The Roundup: No Way Out","type":"movie","va":7.2,"vc":591,"year":"2023"},"movie:999115":{"cast":[{"id":1810686,"name":"Ammy Virk","photo":"/8ZXB6vBqhV3aA0kf6OP4zrmeFsw.jpg"},{"id":2312435,"name":"Tania","photo":"/jmwasWiv15NnS1TTHob319gn2WW.jpg"},{"id":1873388,"name":"Sara Gurpal","photo":""},{"id":1726391,"name":"Hobby Dhaliwal","photo":"/4rbEhi5OHflNc8jtkTIhXgmbRfi.jpg"},{"id":3660443,"name":"Prakash Gaadhu","photo":""},{"id":140636,"name":"Gugu Gill","photo":"/rrh2bW5SleCr1uj32ctIyR0SuUN.jpg"},{"id":1758817,"name":"Parminder Gill","photo":""},{"id":2011177,"name":"Seema Kaushal","photo":"/jEaUjYdZK0iQLVO