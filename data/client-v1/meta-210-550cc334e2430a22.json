:"/mW7xmtGV4y79kQGn0zkKVGDMAmw.jpg"},{"id":6613,"name":"Minnie Driver","photo":"/2uwaHwpoutbXMuYY5v2dhWU0hml.jpg"},{"id":1893,"name":"Casey Affleck","photo":"/304ilSygaCRWykoBWAL67TOw8g9.jpg"},{"id":6614,"name":"Cole Hauser","photo":"/1SNoIDILoXtAUJu4f7nDCPVQH5j.jpg"},{"id":6623,"name":"Vik Sahay","photo":"/690bPfmzaXsrZ1eDcUOCDT5TPpq.jpg"}],"genres":["Drama"],"id":489,"original":"Good Will Hunting","overview":"Der aus einfachen Verhältnissen stammende Will Hunting jobbt als Reinigungskraft am Massachusetts Institute of Technology und keiner ahnt, dass in ihm ein mathematisches Genie steckt. Mühelos löst er die für die Studenten angeschriebenen Aufgaben. Doch als der eigensinnige Will nach einer Schlägerei im Gefängnis landet, liegt sein Schicksal in den Händen des Therapeuten Sean Maguire. Nach und nach findet der exzentrische Psychologe Zugang zu dem verschlossenen jungen Mann und bringt ihn dazu, sich seinen Gefühlen, Ängsten und letztlich auch seiner Zukunft zu stellen.","poster":"/rVyXG2oHFxBctvJ590DMmydJVMw.jpg","runtime":126.0,"title":"Good Will Hunting","type":"movie","va":8.2,"vc":14620,"year":"1997"},"movie:49697":{"cast":[{"id":4959,"name":"Claudia Cardinale","photo":"/gbTVdZGrOwteJ7qYSzyn8XpUk0H.jpg"},{"id":20030,"name":"Jacques Perrin","photo":"/lGbDfSdDgFg3QHgungWIDsV9uh7.jpg"},{"id":128245,"name":"Luciana Angiolillo","photo":"/20fcca5HZssMmLbW9QjMjVrATpx.jpg"},{"id":33549,"name":"Renato Baldini","photo":"/uCLD6wstnzJwO1jny07HA6ymlnW.jpg"},{"id":5968,"name":"Riccardo Garrone","photo":"/9XkHLkB3pWmZ2MstxRZFL58yCrg.jpg"},{"id":123910,"name":"Corrado Pani","photo":"/mdUMFKjM50dG7K1QWXjpebdGdJM.jpg"},{"id":14276,"name":"Gian Maria Volonté","photo":"/xPwxiUgSnvqMvPTm2TlqTUskOJ.jpg"},{"id":5567,"name":"Romolo Valli","photo":"/lO3XrvDrIYC4IL4EamKgAufYsg7.jpg"}],"genres":["Drama","Liebesfilm"],"id":49697,"original":"La ragazza con la valigia","overview":"Nachdem die junge Landschönheit und Sängerin Aida sich vom reichen Playboy Marcello verführen lassen hat, lässt dieser sie eiskalt sitzen und kehrt in die Stadt zurück. Aida will jedoch nicht so leicht aufgeben und macht sich auf dem Weg nach Parma, um Marcello zu suchen. Als sie an der Haustür seines Elternhauses klingelt, lässt Marcello sich verleugnen und schickt seinen jüngeren Bruder Lorenzo vor, um Aida zu sagen, dass sie sich in der Adresse geirrt hätte. Dem sensiblen Lorenzo tut Aida leid und er beschließt sich ihrer anzunehmen, indem er ihr neue Kleider kauft, Geld gibt und gemeinsam mit ihr feiern geht. Schließlich verliebt sich Lorenzo in Aida, die nichts von seiner Identität weiß und ebenfalls eine gewisse Zuneigung für den Teenager entwickelt hat …","poster":"/2HSNQq6jRyclE56FJYMGROYLJho.jpg","runtime":121.0,"title":"Das Mädchen mit dem leichten Gepäck","type":"movie","va":7.1,"vc":119,"year":"1961"},"movie:54884":{"cast":[{"id":9893,"name":"Aurore Clément","photo":"/4riYykNQPf1SwmJZpEHmhSVVbfb.jpg"},{"id":38898,"name":"Jean-Luc Bideau","photo":"/AvGFSbGn5xlI67M0G7m5OG2g6PY.jpg"},{"id":132182,"name":"Delphine Chuillot","photo":"/sQpuuouG8GKErZ4hWS0uFcVJt2X.jpg"},{"id":151177,"name":"Cyril Troley","photo":""},{"id":1945575,"name":"Man Thu","photo":""},{"id":1945576,"name":"Thanh An","photo":""},{"id":1945577,"name":"Michèle Rohrbach","photo":""},{"id":569370,"name":"Quoc Dung Nguyen","photo":""}],"genres":["Drama","Komödie"],"id":54884,"original":"Mon frère se marie","overview":"","poster":"/y4BgrRbiCeqVni0F250Jrq4QVSw.jpg","runtime":91.0,"title":"Mon frère se marie","type":"movie","va":6.5,"vc":6,"year":"2006"},"movie:58686":{"cast":[{"id":1121063,"name":"Στηβ Ντούζος","photo":"/oeemM1UiLIkY8CkwP0lsbYI9WfH.jpg"},{"id":1276429,"name":"Ελένη Φιλίνη","photo":"/7UH4wHl0DLR71N0qgvHCSCRw1Is.jpg"},{"id":1710622,"name":"Νένα Χρονοπούλου","photo":"/ljlXBjIkAfzfTknY9Kd2urXqvi0.jpg"},{"id":1917000,"name":"Αίας Μανθόπουλος","photo":"/maUEjHFCPJzAu56sNYoeFpsoBOl.jpg"},{"id":1916972,"name":"Νίκος Σταγόπουλος","photo":"/hoh2pNB8XJe8dYsG2b7AhV90E2Y.jpg"},{"id":147799,"name":"Κώστας Βουτσάς","photo":"/tLxH1G3BO6jAurQtHR4RDZCbmC7.jpg"},{"id":1917001,"name":"Γιάννης Παπαθανάσης","photo":"/sdG6WTZb7DnCbR2vL9MkxkswzEx.jpg"},{"id":1149682,"name":"Σταύρος Νικολαΐδης","photo":"/hGKvobTvfOKoIIjIyrn3TjJJHlq.jpg"}],"genres":["Komödie"],"id":58686,"original":"Ρόδα Τσάντα Και Κοπάνα","overview":"","poster":"/pAZfjq8sQzS9MqkIwNobgLIaSVd.jpg","runtime":91.0,"title":"Ρόδα Τσάντα Και Κοπάνα","type":"movie","va":2.5,"vc":10,"year":"2011"},"movie:588":{"cast":[{"id":8329,"name":"Radha Mitchell","photo":"/8EVKyEkwPfIA6GxlIo0PJv0A5mm.jpg"},{"id":48,"name":"Sean Bean","photo":"/tAPWubSNDEGzA3AzUAmMiBAZfCe.jpg"},{"id":8338,"name":"Jodelle Ferland","photo":"/6rO3WF9VWfQOpVA7LtbriJmHH7N.jpg"},{"id":8332,"name":"Laurie Holden","photo":"/rRhtmJsZ5IiE0lYrLDmYOCiPK1P.jpg"},{"id":13549,"name":"Deborah Kara Unger","photo":"/kPhYhisjduJ9ztFSwYQ6Ke6qeJy.jpg"},{"id":8335,"name":"Kim Coates","photo":"/brhVd2vTTBJNpM2ZrOFc6SnXCAd.jpg"},{"id":8336,"name":"Tanya Allen","photo":"/noyBY16n50xP1EKH1FPJkca7bul.jpg"},{"id":2506,"name":"Alice Krige","photo":"/jHOknQMjkIqqrm5RjtMCnJfnGXl.jpg"}],"genres":["Horror","Mystery"],"id":588,"original":"Silent Hill","overview":"Als ihre Tochter Sharon sich durch Schlafwandeln in Lebensgefahr bringt und mehrfach davon spricht, in die Stadt Silent Hill zu müssen, bricht Rose mit Sharon gegen den Willen ihres Mannes in die Geisterstadt in West Virginia auf, in der ein unter Tage schwelender Kohlenflözbrand jedes Leben unmöglich gemacht hat. Auf der Fahrt passiert sie jedoch mitsamt der Polizistin Cybil, die sie verfolgt, eine unsichtbare Grenze und betritt ein anderes \"Silent Hill\" - eine unter Ascheregen begrabene Totenstadt, in der sich böse Kräfte phasenweise ausbreiten und in der sich ausbreitenden Finsternis die Lebenden vernichten. Da Sharon beim Übergang verschwunden ist, muß Rose eine Reise in den Terror machen, denn irgendwo in der Stadt sitzt das Böse und hat einen Bezug zu ihrer Tochter, den sie noch nicht kennt. Und kann sie die letzten lebenden Bewohner von Silent Hill retten - oder ist es vielleicht sogar besser, einen Pakt mit dem Bösen einzugehen?","poster":"/2JARLNaROmkc8nRHHl73AlPap2y.jpg","runtime":125.0,"title":"Silent Hill","type":"movie","va":6.6,"vc":5192,"year":"2006"},"movie:68685":{"cast":[{"id":78809,"name":"Rashad Evans","photo":"/fx00k6N013HaHVvLuhJCK6eyCcw.jpg"},{"id":83522,"name":"Tito Ortiz","photo":"/ivG0rCc5FE1XWdh6CIBTWfeIgBk.jpg"},{"id":81514,"name":"Vitor Belfort","photo":"/kRJuA1GEhAzo1FkSj83Ag98y849.jpg"},{"id":85572,"name":"추성훈","photo":"/9wM7b08r1UUdb2wkscNRiE4PbLZ.jpg"},{"id":227572,"name":"Brian Ebersole","photo":"/pbFO1E5O69LEzdtezkWs26QaKCl.jpg"},{"id":86118,"name":"Dennis Hallman","photo":"/sshoBOFjMaLujQiDkGFEZpxR79M.jpg"},{"id":582398,"name":"Constantinos Philippou","photo":"/wX7aowkRuK3TWdkfG5b3ryvcHre.jpg"},{"id":83449,"name":"Jorge Rivera","photo":"/dpFzoCpuDZ8Rtd8Fb1GiunWmWc.jpg"}],"genres":["Action"],"id":68685,"original":"UFC 133: Evans vs. Ortiz","overview":"","poster":"/uLJ5nYHjah3RKywR2PpgoGN9PFf.jpg","runtime":175.0,"title":"UFC 133: Evans vs. Ortiz","type":"movie","va":5.3,"vc":3,"year":"2011"},"movie:78309":{"cast":[{"id":53761,"name":"Christopher Gorham","photo":"/dKFXHJ3KBJaeQ50udMdBEC0VFvI.jpg"},{"id":20373,"name":"Arielle Kebbel","photo":"/c98cwlydVsihduXnq6VLW4fQFC.jpg"},{"id":51382,"name":"Chris Parnell","photo":"/9Ga03Y9TVIqTZJ4I9rfL740ibgJ.jpg"},{"id":88928,"name":"Nelson Franklin","photo":"/2YYnTxpFmS5i9qRkb6H4Nxky2px.jpg"},{"id":65561,"name":"Kip Pardue","photo":"/zWLkC7AodrsZ2jooVMwwBWkAQsB.jpg"},{"id":333,"name":"Evan Jones","photo":"/di76O2M5Jblg4pbFo4gqmTraqsd.jpg"},{"id":89462,"name":"Kali Hawk","photo":"/ucqSD8maqPl1teegaQMTBsPy90y.jpg"},{"id":4050626,"name":"Ralph Williams","photo":""}],"genres":["Komödie","Liebesfilm"],"id":78309,"original":"Answer This!","overview":"","poster":"/3gBgryhihCNgm0SPO4Ld4WGcHQg.jpg","runtime":105.0,"title":"Answer This!","type":"movie","va":4.3,"vc":22,"year":"2011"},"movie:89455":{"cast":[{"id":3293,"name":"Rachel Weisz","photo":"/9tfHL5tholha1YF6bSKt422ETPM.jpg"},{"id":9642,"name":"Jude Law","photo":"/6UadpSbfC39WMChAcdnNunzwDxv.jpg"},{"id":11107,"name":"Ben Foster","photo":"/p5FlM9OOStD9I0Nm3GGlhaiAC5r.jpg"},{"id":4173,"name":"Anthony Hopkins","photo":"/iaf7SHSkGDpnyrDh1Jolilwk2TD.jpg"},{"id":677,"name":"Moritz Bleibtreu","photo":"/xg2F0OM9ZTLrEvaQsqFSiMH79WB.jpg"},{"id":937219,"name":"Gabriela Marcinková","photo":"/dP4e9YwYDDS7dy20CkhRuz8ukju.jpg"},{"id":2408,"name":"Jamel Debbouze","photo":"/aiqWSWbRJ6rrjxxVE6y2Xb3KdSp.jpg"},{"id":6696,"name":"Mark Ivanir","photo":"/1kxGAsP4YRiR7LgmlM9KgtekMLk.jpg"}],"genres":["Drama","Liebesfilm"],"id":89455,"original":"360","overview":"Ein Mann beschließt während einer Geschäftsreise, nicht fremdzugehen - eine Entscheidung, die eine Reihe bewegender und dramatischer Ereignisse rund um den Erdball nach sich zieht. 360 verwebt Liebesgeschichten und Beziehungen von Menschen im Aufbruch aus unterschiedlichen Metropolen der Welt elegant und unterhaltsam zu einer einzigen romantischen Erzählung über die Liebe und das Leben im 21. Jahrhundert. Alle Protagonisten sind getrieben von Wünschen und Sehnsüchten; sie lieben, träumen, sind glücklich oder traurig, rastlos auf der Suche und voller Widersprüche; jeder lebt sein Leben, so gut er es vermag - und doch sind all diese Leben miteinander verbunden. Ein Blick auf die moderne Welt wie durch ein faszinierendes und mitreißendes Kaleidoskop, eine Liebeserklärung an das Leben.","poster":"/1vjFUpqGNpl8gqV8dskk7dOGXE8.jpg","runtime":110.0,"title":"360","type":"movie","va":5.7,"vc":311,"year":"2012"},"movie:94901":{"cast":[{"id":589098,"name":"Ashley Hinshaw","photo":"/19Bk7dlNSZlewFS0BLP3yINBrHU.jpg"},{"id":3127,"name":"Lili Taylor","photo":"/vWcMUi3QyvCr3QuFbjtwyPx7WtU.jpg"},{"id":76788,"name":"Dev Patel","photo":"/byAo6xoleVSG5O9YpGrQ5YuCRX7.jpg"},{"id":150954,"name":"Diane Farr","photo":"/r63GxSo6qYV5Hy2YZK717fMvxYt.jpg"},{"id":928575,"name":"Jonny Weston","photo":"/jfNlirPh9TrBRzo1LaCN4CGvLlK.jpg"},{"id":17051,"name":"James Franco","photo":"/bjmAntHGiibLZixH8nTNVBzaFQn.jpg"},{"id":69122,"name":"Heather Graham","photo":"/avYdNkeg1oTvmrNJbFDcTlBCkKs.jpg"},{"id":2665676,"name":"Maya Raines","photo":"/jXjBPLHobqTc8jybGWZEACf2k7L.jpg"}],"genres":["Drama"],"id":94901,"original":"About Cherry","overview":"Cherry erzählt die Geschichte der jungen Angelina, die genug hat vom Leben mit ihrer stets betrunkenen Mutter und deren aufdringlichen Freund und sich nach ersten Nacktaufnahmen nach San Francisco absetzt. Hier findet sie zunächst im Stripclub und dann als Pornodarstellerin Annerkennung und sogar Liebe. Aber auch in der boomenden Pornoindustrie hat jeder Erfolg seinen Preis...","poster":"/v3hY1Cerb6o9k2bE6lE9iYb7wuF.jpg","runtime":98.0,"title":"Cherry - Wanna Play?","type":"movie","va":4.6,"vc":331,"year":"2012"},"movie:98545":{"cast":[{"id":2229,"name":"Catherine Keener","photo":"/n4CTwGszs6cwS1wJRlDQ5Mlh7Ex.jpg"},{"id":550843,"name":"Elizabeth Olsen","photo":"/vXz0E5lQKZS1RnlmcHSGbdR0CzG.jpg"},{"id":232006,"name":"Nat Wolff","photo":"/g9noCweddwSb3VBSRpX3vo7TbuP.jpg"},{"id":6352,"name":"Jane Fonda","photo":"/kLYLrpPdvkjsodBjMjY6VYhL91l.jpg"},{"id":47296,"name":"Jeffrey Dean Morgan","photo":"/m8bdrmh6ExDCGQ64E83mHg002YV.jpg"},{"id":60899,"name":"Chace Crawford","photo":"/yWZILsr2mBQBCG1LOcCYYshIbts.jpg"},{"id":1586736,"name":"Marissa O'Donnell","photo":"/chVgbn500sE7KpC3Mod4pA9Qz3l.jpg"},{"id":6677,"name":"Kyle MacLachlan","photo":"/7gNyx8fYAUdOp2jpCEH3dyFbeV.jpg"}],"genres":["Komödie","Drama","Liebesfilm"],"id":98545,"original":"Peace, Love & Misunderstanding","overview":"Ihr Mann möchte die Scheidung. Grund genug für Diane, Koffer und Kinder zu packen und unangekündigt zu ihrer Mutter Grace zu ziehen. Diese hielt sie vorher weitgehend vor ihrer Tochter Zoe und ihrem Sohn Jake geheim, da sie die ältere, dealende Hippie-Dame für keinen guten Einfluss hält. Doch bei ihr in Woodstock lernen die zwei Teenager bald den belesenen Metzgerjungen Cole und die weltoffene Sara kennen. Diane möchte so bald wie möglich wieder weg, doch dann trifft sie den musikalischen Tischler Jude.","poster":"/bIOHApxy3ngIbWvUWGDjSMSCoqZ.jpg","runtime":89.0,"title":"Peace, Love & Misunderstanding","type":"movie","va":5.8,"vc":170,"year":"2011"},"tv:107867":{"cast":[],"genres":["Sci-Fi & Fantasy"],"id":107867,"original":"Etheria","overview":"","poster":"/pv7CtfV3mfrgWh9kOwYUh0tXT3X.jpg","runtime":12.0,"title":"Etheria","type":"series","va":6.4,"vc":8,"year":"2020"},"tv:115864":{"cast":[{"id":935678,"name":"Γιάννης Τσιμιτσέλης","photo":"/v7L4OI3VnVyaluCXfiKTUAJEg06.jpg"},{"id":556108,"name":"Ορφέας Αυγουστίδης","photo":"/8al92UDhD8JtgUOKDYTsJ4Q5CQS.jpg"},{"id":1605840,"name":"Αλέξανδρος Μπουρδούμης","photo":"/bZDHTxoPu0w4EwfvWBWK7N6jDGl.jpg"},{"id":936030,"name":"Χάρης Μαυρουδής","photo":"/kCaQehuljQF6oqNXgKtP5QCn073.jpg"},{"id":1148324,"name":"Τζένη Θεωνά","photo":"/hafrfA0ONXAp26MIqMgr5HxgZGA.jpg"},{"id":935676,"name":"Στέλιος Ξανθουδάκης","photo":"/e3MDpv7vIFI4wcVmzSqbdNUMKt5.jpg"},{"id":2504976,"name":"Μάνος Πίντζης","photo":"/qlEyixBAmATFU5Dy1LoWNTVBc3K.jpg"},{"id":1828916,"name":"Ηλέκτρα Τσακαλία","photo":"/qLDo9WBNBFMYsZdsl6ZdHcaPjfa.jpg"}],"genres":["Komödie"],"id":115864,"original":"Λούφα Και Παραλλαγή","overview":"","poster":"/mUWBlDpNmO31QxGWqhiOebVmnoH.jpg","runtime":45.0,"title":"Λούφα Και Παραλλαγή","type":"series","va":7.0,"vc":1,"year":"2006"},"tv:127865":{"cast":[{"id":1078979,"name":"Danica Ćurčić","photo":"/yOXO1MGsQkZKtaWFAkcMumEZ8eo.jpg"},{"id":1013156,"name":"Mikkel Boe Følsgaard","photo":"/oKC5KLsbj0npfRJA3j9nEIMglmg.jpg"},{"id":1564,"name":"Sofie Gråbøl","photo":"/cG3s3Lknb0KjIJgKdroTkMTCi4N.jpg"},{"id":2999154,"name":"Katinka Lærke Petersen","photo":"/rqncaMlUuSJrJnC9ohoiohgZn5P.jpg"},{"id":141234,"name":"Özlem Sağlanmak","photo":"/sIPisCQaqoMNZCBav6E5MMTRb2g.jpg"},{"id":2541748,"name":"Ester Birch","photo":""},{"id":1934698,"name":"Ida Cæcilie Rasmussen","photo":"/ysueLMso7hgVnwXeZ46l3XnUe7K.jpg"}],"genres":["Drama","Krimi","Mystery"],"id":127865,"original":"Kastanjemanden","overview":"In einem ruhigen Vorort von Kopenhagen macht die Polizei an einem stürmischen Oktobermorgen eine schreckliche Entdeckung. Eine junge Frau wird brutal ermordet auf einem Spielplatz aufgefunden und eine ihrer Hände fehlt. Neben ihr liegt ein kleiner Mann aus Kastanien. Doch damit nicht genug: Denn bei einem zweiten Mordopfer zeigt sich ein ähnliches Bild. Wieder wurde eine kleine Figur, bestehend aus den Früchten des Waldes, hinterlassen. Die ehrgeizige junge Kommissarin Naia Thulin wird zusammen mit ihrem neuen Partner Mark Hess auf den Fall angesetzt. Schon bald entdecken sie auf dem Kastanienmännchen ein mysteriöses Beweisstück, das sie mit einem Mädchen in Verbindung bringt, das ein Jahr zuvor verschwand und für tot gehalten wurde: Die Tochter der Politikerin Rosa Hartung. Doch das ist nur der erste Schritt zur Lösung des Falls. Das Duo muss sich beeilen, denn die Mordserie geht weiter...","poster":"/tk1fGGKvQYGAKZMX6PAatPelCqM.jpg","runtime":0.0,"title":"Der Kastanienmann","type":"series","va":7.5,"vc":762,"year":"2021"},"tv:135822":{"cast":[{"id":13250,"name":"Hidetoshi Nishijima","photo":"/3FBdbeMMWfyKmHS5j8IECwsZWcY.jpg"},{"id":587655,"name":"中村倫也","photo":"/rBDbzWAYVRNpWIbheY82zPgPdAa.jpg"},{"id":229360,"name":"中村蒼","photo":"/melP3Udhsm8jpesyHURSFh3gGEL.jpg"},{"id":1297661,"name":"平澤宏々路","photo":"/pXfjCdUnrK1gLoP9AwLwI0JUMv8.jpg"},{"id":1096815,"name":"三浦貴大","photo":"/kOftuLkByvJx4t4waTccPf3PpNM.jpg"},{"id":1357295,"name":"吉田羊","photo":"/3grR0n3XfGyv6nSB35LjjvKfmCI.jpg"},{"id":1267701,"name":"中村梅雀","photo":"/nZL277cEBon66diXpL2Xqu1qP5S.jpg"},{"id":105403,"name":"濱田岳","photo":"/ynU2RcHBVbTX7aaXiaSKY7njvpx.jpg"}],"genres":["Action & Adventure","Drama","Sci-Fi & Fantasy"],"id":135822,"original":"仮面ライダーBLACK SUN","overview":"Wir schreiben das Jahr 2022. Ein halbes Jahrhundert nachdem die Regierung die Koexistenz von Menschen und Kaijins verkündet hat, herrscht Chaos und Unfrieden in der Welt. Aoi Izumi, eine junge Menschenrechtsaktivistin, die sich gegen Diskriminierung einsetzt, trifft auf einen Mann namens Kotaro Minami, genannt \"Black Sun\", der der neue Schöpfungskönig werden könnte.","poster":"/euD7DIigoWVI1iS3f5l3HnCGirL.jpg","runtime":44.0,"title":"Kamen Rider Black Sun","type":"series","va":8.1,"vc":66,"year":"2022"},"tv:138511":{"cast":[{"id":1915683,"name":"عبدالمحسن النمر","photo":"/vfHsm67Ow2p86IPhPe5P8hhYdzw.jpg"},{"id":2511431,"name":"عبدالمحسن القفاص","photo":"/6zIWMl2OVJHDxCbmU85WWfZVL9q.jpg"}],"genres":["Drama"],"id":138511,"original":"دار غريب","overview":"","poster":"/grCFNOTJIqDxcyn8vxbumloxGI9.jpg","runtime":45.0,"title":"دار غريب","type":"series","va":0.0,"vc":0,"year":"2021"},"tv:153282":{"cast":[{"id":2046094,"name":"Dominique Devenport","photo":"/66z4gH7MTO0KlXRpfR7kiVS5rid.jpg"},{"id":585494,"name":"Jannik Schümann","photo":"/qKh7JAht5TkX6O8anAxDWEHzuh2.jpg"},{"id":1827470,"name":"David Korbmann","photo":"/wlpGVKrOdSqtbApxexNCbxyIP7n.jpg"},{"id":22210,"name":"Désirée Nosbusch","photo":"/vwqP8VVyVQle9qKtHgfc7IPNFmE.jpg"},{"id":18946,"name":"Tanja Schleiff","photo":"/dAI68IA4e6OKn1BF0RCidyj8XmM.jpg"},{"id":185225,"name":"Julia Stemberger","photo":"/ynALeqUHZSxNWovlDoOE6XOgqR0.jpg"},{"id":1071670,"name":"Pauline Rénevier","photo":"/stGMbgMlLMgXNAokLjnyBBbgbqk.jpg"},{"id":49176,"name":"Marcus Grüsser","photo":"/v8vd04rsP0LQYZD01aGoCxk0A2y.jpg"}],"genres":["Drama"],"id":153282,"original":"Sisi","overview":"Kaiserin Elisabeth von Österreich, genannt Sisi, heiratet mit gerade einmal 16 Jahren ihren Cousin Franz Joseph I. und steigt trotz allen Widrigkeiten und ihres Alters zu einem Idol ihrer Zeit auf. Sisi, die die zweite Hälfte des 19. Jahrhundert maßgeblich prägt, ist jedoch nicht nur Kaiserin, sondern muss sich auch als Tochter, Schwester, Ehefrau, Geliebte, Mutter, Freundin und letztlich auch Feindin beweisen. Sie, die als „schönste Frau Europas“ bekannt wird, widersetzt sich den strengen Regeln des Hofes. Sisi weiß, wie sie ihre äußere Erscheinung einsetzen muss, um ihre Vorstellungen verwirklichen zu können. Franz Joseph wiederum setzt auf persönliche und politische Härte, die Krone lastet schwer auf seinem Kopf …\n\n„Sisi“ ist die Neuverfilmung des bekannten Stoffs als komplexe Dramaserie.","poster":"/bf869HgX0E1rbbbyjA6fsiAh5nl.jpg","runtime":45.0,"title":"Sisi","type":"series","va":7.5,"vc":124,"year":"2021"},"tv:194838":{"cast":[{"id":35084,"name":"Johnny Hallyday","photo":"/ev3NTQ0q86rhsawaKSWftiLW8vZ.jpg"},{"id":69681,"name":"Philippe Labro","photo":"/snuf9J6LrVHMLD4iIIwMFHufyD4.jpg"},{"id":54167,"name":"Line Renaud","photo":"/iQhoonlbQCLF9gci8ULFPSPxwkM.jpg"},{"id":1423982,"name":"Jean-Marie Périer","photo":"/f04gMhRkdEFLmIR4PLbi9v2OY97.jpg"},{"id":1569196,"name":"Yarol Poupaud","photo":""}],"genres":["Dokumentarfilm"],"id":194838,"original":"Johnny par Johnny","overview":"","poster":"/k3XehLr2l0ypiqNS0hXxXYJBJ73.jpg","runtime":34.0,"title":"Johnny par Johnny","type":"series","va":6.2,"vc":6,"year":"2022"},"tv:214923":{"cast":[{"id":4186831,"name":"Lucrezia Ward","photo":""},{"id":4186833,"name":"Silvia Abbati","photo":""},{"id":2516520,"name":"Cristina Fenuccio","photo":""},{"id":1014913,"name":"Pino Ammendola","photo":""}],"genres":["Animation","Kids","Familie","Sci-Fi & Fantasy"],"id":214923,"original":"Food Wizards","overview":"","poster":"/sYRUusEu7ANRY5RezEoiefJWmxS.jpg","runtime":11.0,"title":"Food Wizards","type":"series","va":0.0,"vc":0,"year":"2022"},"tv:219432":{"cast":[{"id":2025663,"name":"Carolina Yuste","photo":"/WbPX1SzFmAEaF4ioMEwgumvqzW.jpg"},{"id":229614,"name":"Camila Sodi","photo":"/sG7BhICpNZZp9hxxgXVv7BHipRa.jpg"},{"id":588183,"name":"Silvia Alonso","photo":"/AgXsHxxSBOy9JmtWy5o8y3cKprY.jpg"},{"id":1050107,"name":"Leonardo Ortizgris","photo":"/wHcbad4Jc6ZDh9IcqtV3OWasZG4.jpg"},{"id":4115104,"name":"Beka Lemonjava","photo":"/v9zBSzqqf3XOKxbY15E3hTG9eq7.jpg"},{"id":4093284,"name":"Pavel Anton","photo":"/9nN7UxRgeJDxXtIzIqU0rd3ydFD.jpg"},{"id":1852132,"name":"Borja Luna","photo":"/cMn8NR2FUy92adqEx4D3cGTahg8.jpg"},{"id":1510952,"name":"Adrian Grösser","photo":"/7kDnDNa93XP1xyM2b43qkZ6FoZt.jpg"}],"genres":["Komödie","Action & Adventure"],"id":219432,"original":"Sin huellas","overview":"Desi und Cata, eine Roma und eine Mexikanerin, finden die Leiche einer Frau in der Villa, die sie geputzt haben. Horror! Panik! Sollen sie zur Polizei gehen? Sie haben alles gereinigt, sind die perfekten Schuldigen und müssen weglaufen: Vor der Polizei, aber auch vor russischen Killern, einer Millionärsfamilie und einem Exmann mit einer Mariachi-Band. Mal sehen, wie sie dem Schlamassel entkommen.","poster":"/xcKEHE6LMudizXntdVvP47xbY2q.jpg","runtime":45.0,"title":"Ein nicht ganz so sauberer Mord","type":"series","va":7.0,"vc":45,"year":"2023"},"tv:225956":{"cast":[{"id":1469760,"name":"Aziz Hattab","photo":"/p8JlFko2dbz9UWBoGBmr2aHljVq.jpg"}],"genres":["Komödie","Familie"],"id":225956,"original":"تزوج ما قالها ليا","overview":"","poster":"/a6hwHl8ICinMbAP9uPx2fuylZ84.jpg","runtime":30.0,"title":"تزوج ما قالها ليا","type":"series","va":0.0,"vc":0,"year":"2022"},"tv:249198":{"cast":[{"id":3671527,"name":"آيدا القصي","photo":"/tzu0GLkebhR7S8Rc6sdmdLXM5x5.jpg"},{"id":3119199,"name":"فايز بن جريس","photo":"/spZCAxYYIuNchnhqElgLQBEyswe.jpg"}],"genres":[],"id":249198,"original":"طارق ونوف","overview":"","poster":"/wdtAeZm7WWN0SsioJ2hATvqIw5v.jpg","runtime":0.0,"title":"طارق ونوف","type":"series","va":0.0,"vc":0,"year":"2024"},"tv:250967":{"cast":[],"genres":["Dokumentarfilm"],"id":250967,"original":"Verward","overview":"","poster":"/1sDPYb4bmqHK7p60SC3yiQDLlBx.jpg","runtime":45.0,"title":"Verward","type":"series","va":0.0,"vc":0,"year":"2024"},"tv:273977":{"cast":[{"id":1523579,"name":"Shin Hye-sun","photo":"/cuCFjBn3SpWyhIfBy9TupzvTrmp.jpg"},{"id":1254630,"name":"이준혁","photo":"/hf3Yt9m9SE8I8uaoefDaYdBxwqh.jpg"},{"id":3555452,"name":"Park Bo-kyung","photo":"/mHM4Zf1Knw6MdPrTsyfzrCckyaV.jpg"},{"id":1605872,"name":"정다빈","photo":"/nE6AZgKofgr3CzdA48nsRPuqLU3.jpg"},{"id":2496608,"name":"신현승","photo":"/5xkCNtJIJqozc0pitsgC38rukSc.jpg"},{"id":1094648,"name":"배종옥","photo":"/sIn8u0JmFNd9MYqW6wgC0Rv52xY.jpg"},{"id":3244773,"name":"Kim Jae-won","photo":"/diEPTDk0ngXGje4RGmoMaCd0TWe.jpg"}],"genres":["Krimi","Mystery","Drama"],"id":273977,"original":"레이디 두아","overview":"Sarah Kim leitet die asiatische Niederlassung der exklusiven Luxusmarke „Boudoir“ und führt scheinbar ein glamouröses Leben in Seouls High Society. Doch die glänzende Fassade bricht zusammen, als in einem Abwasserkanal des reichsten Stadtviertels eine verstümmelte Frauenleiche gefunden wird, die offiziell als Sarah Kim identifiziert wird.Der zynische Kriminalkommissar Park Mu-gyeong (Lee Jun-hyuk) übernimmt die Ermittlungen. Er taucht tief in die exklusive Modewelt ein und stößt schnell auf massive Widersprüche. Die echte Sarah Kim scheint gar nicht zu existieren. Stattdessen verbirgt sich dahinter eine ehrgeizige Frau aus der Arbeiterklasse, die sich mithilfe gestohlener Persönlichkeiten und inszenierter Statussymbole eine völlig neue Identität erschaffen hat, um dem Elend zu entfliehen.Es entspinnt sich ein gefährliches, psychologisches Schachspiel zwischen dem unnachgiebigen Ermittler und einer Frau, die alles aufs Spiel setzt, um ihre mühsam aufgebaute Scheinwelt zu schützen.","poster":"/fjy2cv3Edy39bWHdc8yjQF66pqk.jpg","runtime":45.0,"title":"The Art of Sarah","type":"series","va":7.6,"vc":103,"year":"2026"},"tv:288863":{"cast":[],"genres":["Dokumentarfilm"],"id":288863,"original":"Life or Death: The Negotiators","overview":"","poster":"/v9PGQnVLP4o9o6d11fZrB61LOdq.jpg","runtime":0.0,"title":"Life or Death: The Negotiators","type":"series","va":0.0,"vc":0,"year":"2025"},"tv:326932":{"cast":[],"genres":["Reality"],"id":326932,"original":"7 TAGE DATE IN DER BOX","overview":"Zwei Fremde ziehen für 7 Tage gemeinsam in eine Box, um herauszufinden, ob aus einem ersten Date ein echtes Match wird. Denn am Ende gibt es nur zwei Optionen: die Box als Paar zu verlassen oder sich nie wiederzusehen. Doch bis dahin wird ihre Beziehung Tag für Tag auf die Probe gestellt: durch Challenges, Belohnungen, Bestrafungen und neue Versuchungen. Denn per Knopfdruck kann der eigene Box-Partner jederzeit ersetzt werden.","poster":"/mizysaYu8Nh3aevVcpLhwWBGym9.jpg","runtime":0.0,"title":"7 TAGE DATE IN DER BOX","type":"series","va":0.0,"vc":0,"year":"2026"},"tv:4586":{"cast":[{"id":16858,"name":"Lauren Graham","photo":"/3leQVZnthAZwngH7HAD6T7qfsVu.jpg"},{"id":6279,"name":"Alexis Bledel","photo":"/mhkQzBtp2wuYoKhYqJ4IpDtbS3t.jpg"},{"id":50020,"name":"Scott Patterson","photo":"/qTm0LFuV8DktunzKa5T3UZoq1tC.jpg"},{"id":55536,"name":"Melissa McCarthy","photo":"/yl0qva0O4u92fvtItakdvKmKrW9.jpg"},{"id":35467,"name":"Keiko Agena","photo":"/7v2XH9LQts17OQtsprzpNiWAWEu.jpg"},{"id":131646,"name":"Yanic Truesdale","photo":"/pHXlAs0kdzbi0qOmT8uOFdRJV0j.jpg"},{"id":55546,"name":"Liza Weil","photo":"/eYR8oJnVKfCR73OlF7Uy2oC2MM3.jpg"},{"id":51663,"name":"Sean Gunn","photo":"/tiolBlPytndQVGHO9vLnBKWWenq.jpg"}],"genres":["Komödie","Drama"],"id":4586,"original":"Gilmore Girls","overview":"In der charmanten Stadt Stars Hollow, Connecticut, lebend, haben Lorelai und Rory Gilmore eine Mutter-Tochter-Beziehung, von der die meisten Menschen nur träumen.","poster":"/gwtzCwU2wdLLf8oejQu2TINiWfQ.jpg","runtime":44.0,"title":"Gilmore Girls","type":"series","va":7.9,"vc":1342,"year":"2000"}},"version":1}