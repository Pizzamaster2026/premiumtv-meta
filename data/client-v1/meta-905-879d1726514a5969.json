:5.9,"vc":32,"year":"1953"},"movie:127864":{"cast":[{"id":16971,"name":"Maribel Verdú","photo":"/7hxTsW5CKi2lkz5yGMWShki7DOo.jpg"},{"id":1091128,"name":"Macarena García","photo":"/g0oqhCQ8FgVww2A3NQtQ03TanH3.jpg"},{"id":1603,"name":"Daniel Giménez Cacho","photo":"/4sM4fbDAyjDcEcxRqVWpUF35IrL.jpg"},{"id":3822,"name":"Ángela Molina","photo":"/c5ZIgJmWu5bHOxD9jOOo4e0otaf.jpg"},{"id":224728,"name":"Inma Cuesta","photo":"/mzOriC8zIS3HqjGtthO4XwLht6C.jpg"},{"id":1114063,"name":"Sofía Oria","photo":"/j3OzPE5NKDvnxVM4cLAnZV0gYCU.jpg"},{"id":24987,"name":"Ramón Barea","photo":"/7KJMpbljybgVMhHuNosECDrzact.jpg"},{"id":19909,"name":"Josep Maria Pou","photo":"/dlrkGiYFUguEBdf19CLWHF1vGCj.jpg"}],"genres":["Drama","Fantasy"],"id":127864,"original":"Blancanieves","overview":"Carmen ist die Tochter eines berühmten Matadors, der nach einem Stierkampf im Rollstuhl endet. Die böse Stiefmutter verdammt das kleine Mädchen zu den niedrigsten Arbeiten und versucht nach dem Tod des Vaters auch sie zu beseitigen. Als ihr die Flucht zu einer Schaustellertruppe kleinwüchsiger Toreros gelingt, entdeckt Carmen ihre wahre Berufung und wird zur Königin der Corridas.","poster":"/64vBklpYgksumhSwrJdTvHeySfS.jpg","runtime":104.0,"title":"Blancanieves","type":"movie","va":7.2,"vc":279,"year":"2012"},"movie:137586":{"cast":[{"id":30225,"name":"Merle Oberon","photo":"/uRc4TzGXojrivskCw37609FcK0i.jpg"},{"id":45380,"name":"Turhan Bey","photo":"/YugYyfwqXp9C3Qj0oNaNJVmbf6.jpg"},{"id":18646,"name":"Thomas Gomez","photo":"/B8xqQSXSFUjlXydqMN2w6WdFiV.jpg"},{"id":25173,"name":"Gale Sondergaard","photo":"/qIM4YO2sWBzdGOCAZctZjPcUK2c.jpg"},{"id":14518,"name":"Ray Collins","photo":"/usQN1n6UMPwYrTuTKdiSxUj8Qwa.jpg"},{"id":34419,"name":"Ernest Truex","photo":"/zR2nCojIK4WzCHFEaX1P3X4K6fo.jpg"},{"id":97279,"name":"George Dolenz","photo":"/9kWuPK1A3vVEs474xPmQWmazmk5.jpg"},{"id":16766,"name":"John Litel","photo":"/cH4K9uyqAjUWKZjBq0nA8VyOe14.jpg"}],"genres":["Komödie","Drama","Fantasy"],"id":137586,"original":"Night in Paradise","overview":"","poster":"/tBbXymWUqIjrzZ99iBg4NwlNeBX.jpg","runtime":84.0,"title":"Night in Paradise","type":"movie","va":6.5,"vc":2,"year":"1946"},"movie:1492":{"cast":[{"id":16927,"name":"Gérard Depardieu","photo":"/pOpHfkYRhFJiKAiIycdguQPYfem.jpg"},{"id":23346,"name":"Armand Assante","photo":"/9HbbWAJacTHguO2InDVHKGnaasm.jpg"},{"id":10205,"name":"Sigourney Weaver","photo":"/wTSnfktNBLd6kwQxgvkqYw6vEon.jpg"},{"id":11628,"name":"Loren Dean","photo":"/kkWuneJSgPLvNYknj30yqxdfIBr.jpg"},{"id":3822,"name":"Ángela Molina","photo":"/c5ZIgJmWu5bHOxD9jOOo4e0otaf.jpg"},{"id":14821,"name":"Fernando Rey","photo":"/rHhIkesTHCv0asTkf7fkyXoousS.jpg"},{"id":7486,"name":"Michael Wincott","photo":"/z6FtWACKaIivi0khxM6vEHoUH0.jpg"},{"id":14721,"name":"Kevin Dunn","photo":"/7dqLQjMNCQnuxQJQwQ5Ozz16LBq.jpg"}],"genres":["Action","Abenteuer","Drama","Historie"],"id":1492,"original":"1492: Conquest of Paradise","overview":"Zielstrebig und auf westlichem Kurs segelt Columbus einem unbekannten Land entgegen. Er hofft Indien zu finden und landet nach einer gefährlichen Reise auf der Insel Guanahani, einem Paradies vor der Küste Südamerikas. Doch der Eindruck täuscht: Hurrikans, Brände, Aufstände, sinnlose Ausbeutung und Brutalität beherrschen das Land. Am spanischen Hof fällt Columbus in Ungnade. Mit einer Schiffsflotte ist man bereits unterwegs ihn zu verhaften; ein gewisser Amerigo Vespucci entdeckt vor ihm das Festland und er selbst wird nach seiner Rückkehr nach Spanien ins Gefängnis geworfen. Die Eroberung des Paradieses endet für Columbus mit Verachtung und Enttäuschung. Auch nach seiner Begnadigung durch Königin Isabella und einer weiteren Expedition geben seine Widersacher keine Ruhe, ihn und seine Entdeckung zu verleugnen…","poster":"/Tfm27O1T7QwguMQ6lT7j99Jpbb.jpg","runtime":154.0,"title":"1492 - Die Eroberung des Paradieses","type":"movie","va":6.3,"vc":966,"year":"1992"},"movie:157386":{"cast":[{"id":996701,"name":"Miles Teller","photo":"/kDf3sW3USjEBDQ3Ua7lbwOfwty6.jpg"},{"id":94185,"name":"Shailene Woodley","photo":"/gL2NvHKW9wAH3qkZuJ76ULUiArB.jpg"},{"id":198855,"name":"Masam Holden","photo":"/9PUntIsbx4YxEbQx9o7VadHEOWs.jpg"},{"id":481337,"name":"Kaitlyn Dever","photo":"/np5rBCFRdeS1sXePL8uY09ktoC4.jpg"},{"id":60073,"name":"Brie Larson","photo":"/xSGvMwNNJcEQvVcjiIUTyxyMfkZ.jpg"},{"id":3497,"name":"Kyle Chandler","photo":"/66n7XNj1dyYkzCBWR3Lq8Vz4PJ1.jpg"},{"id":10431,"name":"Jennifer Jason Leigh","photo":"/7DbG2AO3nygHAkNC866HLPKkxv9.jpg"},{"id":17628,"name":"Mary Elizabeth Winstead","photo":"/vQn6IGsClpyhV6KTba9EDqSK7e2.jpg"}],"genres":["Komödie","Drama","Liebesfilm"],"id":157386,"original":"The Spectacular Now","overview":"Der Highschool-Schüler Sutter Keely (Miles Teller) lebt getreu dem Motto ‘Carpe diem’ im Hier und Jetzt. Für den Senior ist das Leben eine ständige Party; der Job bei einem Herrrenausstatter verschafft ihm dabei das nötige Geld, um mit einem Auto Eindruck bei seiner heißen Freundin zu schinden. So könnte das Verharren in der Gegenwart ständig weitergehen. Bis er nach einer durchzechten Nacht in einer anderen Welt aufwacht, in der Welt von Aimee Finicky (Shailene Woodley). Anders als Sutter ist sie einem Morgen danach durchaus aufgeschlossen, auch wenn sie dieses Morgen mit einer ordentlichen Portion Science-Fiction-Literatur würzt. Dafür ist sie alles andere als hip, eben nur ein nettes Mädchen, das noch nie einen Freund hatte. Wider aller Erwartung verlieben sich die Beiden ineinander. Doch kann das auf Dauer gut gehen, wenn sich Sutter weiterhin einer sorglosen Gegenwart verpflichtet fühlt?","poster":"/sjnLDK2RopSVAZtutXGMznvtTwY.jpg","runtime":95.0,"title":"The Spectacular Now","type":"movie","va":6.7,"vc":3111,"year":"2013"},"movie:166870":{"cast":[{"id":88138,"name":"Sushmita Sen","photo":"/arteijssIoHzs8wFLjs6pvqRnlJ.jpg"},{"id":55062,"name":"Tabu","photo":"/cvt5nvCHr1ICf5u8A2mlzLQ8LsV.jpg"},{"id":86074,"name":"Sanjay Suri","photo":"/8TYltbXF7cKRnH719rSek6YznJQ.jpg"},{"id":1642093,"name":"Palas