yQY8nwLLhyb55V.jpg"}],"genres":["Familie","Komödie","Drama"],"id":1214074,"original":"Der Buchspazierer","overview":"Tag für Tag steht Carl Kollhoff im hinteren Teil eines Buchladens, wo er mit äußerster Sorgfalt Bücher in Papier einwickelt, um sie dann seinen treuen Kunden in der Stadt zu bringen. Für den schweigsamen älteren Mann sind Bücher das größte Glück und sie dienen ihm als Hauptkontakt zur Außenwelt. Eines Tages schließt sich ihm auf einer seiner Runden die neunjährige Schascha an, die neu in der Stadt ist. Schnell gewinnt Schascha die Herzen von Carls und seiner Stammkundschaft – und wirbelt nicht nur ihr aller Leben gehörig durcheinander, sondern bringt auch Carl dazu, aus seiner eigenen Welt auszubrechen.","poster":"/gVtrx976wxF07YQX4CLc1CFUvV8.jpg","runtime":98.0,"title":"Der Buchspazierer","type":"movie","va":7.4,"vc":63,"year":"2024"},"movie:1241982":{"cast":[{"id":1564846,"name":"Auli'i Cravalho","photo":"/vEroqcnM2g6yY7qXDAie7hx2Cyp.jpg"},{"id":18918,"name":"Dwayne Johnson","photo":"/5QApZVV8FUFlVxQpIK3Ew6cqotq.jpg"},{"id":4775908,"name":"Hualālai Chung","photo":"/x2g5fdHqETY9dZgL4aB0QDP0boR.jpg"},{"id":1868823,"name":"Rose Matafeo","photo":"/zQa39fMjbOTIsovbh1TBTJVlToz.jpg"},{"id":55937,"name":"David Fane","photo":"/tcozyaTgAa8rRmzc5qeht0loni6.jpg"},{"id":3819173,"name":"Awhimai Fraser","photo":"/276OUDPl2iIsz772HQw3tiz2JN2.jpg"},{"id":4775906,"name":"Khaleesi Lambert-Tsuda","photo":"/3LHXDjy9UijbtR7X2EReX5H57kk.jpg"},{"id":7242,"name":"Temuera Morrison","photo":"/qGGYYjLMfuWmywgVixsu88PIbJn.jpg"}],"genres":["Abenteuer","Animation","Komödie","Familie","Fantasy"],"id":1241982,"original":"Moana 2","overview":"Nachdem sie einen unerwarteten Ruf von ihren Vorfahren erhalten hat, reist Moana zu den weiten Meeren Ozeaniens und in gefährliche, längst vergessene Gewässer, um ein Abenteuer zu erleben, das sie so noch nie erlebt hat.","poster":"/5cgJBuRHE5wIN6TuHFyzN8ELkRq.jpg","runtime":100.0,"title":"Vaiana 2","type":"movie","va":7.0,"vc":3368,"year":"2024"},"movie:1293286":{"cast":[{"id":10822,"name":"Stephen Dorff","photo":"/bhlM1xNzBvc8jTw42YloUKlGTCL.jpg"},{"id":69122,"name":"Heather Graham","photo":"/avYdNkeg1oTvmrNJbFDcTlBCkKs.jpg"},{"id":2963,"name":"Nicolas Cage","photo":"/y1RtezurZYveYkVNRht7CwEgSYY.jpg"},{"id":36631,"name":"Randall Batinkoff","photo":"/tq4njPdsUNXjnIAnPetT6B423BW.jpg"},{"id":1319440,"name":"Cooper Barnes","photo":"/b9Pqy8KU4TVnLhvkASxrNmljvkE.jpg"},{"id":3258734,"name":"Scarlet Rose Stallone","photo":"/13f6FANe7TdbvjtZCbArygnDv1S.jpg"},{"id":21629,"name":"Tzi Ma","photo":"/x4fz0LCIiBNGdil3nBYO22W7QJ0.jpg"},{"id":1192496,"name":"Jeremy Kent Jackson","photo":"/jpVI15LVSS8f7VGDay35mGaxvAR.jpg"}],"genres":["Action","Thriller","Western"],"id":1293286,"original":"Gunslingers","overview":"In der rauen Stadt Redemption werden der reformierte Revolverheld Thomas Keller (Stephen Dorff) und das verrückte Genie Ben (Nicolas Cage) von dem spirituellen Führer Jericho (Costas Mandylor) auf ihrem Weg zur Wiedergutmachung begleitet. Als er mit seiner gewalttätigen Vergangenheit konfrontiert wird, kommt es zu einer brutalen Kneipenschlägerei und einer tödlichen Fehde zwischen Thomas, Ben und der berüchtigten Five Points Gang. Nun, da Thomas getauft und wiedergeboren ist, muss er sich neuen Herausforderungen stellen und seinen neu gefundenen Frieden in einer Stadt voller Geheimnisse, Gewalt und einem unerbittlichen Streben nach Rache testen.","poster":"/wkLXY92kCuvGlZCCU9kxyYNDYQl.jpg","runtime":104.0,"title":"Gunslingers","type":"movie","va":6.1,"vc":129,"year":"2025"},"movie:1621247":{"cast":[{"id":1543708,"name":"Hebah Patel","photo":"/hZM5aTM75NRQes6lRLkM2eT8Z9X.jpg"},{"id":4566695,"name":"Madee Manepalli","photo":""},{"id":1107254,"name":"Kalpika Ganesh","photo":"/7q7UPxKI3Kuw9hC3QpNBxULzBuh.jpg"},{"id":1712856,"name":"Rakendu Mouli Vennelakanti","photo":"/bTPcmRTCTjiASiEp4Nu5SQArTaM.jpg"},{"id":3945471,"name":"Mourya Siddavaram","photo":""},{"id":5956590,"name":"Anirudh Sreevatsav","photo":""}],"genres":["Komödie","Krimi"],"id":1621247,"original":"Mario","overview":"","poster":"/a6UBMJQisGuoIEoh8VRlFsRuRJN.jpg","runtime":137.0,"title":"Mario","type":"movie","va":0.0,"vc":0,"year":"2025"},"movie:19827":{"cast":[{"id":2314,"name":"Peter Falk","photo":"/e59x8ITouNlyz8Qa2abb5lxiQvI.jpg"},{"id":1903,"name":"Alan Arkin","photo":"/AoMhBzvWMy8bAz14KdbQ30SF0RZ.jpg"},{"id":20163,"name":"Richard Libertini","photo":"/tpkGxVaGzAiY8kWmCWyeV2bjeNB.jpg"},{"id":1217271,"name":"Nancy Dussault","photo":"/iJfNyMDxAElwWXZiRhqNBc8nL35.jpg"},{"id":162923,"name":"Penny Peyser","photo":"/idukASJH3KtSzoR39bF3XVqEEnv.jpg"},{"id":22494,"name":"Arlene Golonka","photo":"/pxBgn3WhpmoqwPpb1YaBNF0VCon.jpg"},{"id":15045,"name":"Michael Lembeck","photo":"/f1Bf2p9YvPIaTZMUhYxhCx5yxLP.jpg"},{"id":39782,"name":"Paul L. Smith","photo":"/1Jxi6QSNn5CEuzDQzGGPgN1kxKq.jpg"}],"genres":["Komödie","Abenteuer"],"id":19827,"original":"The In-Laws","overview":"Durch die Hochzeit ihrer Kinder kommen Vince Ricardo (Peter Falk), angeblicher CIA-Agent, und der Zahnarzt Sheldon Kornpett (Alan Arkin) zusammen.\r Vince zieht den harmlosen Sheldon sofort in seine Unterwelt-Geschäfte. Und es dauert nicht lange, bis beide auch schon pausenlos auf der Flucht sind. Schließlich landen sie in einer winzigen Bananenrepublik. Aber dort sind sie schon gar nicht sicher.","poster":"/p6SgvRwXfyjcnvnsPSuE9Qi7jDi.jpg","runtime":103.0,"title":"Zwei in Teufels Küche","type":"movie","va":6.6,"vc":142,"year":"1979"},"movie:24012":{"cast":[{"id":3149,"name":"Marilyn Monroe","photo":"/vcp6rHL2sZWdlJQDEWsEe0jAAe1.jpg"},{"id":3359,"name":"Laurence Olivier","photo":"/kziWbtgEJB0dFZA6kPyzoaYEyQ5.jpg"},{"id":20399,"name":"Sybil Thorndike","photo":"/ocRKGOJAZ4ydZgvhc8anCL2bPTi.jpg"},{"id":85935,"name":"Richard Wattis","photo":"/9pTeYuFSEN85DACrS77vGZ1tm6D.jpg"},{"id":18762,"name":"Jeremy Spenser","photo":"/1iaNHBDHJxKrDOgFP6DiSwo4696.jpg"},{"id":119342,"name":"David Horne","photo":"/7FkB36qWz6EFz3sl1lWtGjaidLt.jpg"},{"id":1208202,"name":"Harold Goodwin","photo":"/dzhElkQmGWrDNWPz8FE5NvBCqud.jpg"},{"id":559081,"name":"Gladys Henson","photo":"/7x0O62dDJwxy7QdijCF9mUTpp6U.jpg"}],"genres":["Komödie","Liebesfilm"],"id":24012,"original":"The Prince and the Showgirl","overview":"Großherzog Karl von Karpathien kommt 1911 zur Krönungsfeier von Georg I. nach London. Er bewundert während einer Bühnenshow das amerikanische Revuegirl Elsie Marina und lädt sie für ein flüchtiges Abenteuer zum Abendessen ein. Doch die schlagfertige Elsie wehrt seine Annäherungsversuche ab, schläft beschwipst ein. Am nächsten Morgen wird ihr klar, dass sie sich in Karl, der sie los sein will, verliebt hat. Elsie lernt die Königinmutter kennen, wird ihre Zofe für die Krönungsfeier, gewinnt doch noch Karls Herz und verspricht, auf ihn zu warten.","poster":"/wW19UUYXFwAXJhY1QtKJypHiedQ.jpg","runtime":115.0,"title":"Der Prinz und die Tänzerin","type":"movie","va":6.3,"vc":208,"year":"1957"},"movie:29284":{"cast":[{"id":97145,"name":"Paul Langton","photo":"/2ycev1rk6iH5a5Yqkhaub7j0n3B.jpg"},{"id":82833,"name":"Barbara Payton","photo":"/pOk1zrTd7GtdhpDu8WUmK7MKSV1.jpg"},{"id":34726,"name":"Robert Shayne","photo":"/k7wIXDxBHZTRcc1bcr1qcQjWz7Z.jpg"},{"id":95271,"name":"Selena Royle","photo":"/SqFituJ8FRagYqvEX5tVFzbOXV.jpg"},{"id":34211,"name":"Roy Gordon","photo":"/tz0aMT84Vf8POwpiiXg5XIcs7nY.jpg"},{"id":103424,"name":"Tracey Roberts","photo":"/dyvmWNqmrtoCtKxFTmi17GDKBmo.jpg"},{"id":103425,"name":"Kate MacKenna","photo":""},{"id":93628,"name":"Harry Harvey","photo":"/gfBTGsPJGlbQ7ThZKPdwb0pYC5w.jpg"}],"genres":["Mystery","Krimi"],"id":29284,"original":"Murder Is My Beat","overview":"","poster":"/yKnP4XNZ32VcpaqDFT4TasccNMz.jpg","runtime":77.0,"title":"Murder Is My Beat","type":"movie","va":6.0,"vc":21,"year":"1955"},"movie:38718":{"cast":[{"id":515,"name":"Glenn Close","photo":"/4VHZ1GfLwN7MUgApy0LCBzdDF9L.jpg"},{"id":16940,"name":"Jeremy Irons","photo":"/w8Ct1q02Ht3sWdOSqfp3B85TzT.jpg"},{"id":21399,"name":"Ron Silver","photo":"/6urQBScK7Vq6q5niaMMEmzW3DGP.jpg"},{"id":18750,"name":"Annabella Sciorra","photo":"/p2dnBSjLzKxldrHCQZYmVq0LcFw.jpg"},{"id":93051,"name":"Uta Hagen","photo":"/uEPthHJ0Hy2M1EZambNSn4FPKbf.jpg"},{"id":26473,"name":"Fisher Stevens","photo":"/wWC6wbLV56RJGtyytMmmGvi054t.jpg"},{"id":77023,"name":"Jack Gilpin","photo":"/xVUmXH9co9P836ZNiRIM1jpsNz2.jpg"},{"id":11870,"name":"Christine Baranski","photo":"/q6Zi3BYlmoim1JXXMGgRVS5C87x.jpg"}],"genres":["Drama","Krimi"],"id":38718,"original":"Reversal of Fortune","overview":"Einer der spektakulärsten Prozesse der 80er-Jahre drehte sich um Claus von Bülow, der angeklagt war, seine reiche Frau Sunny mit einer Überdosis Insulin in ein permanentes Koma versetzt zu haben. Regisseur Barbet Schroeder und Drehbuchautor Nicholas Kazan nahmen die Geschichte zum Anlass, über das Leben von Menschen zu reflektieren, die zu viel Zeit und zu viel Geld haben. Zugleich funktioniert ihr Film aber auch als Krimi, der verfolgt, wie der Anwalt Alan Dershowitz sich darauf vorbereitet, Bülow vor Gericht zu verteidigen. Jeremy Irons gewann einen Oscar für seine Darstellung, die die Abgründe hinter der Fassade gelangweilter Eleganz stets nur andeutet. Der Gegensatz zwischen dem angriffslustigen Dershowitz und dem antriebslosen von Bülow verleihen dem Ganzen zudem eine Prise Humor.","poster":"/5gQHQvfy6RBiRmEnNuQ623RwTvA.jpg","runtime":112.0,"title":"Die Affäre der Sunny von B.","type":"movie","va":6.7,"vc":370,"year":"1990"},"movie:42030":{"cast":[{"id":100647,"name":"Shari Shattuck","photo":"/AhqufDHtMl3RaGYkXEnWmrczseW.jpg"},{"id":45002,"name":"Angel Tompkins","photo":"/6jCg8nvtI1CL9ltR0VYxc80Hwxi.jpg"},{"id":192097,"name":"Lucinda Crosby","photo":""},{"id":1364914,"name":"Stacey Shaffer","photo":""},{"id":106073,"name":"Christina Whitaker","photo":"/h8FU2L1rUstjuzGi43jo4XrDYM3.jpg"},{"id":160757,"name":"Nick Benedict","photo":"/1eTGjbxEH3pMzSezHBq4oWJAuID.jpg"},{"id":102439,"name":"John Terlesky","photo":"/wkfpuOX5BYmEcjwqrKQwD0gFXee.jpg"},{"id":120650,"name":"Faith Minton","photo":"/lGhcva50PlZuM5qINjfoQBdG2F7.jpg"}],"genres":["Action","Drama"],"id":42030,"original":"The Naked Cage","overview":"Michelle (Shari Shattuck), wird fälschlicherweise für einen Banküberfall verurteilt den sie nicht begangen hat. Daraufhin landet sie in einem Gefängnis mit höchster Sicherheitsstufe und muss sich nicht nur gegenüber den anderen Insassinnen behaupten, sondern auch dem korrupten Gefängnisleiter die Stirn bieten, während sie zahlreiche Demütigungen erträgt. Haß und Intrigen, sexuelle Nötigung und Drogensucht – das Zuchthaus gleicht der Hölle. Die grausamen Zustände eskalieren in mörderischen Machtkämpfen. Überleben kann nur, wer da rauskommt …","poster":"/5iCjhrn0wltvOnuIq9be0VxGW9B.jpg","runtime":97.0,"title":"Im Keller des Grauens","type":"movie","va":4.9,"vc":31,"year":"1986"},"movie:42232":{"cast":[{"id":141,"name":"David Carradine","photo":"/1X2GlkMKS9FIG1kGou7o6LRqAjz.jpg"},{"id":780,"name":"Ronny Cox","photo":"/cKkVkqft2RacSDhsKxO8nMFgeAd.jpg"},{"id":4778,"name":"Melinda Dillon","photo":"/biM3R6qURBprG9U8tIvpOk8WjOw.jpg"},{"id":42003,"name":"Gail Strickland","photo":"/nvSOOk3P1VQsgxC3FOYki5JIlF8.jpg"},{"id":46100,"name":"John Lehne","photo":"/rOg5q8Mn16GcpjqB2WVaLc6oKHt.jpg"},{"id":937883,"name":"Ji-Tu Cumbuka","photo":"/aPxkduleB0dlJXZRPvTW59kCadD.jpg"},{"id":1811,"name":"Randy Quaid","photo":"/rGWvDokcMLIwck10dKIutSoTM9r.jpg"},{"id":2297682,"name":"Elizabeth Macey","photo":""}],"genres":["Musik","Drama"],"id":42232,"original":"Bound for Glory","overview":"Pampa, Texas, zur Zeit der Weltwirtschaftskrise. Den Folkmusiker Woody Guthrie zieht es ins \"gelobte Land\" nach Kalifornien. Seine Reise wird zu einer Fahrt durch das Elend der Depressionsjahre. Er lernt den Sänger Ozark kennen. Gemeinsam werben die beiden mit ihren Songs für die Gewerkschaftsbewegung.","poster":"/3JKx0LgVbB7Kclq3lCB6Fj1CIAc.jpg","runtime":148.0,"title":"Dieses Land ist mein Land","type":"movie","va":6.9,"vc":87,"year":"1976"},"movie:63022":{"cast":[{"id":138