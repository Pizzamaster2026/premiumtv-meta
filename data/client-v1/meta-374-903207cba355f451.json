9W0sEmaQG.jpg","runtime":74.0,"title":"Of Time and the City","type":"movie","va":7.1,"vc":41,"year":"2008"},"movie:41949":{"cast":[{"id":10767,"name":"Barbara Hershey","photo":"/6swwfge3HlvyBVRSNwroFtMcgNB.jpg"},{"id":20277,"name":"David Suchet","photo":"/4X4TT8Uf8mAmRIYgYh4EeR4mWva.jpg"},{"id":1924,"name":"Jeroen Krabbé","photo":"/r26lZKUeLIaUt8DMotm4mdc4EaY.jpg"},{"id":652,"name":"Paul Freeman","photo":"/qrjgLfuNdXektuBwNL6onZBkbHw.jpg"},{"id":3129,"name":"Tim Roth","photo":"/qSizF2i9gz6c6DbAC5RoIq8sVqX.jpg"},{"id":57449,"name":"Jodhi May","photo":"/iqVk4bZyBkIOOWxaYxiezcApwRG.jpg"},{"id":3341544,"name":"Nadine Chalmers","photo":""},{"id":3341545,"name":"Maria Pilar","photo":""}],"directors":[{"id":8969,"name":"Chris Menges"}],"genres":["Drama"],"id":41949,"original":"A World Apart","overview":"Südafrika, 1963: die 13jährige Molly, Tochter der engagierten Apartheidgegner Gus und Diana Roth, erfährt am eigenen Leibe die Auswirkungen des rassistischen Regimes. Ihr Vater, Mitglied des Exekutivkomitees des African National Congress, muss vor der Verfolgung durch die Regierung ins Ausland flüchten, ihre Mutter wird aufgrund des eben erlassenen 90-Tage-Inhaftierungsgesetzes ohne Anklageerhebung eingesperrt. Diana kann dem Psychoterror des Geheimdienstes widerstehen, sie wird nach 90 Tagen entlassen, ohne ihre Freunde verraten zu haben.","poster":"/rLo4PwbuT3C7k2VxAGbMQU1aINp.jpg","runtime":112.0,"title":"Zwei Welten","type":"movie","va":6.4,"vc":33,"year":"1988"},"movie:46838":{"cast":[{"id":51383,"name":"Tyler Labine","photo":"/uTg5k0mflhBju9Q1tOYmYDzdBu6.jpg"},{"id":21088,"name":"Alan Tudyk","photo":"/jUuUbPuMGonFT5E2pcs4alfqaCN.jpg"},{"id":74618,"name":"Katrina Bowden","photo":"/ykdL2JKteaBexfDiS9jp9Msyori.jpg"},{"id":59926,"name":"Jesse Moss","photo":"/ki9S8rLqvhde9nYaUqrMisCSqwq.jpg"},{"id":64670,"name":"Philip Granger","photo":"/bkrnrtSiUnumWVpAOy5QDcOePiA.jpg"},{"id":58371,"name":"Brandon Jay McLaren","photo":"/jZKb3ziBI3r8I6Yd8m1zUWl2G4O.jpg"},{"id":168554,"name":"Christie Laing","photo":"/wmyje5oGIo9HJP6oST9CfsG3jYC.jpg"},{"id":27775,"name":"Chelan Simmons","photo":"/pnIEDV1CqfZLYi5YilmcGu6FZrZ.jpg"}],"directors":[{"id":52479,"name":"Eli Craig"}],"genres":["Komödie","Horror"],"id":46838,"original":"Tucker and Dale vs. Evil","overview":"Tucker und Dale sind beste Freunde, die ihre Zeit in den abgeschiedenen Wäldern von West Virginia mit all dem verbringen, was beste Freunde eben so tun – sie trinken Bier, gehen jagen und schauen auch mal schüchtern den Mädchen hinterher. Als sie eines Tages während eines Ausflugs mit einer Schar großstädtischer Teenager kollidieren, glauben die, echt perverse Hinterwäldler vor sich zu haben: Hilfe! Panik! Gestammelte Erklärungen machen alles nur noch schlimmer. Als die Landeier wenig später die hübsche Allison vor dem Ertrinken retten, wird dies prompt als Entführungsversuch fehlinterpretiert. Schon schreiten die Städter entschlossen und mit allem, was der Geräteschuppen hergibt, zur Gegenwehr. Jetzt wird guter Rat teuer, bald stapeln sich die ersten Leichen im Wald.","poster":"/8shwLEDzajJGSfLgbpac8x8xn1U.jpg","runtime":89.0,"title":"Tucker and Dale vs. Evil","type":"movie","va":7.4,"vc":3399,"year":"2010"},"movie:68179":{"cast":[{"id":52997,"name":"Rob Corddry","photo":"/AjCLr5ZjP6iiP8D6SHQVCZ720nA.jpg"},{"id":18269,"name":"Brendan Fraser","photo":"/tFj5PaWWQbb8rHBBhu1EHklznph.jpg"},{"id":56731,"name":"Jessica Alba","photo":"/hPoy6FRfiCIxguX3w2CoBbDoaEV.jpg"},{"id":18324,"name":"Steve Zahn","photo":"/rwrPdKGwXnByxUVMxMf8Y7oswi3.jpg"},{"id":520,"name":"Sarah Jessica Parker","photo":"/tEhHY7Uyn8VktwLhawBRuR0tdaJ.jpg"},{"id":17835,"name":"Ricky Gervais","photo":"/z293wonhuF0aYQtg1ROOSl1LObf.jpg"},{"id":170185,"name":"Gregg Binkley","photo":"/jSRnKsijFKC0DBKTRDtTdrBc5sB.jpg"},{"id":63522,"name":"Sofía Vergara","photo":"/l79eVtn6bSOaiq7R0UGu60foMrK.jpg"}],"directors":[{"id":1098477,"name":"Cal Brunker"}],"genres":["Animation","Komödie","Abenteuer","Familie","Science Fiction"],"id":68179,"original":"Escape from Planet Earth","overview":"Auf dem Planeten Baab ist der Astronaut Scorch Supernova ein gefeierter Held. Bei seinen waghalsigen Abenteuern steht ihm sein Bruder Gary zur Seite, der sich jedoch lieber an die Vorschriften hält, als sich Hals über Kopf in die Gefahr zu stürzen. Als von einem fernen Planeten SOS-Zeichen gesendet werden, zögert Scorch keine Sekunde - und tappt direkt in die Falle seines Widersachers Shanker. Jetzt bleibt Gary nichts anderes übrig, als selbst aktiv zu werden.","poster":"/tQ5MYgyHusVcGDEQrJhpwECkdz4.jpg","runtime":89.0,"title":"Nix wie weg - vom Planeten Erde","type":"movie","va":5.8,"vc":862,"year":"2013"},"movie:77881":{"cast":[{"id":208705,"name":"Joshua Safran","photo":"/sWt6mVwSA7nkAwcfJscb9H0n910.jpg"},{"id":582681,"name":"Dee Kelly Barrett","photo":""},{"id":582682,"name":"Bobby Buechler","photo":""},{"id":582683,"name":"T'Onna Champagne","photo":""},{"id":582684,"name":"Tiffany Champagne","photo":""},{"id":582685,"name":"Deborah Peagler","photo":""},{"id":517851,"name":"Yoav Potash","photo":""}],"directors":[{"id":517851,"name":"Yoav Potash"}],"genres":["Dokumentarfilm","Krimi"],"id":77881,"original":"Crime After Crime","overview":"","poster":"/sqMCUXIF4WOgyv56GIXtiXXieLf.jpg","runtime":95.0,"title":"Crime After Crime","type":"movie","va":5.7,"vc":7,"year":"2011"},"movie:78358":{"cast":[{"id":66776,"name":"Liza Minnelli","photo":"/1oGwXBirjCwPOfi2Qib9ZLFCTM4.jpg"},{"id":4111,"name":"Ingrid Bergman","photo":"/jXEE0P6705JbMAJ2nwtHjmqkd5F.jpg"},{"id":29519,"name":"Charles Boyer","photo":"/uVV5HiMl0xP1haPwqcJNweGizZ1.jpg"},{"id":6783,"name":"Spiros Focás","photo":"/fE2TyuWyYrB2kGiwOdd35zYAfpm.jpg"},{"id":109142,"name":"Tina Aumont","photo":"/dg8VhEYHh5QD1tDeILKivbng0LO.jpg"},{"id":4961,"name":"Gabriele Ferzetti","photo":"/usiGcuBhMrSK8VnMHFKV6zDFrhj.jpg"},{"id":100427,"name":"Geoffrey Copleston","photo":"/aovs3e7AKfbb3QkvYhW2z5dGYzS.jpg"},{"id":2218829,"name":"Dominot","photo":""}],"directors":[{"id":13980,"name":"Vin